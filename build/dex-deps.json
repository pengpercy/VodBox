  "note": [
    "JVM 侧宿主依赖的固定版本锁定表（DEX→JVM 转换 + SQLite JDBC + Android 运行时库 + ARM64 模拟 + 可选打包 JRE）。",
    "每个 Maven 制品都带 sha256：build/fetch-dex-deps.py 下载后逐件校验，不匹配即失败（sha256 由 fetch 实测自 Maven Central）。",
    "分四组：dex（DEX→JVM 转换引擎）、sqlite（SQLite JDBC 驱动）、runtime（普通插件常用的第三方运行时库）与 unidbg（ARM64 原生模拟）。",
    "许可按各制品真实 pom <licenses>（必要时回溯 parent pom）逐件如实登记——不写“全部 Apache”。dex/sqlite/runtime 三组为 Apache-2.0 / MIT / BSD-3-Clause。",
    "unidbg 组的编译期传递闭包含 GPL-2.0-only 组件（unicorn/keystone/demumble）。本表只陈述该事实；是否随包分发是本仓库自己的策略选择，",
    "默认**不随包捆绑** unidbg 组，需要时由操作方显式配置（stage --groups unidbg --allow-non-distributable）。本表不对“能否与其它分发物共存”下断言。"
  ],
  "mavenRepository": "https://repo1.maven.org/maven2",
  "artifactUrlTemplate": "{repository}/{groupPath}/{artifact}/{version}/{artifact}-{version}.jar",
  "cacheRoot": ".cache/dex-deps",
  "groups": {
    "dex": {
      "distribute": true,
      "stageDirectory": "dex-tools",
      "description": "DEX→JVM 转换（dex2jar 家族）及其运行时闭包。许可为 Apache-2.0 / BSD-3-Clause，随包分发到 <宿主目录>/dex-tools/。"
    },
    "sqlite": {
      "distribute": true,
      "stageDirectory": "sqlite-jdbc",
      "description": "android.database.sqlite.* 的真实后端：xerial SQLite JDBC 驱动（Apache-2.0）。随包分发到 <宿主目录>/sqlite-jdbc/（JdbcSqliteEngine 的随包发现路径），六 RID 的原生库都在该 jar 内。"
    },
    "runtime": {
      "distribute": true,
      "stageDirectory": "runtime",
      "description": "普通 Android 插件常用的纯 Java 运行时库（okhttp/okio/kotlin-stdlib/gson/jsoup，Apache-2.0 / MIT）及其 JVM 运行时闭包。随包分发到 <宿主目录>/runtime/。"
    },
    "unidbg": {
      "distribute": false,
      "stageDirectory": "unidbg",
      "description": "ARM64 原生模拟（unidbg + Dynarmic 后端）。编译期传递闭包含 GPL-2.0-only（unicorn/keystone/demumble）；本仓库默认**不随包捆绑**，需要时由操作方显式配置。"
    }
  },
