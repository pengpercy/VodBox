<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Inherit sources, disabled mirrors, and proxy from the user's NuGet.Config. -->
  <packageSourceMapping>
    <packageSource key="huaweicloud"><package pattern="*" /></packageSource>
    <packageSource key="nuget.org"><package pattern="*" /></packageSource>
  </packageSourceMapping>
</configuration>
