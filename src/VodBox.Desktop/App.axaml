<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VodBox.Desktop.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <FluentTheme />
        <ResourceInclude Source="avares://VodBox.Desktop/Resources/Icons.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <!-- Mica 风格设计令牌（与 HTML 设计稿对齐） -->
      <SolidColorBrush x:Key="AccentBrush" Color="#4CC2FF" />
      <SolidColorBrush x:Key="AccentStrongBrush" Color="#0078D4" />
      <SolidColorBrush x:Key="CardBrush" Color="#2D2D2D" Opacity="0.45" />
      <SolidColorBrush x:Key="CardHoverBrush" Color="#FFFFFF" Opacity="0.085" />
      <SolidColorBrush x:Key="StrokeBrush" Color="#FFFFFF" Opacity="0.09" />
      <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFFFFF" Opacity="0.78" />
      <SolidColorBrush x:Key="TextTertiaryBrush" Color="#FFFFFF" Opacity="0.52" />
      <SolidColorBrush x:Key="DangerBrush" Color="#FF6B6B" />
      <SolidColorBrush x:Key="WarnBrush" Color="#FFB900" />
      <SolidColorBrush x:Key="OkBrush" Color="#6CCB5F" />
      <CornerRadius x:Key="CornerRadiusLarge">12</CornerRadius>
      <CornerRadius x:Key="CornerRadiusMedium">8</CornerRadius>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <!-- IINA 风格加粗滑杆：5px 圆角轨道 + 白色圆 thumb + 黑描边 -->
    <Style Selector="Slider.playerFat">
      <Setter Property="MinHeight" Value="18" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Slider.playerFat /template/ Track">
      <Setter Property="Height" Value="5" />
    </Style>
    <Style Selector="Slider.playerFat /template/ Track RepeatButton">
      <Setter Property="Height" Value="5" />
      <Setter Property="CornerRadius" Value="2.5" />
      <Setter Property="Background" Value="#4CC2FF" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Slider.playerFat /template/ Track Button">
      <Setter Property="Height" Value="5" />
      <Setter Property="CornerRadius" Value="2.5" />
      <Setter Property="Background" Value="#3FFFFFFF" />
    </Style>
    <Style Selector="Slider.playerFat /template/ Track Thumb">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#66000000" />
      <Setter Property="BorderThickness" Value="1.5" />
    </Style>
  </Application.Styles>
</Application>
