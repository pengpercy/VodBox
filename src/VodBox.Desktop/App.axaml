<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VodBox.Desktop.App"
             Name="VodBox"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://VodBox.Desktop/Resources/Icons.xaml" />
        <ResourceInclude Source="avares://VodBox.Desktop/Resources/Theme.axaml" />
        <ResourceInclude Source="avares://VodBox.Desktop/Resources/Shapes.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <!-- Mica 风格设计令牌（与 HTML 设计稿对齐） -->
      <!-- 全局只用一种蓝：与主按钮（立即播放/搜索）同色，只用于少量指示（进度条、滑杆、选中描边、加载条）。
           文字一律用中性的主/次/弱文字色，不再出现浅天蓝（#4CC2FF）的文字与底色。 -->
      <SolidColorBrush x:Key="AccentBrush" Color="#0078D4" />
      <!-- 海报角标（时长/备注）文字：中性灰，压在半透明黑底上必须保持亮色，因此不跟随亮/暗主题翻转。 -->
      <SolidColorBrush x:Key="PosterBadgeTextBrush" Color="#D0D0D0" />
      <SolidColorBrush x:Key="AccentStrongBrush" Color="#0078D4" />
      <SolidColorBrush x:Key="DangerBrush" Color="#FF6B6B" />
      <SolidColorBrush x:Key="WarnBrush" Color="#FFB900" />
      <SolidColorBrush x:Key="OkBrush" Color="#6CCB5F" />
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://VodBox.Desktop/Resources/ShapeStyles.axaml" />
    <StyleInclude Source="avares://VodBox.Desktop/Resources/SettingsCardStyles.axaml" />
    <!-- 悬浮子面板（ContextMenu）统一小一号字号，减少遮挡 -->
    <Style Selector="ContextMenu"><Setter Property="FontSize" Value="12" /></Style>
    <Style Selector="ContextMenu MenuItem"><Setter Property="FontSize" Value="12" /></Style>
    <Style Selector="Window"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /></Style>
    <StyleInclude Source="avares://VodBox.Desktop/Views/VirtualRows.axaml" />
    <StyleInclude Source="avares://VodBox.Desktop/Resources/Skeleton.axaml" />
    <!-- Material Design 3 风格滑杆：4px 圆头轨道 + 14px 圆 thumb，配 MDI 图标 -->
    <Style Selector="Slider.md">
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Slider.md /template/ Track">
      <Setter Property="Height" Value="20" />
    </Style>
    <Style Selector="Slider.md /template/ Track RepeatButton">
      <Setter Property="Height" Value="4" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Slider.md /template/ Track Button">
      <Setter Property="Height" Value="4" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Background" Value="#33FFFFFF" />
    </Style>
    <Style Selector="Slider.md /template/ Track Thumb">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="#FF202020" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Slider.md:pointerover /template/ Track Thumb">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
  </Application.Styles>
</Application>
