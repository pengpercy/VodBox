<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VodBox.Desktop.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://VodBox.Desktop/Resources/Icons.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <!-- Mica 风格设计令牌（与 HTML 设计稿对齐） -->
      <SolidColorBrush x:Key="AccentBrush" Color="#4CC2FF" />
      <SolidColorBrush x:Key="AccentStrongBrush" Color="#0078D4" />
      <SolidColorBrush x:Key="CardBrush" Color="#2D2D2D" Opacity="0.45" />
      <SolidColorBrush x:Key="CardHoverBrush" Color="#FFFFFF" Opacity="0.085" />
      <SolidColorBrush x:Key="StrokeBrush" Color="#FFFFFF" Opacity="0.09" />
      <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFFFFF" Opacity="0.78" />
      <SolidColorBrush x:Key="TextTertiaryBrush" Color="#FFFFFF" Opacity="0.52" />
      <SolidColorBrush x:Key="DangerBrush" Color="#FF6B6B" />
      <SolidColorBrush x:Key="WarnBrush" Color="#FFB900" />
      <SolidColorBrush x:Key="OkBrush" Color="#6CCB5F" />
      <CornerRadius x:Key="CornerRadiusLarge">12</CornerRadius>
      <CornerRadius x:Key="CornerRadiusMedium">8</CornerRadius>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://VodBox.Desktop/Views/VirtualRows.axaml" />
    <!-- Material Design 3 风格滑杆：4px 圆头轨道 + 14px 圆 thumb，配 MDI 图标 -->
    <Style Selector="Slider.md">
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Slider.md /template/ Track">
      <Setter Property="Height" Value="20" />
    </Style>
    <Style Selector="Slider.md /template/ Track RepeatButton">
      <Setter Property="Height" Value="4" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Background" Value="#4CC2FF" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Slider.md /template/ Track Button">
      <Setter Property="Height" Value="4" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Background" Value="#33FFFFFF" />
    </Style>
    <Style Selector="Slider.md /template/ Track Thumb">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Background" Value="#4CC2FF" />
      <Setter Property="BorderBrush" Value="#FF202020" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Slider.md:pointerover /template/ Track Thumb">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
  </Application.Styles>
</Application>
