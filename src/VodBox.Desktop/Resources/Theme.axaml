<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="PageBackgroundBrush" Color="#202020" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="#161616" />
      <SolidColorBrush x:Key="CardBrush" Color="#0FFFFFFF" />
      <SolidColorBrush x:Key="CardHoverBrush" Color="#12FFFFFF" />
      <SolidColorBrush x:Key="StrokeBrush" Color="#FFFFFF" Opacity="0.09" />
      <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C7FFFFFF" />
      <SolidColorBrush x:Key="TextTertiaryBrush" Color="#85FFFFFF" />
      <SolidColorBrush x:Key="MutedTextBrush" Color="#4CFFFFFF" />
      <SolidColorBrush x:Key="SkeletonBrush" Color="#1FFFFFFF" />
      <!-- 输入框描边三档：静止 → 悬停 → 聚焦逐级变亮，全部是中性白，不用系统强调色。
           Fluent 默认静止就有 60% 白、聚焦是强调色加 2px 底边，压在深色半透明界面上很扎眼；
           静止档收到与卡片描边同一量级，聚焦档仍是最亮的一档，键盘焦点照样看得出。下拉框同一套。 -->
      <SolidColorBrush x:Key="TextControlBorderBrush" Color="#33FFFFFF" />
      <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#52FFFFFF" />
      <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#8CFFFFFF" />
      <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#33FFFFFF" />
      <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#52FFFFFF" />
      <!-- 聚焦底色：Fluent 默认 #B31E1E1E 近乎纯黑，与半透明卡片/页面底色反差太大；改成略亮一档的半透明白。 -->
      <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#14FFFFFF" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F3F3F3" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="CardBrush" Color="#09000000" />
      <SolidColorBrush x:Key="CardHoverBrush" Color="#12000000" />
      <SolidColorBrush x:Key="StrokeBrush" Color="#000000" Opacity="0.12" />
      <SolidColorBrush x:Key="TextPrimaryBrush" Color="#202020" />
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C7202020" />
      <SolidColorBrush x:Key="TextTertiaryBrush" Color="#99202020" />
      <SolidColorBrush x:Key="MutedTextBrush" Color="#66202020" />
      <SolidColorBrush x:Key="SkeletonBrush" Color="#14000000" />
      <!-- 输入框描边三档（同深色主题的说明），中性灰。聚焦底色必须在浅色里显式给出：
           否则会回落到 Default 字典里的深色值（#14FFFFFF），聚焦时输入框几乎透明。 -->
      <SolidColorBrush x:Key="TextControlBorderBrush" Color="#29000000" />
      <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#45000000" />
      <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#7A000000" />
      <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#29000000" />
      <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#45000000" />
      <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFFFF" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Default">
      <SolidColorBrush x:Key="PageBackgroundBrush" Color="#202020" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="#161616" />
      <SolidColorBrush x:Key="CardBrush" Color="#0FFFFFFF" />
      <SolidColorBrush x:Key="CardHoverBrush" Color="#12FFFFFF" />
      <SolidColorBrush x:Key="StrokeBrush" Color="#FFFFFF" Opacity="0.09" />
      <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C7FFFFFF" />
      <SolidColorBrush x:Key="TextTertiaryBrush" Color="#85FFFFFF" />
      <SolidColorBrush x:Key="MutedTextBrush" Color="#4CFFFFFF" />
      <SolidColorBrush x:Key="SkeletonBrush" Color="#1FFFFFFF" />
      <!-- 输入框描边三档：静止 → 悬停 → 聚焦逐级变亮，全部是中性白，不用系统强调色。
           Fluent 默认静止就有 60% 白、聚焦是强调色加 2px 底边，压在深色半透明界面上很扎眼；
           静止档收到与卡片描边同一量级，聚焦档仍是最亮的一档，键盘焦点照样看得出。下拉框同一套。 -->
      <SolidColorBrush x:Key="TextControlBorderBrush" Color="#33FFFFFF" />
      <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#52FFFFFF" />
      <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#8CFFFFFF" />
      <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#33FFFFFF" />
      <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#52FFFFFF" />
      <!-- 聚焦底色：Fluent 默认 #B31E1E1E 近乎纯黑，与半透明卡片/页面底色反差太大；改成略亮一档的半透明白。 -->
      <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#14FFFFFF" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
  <!-- 聚焦时四边都保持 1px（Fluent 默认底边 2px），避免输入框聚焦时整体跳动、底边一条粗线。 -->
  <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
</ResourceDictionary>
