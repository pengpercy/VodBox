<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Button"><Setter Property="CornerRadius" Value="{DynamicResource AppControlCornerRadius}" /></Style>
  <Style Selector="TextBox"><Setter Property="CornerRadius" Value="{DynamicResource AppControlCornerRadius}" /></Style>
  <Style Selector="ComboBox"><Setter Property="CornerRadius" Value="{DynamicResource AppControlCornerRadius}" /></Style>
  <Style Selector="ComboBoxItem"><Setter Property="CornerRadius" Value="{DynamicResource AppControlCornerRadius}" /></Style>
</Styles>
