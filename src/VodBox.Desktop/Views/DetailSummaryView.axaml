<UserControl
    xmlns="https://github.com/avaloniaui" xmlns:vm="using:VodBox.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="VodBox.Desktop.Views.DetailSummaryView" x:DataType="vm:MainViewModel" x:CompileBindings="True">
  <Design.DataContext>
    <vm:DesignMainViewModel />
  </Design.DataContext>
  <Border Background="{DynamicResource CardSurfaceBrush}" Padding="20" CornerRadius="10">
    <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="14">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock Text="{Binding DetailTitle}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
        <Button Grid.Column="1" Command="{Binding ToggleFavoriteCommand}" ToolTip.Tip="收藏 / 取消收藏" Width="40" Height="40" Padding="10" Background="Transparent" BorderThickness="0">
          <Path Data="M12,2 L15,9 L23,10 L17,15 L19,23 L12,19 L5,23 L7,15 L1,10 L9,9 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Stretch="Uniform" />
        </Button>
      </Grid>
      <TextBlock Grid.Row="1" Text="{Binding DetailRemarks}" Classes="muted" TextWrapping="Wrap" />
      <Border Grid.Row="2" Background="#18000000" Padding="10,5" CornerRadius="5" HorizontalAlignment="Left">
        <TextBlock Text="{Binding DetailSource}" FontSize="12" />
      </Border>
      <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Disabled">
        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Classes="muted" LineHeight="24" />
      </ScrollViewer>
    </Grid>
  </Border>
</UserControl>
