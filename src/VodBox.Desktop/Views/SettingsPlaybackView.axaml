<UserControl
    xmlns="https://github.com/avaloniaui" xmlns:vm="using:VodBox.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="VodBox.Desktop.Views.SettingsPlaybackView" x:DataType="vm:MainViewModel" x:CompileBindings="True">
  <Design.DataContext>
    <vm:DesignMainViewModel />
  </Design.DataContext>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="16" Margin="24,12,24,20">
      <TextBlock Text="播放内核" FontWeight="SemiBold" FontSize="18" />
      <ComboBox ItemsSource="{Binding PlaybackEngineChoices}" SelectedItem="{Binding SelectedPlaybackEngine}" HorizontalAlignment="Stretch">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:PlaybackEngineChoice">
            <TextBlock Text="{Binding Name}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <TextBlock Text="{Binding ActiveEngineText}" TextWrapping="Wrap" Classes="muted" />
      <TextBlock Text="播放偏好" FontWeight="SemiBold" FontSize="18" />
      <ToggleSwitch Content="自动播放下一集" IsChecked="{Binding AutoNext}" />
      <ToggleSwitch Content="从上次进度继续" IsChecked="{Binding ResumePlayback}" />
      <TextBlock Text="跳过片头（秒）" />
      <NumericUpDown Minimum="0" Maximum="600" Increment="5" Value="{Binding SkipIntroSeconds}" />
      <TextBlock Text="跳过片尾（秒，自动下一集时生效）" />
      <NumericUpDown Minimum="0" Maximum="600" Increment="5" Value="{Binding SkipOutroSeconds}" />
      <TextBlock Text="音频延迟（毫秒，正值推迟音频）" />
      <NumericUpDown Minimum="-10000" Maximum="10000" Increment="50" Value="{Binding AudioDelayMs}" />
      <TextBlock Text="字幕延迟（毫秒，正值推迟字幕）" />
      <NumericUpDown Minimum="-10000" Maximum="10000" Increment="50" Value="{Binding SubtitleDelayMs}" />
      <Button Content="保存视频截图" Click="SnapshotClick" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
