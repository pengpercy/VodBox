<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VodBox.Desktop.ViewModels"
        x:Class="VodBox.Desktop.Views.UpdateWindow" x:DataType="vm:UpdateViewModel"
        Title="VodBox 更新" Icon="/Assets/Icons/linux/256/vodbox.png"
        Width="620" Height="560" MinWidth="520" MinHeight="440"
        Background="{DynamicResource PageBackgroundBrush}"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*,Auto" Margin="24">
    <StackPanel Spacing="10" Margin="0,0,0,16">
      <TextBlock Text="发现 VodBox 新版本" FontSize="22" FontWeight="SemiBold" />
      <StackPanel Orientation="Horizontal" Spacing="24">
        <TextBlock Text="{Binding CurrentVersion, StringFormat='当前版本：{0}'}" />
        <TextBlock Text="{Binding NewVersion, StringFormat='新版本：{0}'}" FontWeight="SemiBold" />
      </StackPanel>
      <TextBlock Text="{Binding PolicyText}" TextWrapping="Wrap" FontSize="12"
                 Foreground="{DynamicResource TextSecondaryBrush}" />
    </StackPanel>
    <Border Grid.Row="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource StrokeBrush}"
            BorderThickness="1" CornerRadius="8">
      <!-- Plain text preserves the complete release body without remote images or an additional renderer. -->
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" Spacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="发行说明" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="在 GitHub 查看" Click="OnReleasePage" Padding="8,3" FontSize="12"
                    Background="Transparent" BorderThickness="0" Foreground="{DynamicResource AccentStrongBrush}" Cursor="Hand" />
          </Grid>
          <SelectableTextBlock Text="{Binding ReleaseNotes}" TextWrapping="Wrap" />
        </StackPanel>
      </ScrollViewer>
    </Border>
    <StackPanel Grid.Row="2" Spacing="12" Margin="0,16,0,0">
      <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
      <ProgressBar Value="{Binding DownloadProgress}" Maximum="100" Height="8"
                   IsVisible="{Binding HasProgress}" IsIndeterminate="{Binding ProgressIndeterminate}" />
      <CheckBox x:Name="AutoInstall" Content="以后自动下载并安装更新" IsChecked="{Binding AutoInstall}"
                IsVisible="{Binding SupportsInPlaceUpdate}" />
      <!-- 关闭窗口 = 稍后提醒；下载中关闭会取消下载（已选择「退出时安装」的继续在后台下载）。 -->
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Button x:Name="SkipVersion" Content="跳过这个版本" Click="OnSkip" IsVisible="{Binding CanSkip}" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <Button x:Name="CancelDownload" Content="取消下载" Click="OnCancelDownload" IsVisible="{Binding IsDownloading}" />
          <Button x:Name="OpenDownloadPage" Content="打开下载页面" Click="OnOpenDownloadPage" IsVisible="{Binding CanOpenDownloadPage}"
                  Background="{DynamicResource AccentStrongBrush}" Foreground="White" />
          <Button x:Name="InstallOnQuit" Content="退出时安装" Click="OnInstallOnQuit" IsVisible="{Binding CanInstallOnQuit}" />
          <Button x:Name="InstallNow" Content="安装并重启应用" Click="OnInstallNow" IsVisible="{Binding CanInstallNow}"
                  Background="{DynamicResource AccentStrongBrush}" Foreground="White" />
        </StackPanel>
      </Grid>
    </StackPanel>
  </Grid>
</Window>
