<UserControl
    xmlns="https://github.com/avaloniaui" xmlns:views="using:VodBox.Desktop.Views" xmlns:vm="using:VodBox.Desktop"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="VodBox.Desktop.Views.SettingsView" x:DataType="vm:MainViewModel"
    x:CompileBindings="True">
  <Design.DataContext>
    <vm:DesignMainViewModel />
  </Design.DataContext>
  <Grid RowDefinitions="Auto,*" RowSpacing="12">
    <Button x:Name="ReturnHomeButton" Content="返回首页" HorizontalAlignment="Left"
            Command="{Binding NavigateCommand}" CommandParameter="首页" />
    <TabControl x:Name="SettingsTabs" Grid.Row="1">
      <TabItem Header="通用">
        <views:SettingsGeneralView />
      </TabItem>
      <TabItem Header="播放">
        <views:SettingsPlaybackView />
      </TabItem>
      <TabItem Header="弹幕">
        <views:SettingsDanmakuView />
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
