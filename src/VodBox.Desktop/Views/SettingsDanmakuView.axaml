<UserControl
    xmlns="https://github.com/avaloniaui" xmlns:vm="using:VodBox.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="VodBox.Desktop.Views.SettingsDanmakuView" x:DataType="vm:MainViewModel" x:CompileBindings="True">
  <Design.DataContext>
    <vm:DesignMainViewModel />
  </Design.DataContext>
  <ScrollViewer>
    <StackPanel Spacing="16" Margin="0,12">
      <TextBlock Text="弹幕" FontWeight="SemiBold" FontSize="18" />
      <ToggleSwitch Content="显示弹幕" IsChecked="{Binding DanmakuEnabled}" />
      <TextBox Text="{Binding DanmakuLocation}" PlaceholderText="XML / JSON 弹幕地址或本地路径" />
      <Button Content="加载弹幕地址" Command="{Binding LoadDanmakuUrlCommand}" />
      <Button Content="打开弹幕文件" Click="OpenDanmakuClick" />
      <TextBlock Text="{Binding DanmakuStatus}" TextWrapping="Wrap" Classes="muted" />
      <TextBlock Text="弹幕字号" />
      <Slider Minimum="16" Maximum="48" Value="{Binding DanmakuFontSize}" />
      <TextBlock Text="弹幕不透明度" />
      <Slider Minimum="0.1" Maximum="1" Value="{Binding DanmakuOpacity}" />
      <TextBlock Text="滚动弹幕覆盖比例" />
      <Slider Minimum="0.25" Maximum="1" Value="{Binding DanmakuCoverage}" />
      <TextBlock Text="弹幕延迟（毫秒，正值推迟）" />
      <NumericUpDown Minimum="-60000" Maximum="60000" Increment="500" Value="{Binding DanmakuDelayMs}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
