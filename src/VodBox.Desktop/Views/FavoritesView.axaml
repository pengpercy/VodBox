<UserControl
    xmlns="https://github.com/avaloniaui" xmlns:vm="using:VodBox.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:VodBox.Core" x:Class="VodBox.Desktop.Views.FavoritesView" x:DataType="vm:MainViewModel"
    x:CompileBindings="True">
  <Design.DataContext>
    <vm:DesignMainViewModel />
  </Design.DataContext>
  <ListBox ItemsSource="{Binding Favorites}" SelectionChanged="FavoriteSelectionChanged">
    <ListBox.ItemTemplate>
      <DataTemplate x:DataType="core:FavoriteEntry">
        <StackPanel Margin="8">
          <TextBlock Text="{Binding Title}" />
          <TextBlock Text="{Binding SourceId}" Classes="muted" />
        </StackPanel>
      </DataTemplate>
    </ListBox.ItemTemplate>
  </ListBox>
</UserControl>
