<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VodBox.Desktop.ViewModels"
             xmlns:views="clr-namespace:VodBox.Desktop.Views"
             xmlns:design="clr-namespace:VodBox.Desktop.Design"
             x:Class="VodBox.Desktop.Views.DetailView" x:DataType="vm:MainViewModel">
  <Design.DataContext>
    <x:Static Member="design:DesignData.MainForDesign" />
  </Design.DataContext>

  <ScrollViewer Padding="28,12,28,28">
    <Panel>
    <!-- 详情骨架：加载中占位（海报 + 元信息 + 线路 + 选集），避免整页白屏 -->
    <StackPanel Spacing="22" IsVisible="{Binding Detail.ShowSkeleton}">
      <Grid ColumnDefinitions="200,36,*,28,280">
        <Border Grid.Column="0" Classes="skeleton poster" Height="300" />
        <StackPanel Grid.Column="2" Spacing="12">
          <Border Classes="skeleton" Height="26" Width="280" HorizontalAlignment="Left" />
          <Border Classes="skeleton" Height="13" Width="140" HorizontalAlignment="Left" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Border Classes="skeleton" Height="26" Width="64" />
            <Border Classes="skeleton" Height="26" Width="64" />
            <Border Classes="skeleton" Height="26" Width="80" />
          </StackPanel>
          <Border Classes="skeleton" Height="12" Width="360" HorizontalAlignment="Left" />
          <Border Classes="skeleton" Height="12" Width="420" HorizontalAlignment="Left" />
          <Border Classes="skeleton" Height="12" Width="300" HorizontalAlignment="Left" />
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
            <Border Classes="skeleton" Height="38" Width="126" />
            <Border Classes="skeleton" Height="38" Width="96" />
            <Border Classes="skeleton" Height="38" Width="112" />
          </StackPanel>
        </StackPanel>
        <Border Grid.Column="4" Classes="skeleton poster" Height="158" />
      </Grid>
      <StackPanel Spacing="10">
        <Border Classes="skeleton" Height="18" Width="80" HorizontalAlignment="Left" />
        <ItemsControl ItemsSource="{x:Static views:SkeletonData.Bars}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate><Border Classes="skeleton" Height="32" Width="88" /></DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
      <StackPanel Spacing="10">
        <Border Classes="skeleton" Height="18" Width="60" HorizontalAlignment="Left" />
        <ItemsControl ItemsSource="{x:Static views:SkeletonData.Episodes}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate><Border Classes="skeleton" Height="37" Width="132" Margin="0,0,8,10" /></DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </StackPanel>

    <!-- 详情内容：拿到数据后显示（加载中为 null，由上面的骨架接管） -->
    <StackPanel Spacing="22" DataContext="{Binding Detail}"
                IsVisible="{Binding $parent[views:DetailView].((vm:MainViewModel)DataContext).Detail.ShowContent}">

      <Grid ColumnDefinitions="200,36,*,28,280">
        <!-- 海报 -->
        <Border Grid.Column="0" CornerRadius="{DynamicResource AppPosterCornerRadius}" Height="300" Background="#274064" ClipToBounds="True">
          <Panel>
            <PathIcon Data="{StaticResource Icon.Movie}" Width="48" Height="48" Opacity="0.25" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <views:RemotePoster Url="{Binding Detail.Item.Poster}" />
          </Panel>
        </Border>

        <!-- 元信息 -->
        <StackPanel Grid.Column="2" Spacing="12" VerticalAlignment="Top">
          <TextBlock Text="{Binding Detail.Item.Title}" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Detail.Item.Remarks}" FontSize="13" Foreground="#4CC2FF" />
          <!-- 元信息行：站源 + 年份 + 地区 + 类型 + 时长（对齐设计稿 p-detail） -->
          <WrapPanel Orientation="Horizontal">
            <TextBlock FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}">
              <Run Text="站源：" /><Run Text="{Binding SourceName}" Foreground="{DynamicResource TextSecondaryBrush}" />
            </TextBlock>
            <Border Background="{DynamicResource CardHoverBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="5" Padding="10,4" Margin="0,0,8,8">
              <TextBlock Text="{Binding Detail.Item.Year}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
            </Border>
            <Border Background="{DynamicResource CardHoverBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="5" Padding="10,4" Margin="0,0,8,8">
              <TextBlock Text="{Binding Detail.Item.Area}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
            </Border>
            <Border Background="{DynamicResource CardHoverBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="5" Padding="10,4" Margin="0,0,8,8">
              <TextBlock Text="{Binding Detail.Item.TypeName}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
            </Border>
          </WrapPanel>
          <TextBlock FontSize="12.5" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap">
            <Run Text="导演：" /><Run Text="{Binding Detail.Director}" Foreground="{DynamicResource TextSecondaryBrush}" />
          </TextBlock>
          <TextBlock FontSize="12.5" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap">
            <Run Text="主演：" /><Run Text="{Binding Detail.Actor}" Foreground="{DynamicResource TextSecondaryBrush}" />
          </TextBlock>
          <TextBlock Text="{Binding Detail.Description}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.9"
                     TextWrapping="Wrap" MaxLines="4" TextTrimming="CharacterEllipsis" />
          <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
            <!-- 主按钮智能显示续播集数（读取历史进度，S2 接运行时逻辑；设计稿为「续播 第12集」） -->
            <Button Command="{Binding PlayCommand}" Background="#0078D4"
                    Foreground="White" BorderThickness="0" CornerRadius="{DynamicResource AppControlCornerRadius}" Padding="12,9" Margin="0,0,8,8" Cursor="Hand">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource Icon.Play}" Width="18" Height="18" />
                <TextBlock Text="{Binding PlayLabel}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Command="{Binding ToggleFavoriteCommand}" Background="{DynamicResource CardHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                    BorderThickness="1" BorderBrush="{DynamicResource StrokeBrush}" CornerRadius="{DynamicResource AppControlCornerRadius}" Padding="12,9" Margin="0,0,8,8" Cursor="Hand">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource Icon.Star}" Width="18" Height="18" />
                <TextBlock Text="{Binding FavoriteLabel}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Command="{Binding SearchOtherSourcesCommand}" Background="{DynamicResource CardHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="1" BorderBrush="{DynamicResource StrokeBrush}"
                    CornerRadius="{DynamicResource AppControlCornerRadius}" Padding="12,9" Margin="0,0,8,8" Cursor="Hand">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource Icon.Search}" Width="18" Height="18" />
                <TextBlock Text="跨站搜索" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Command="{Binding OpenRemoteControlCommand}" Background="{DynamicResource CardHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="1" BorderBrush="{DynamicResource StrokeBrush}"
                    CornerRadius="{DynamicResource AppControlCornerRadius}" Padding="12,9" Margin="0,0,8,8" Cursor="Hand">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource Icon.Cellphone}" Width="18" Height="18" />
                <TextBlock Text="遥控设置" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </WrapPanel>
        </StackPanel>

        <!-- 播放器窗 -->
        <!-- TODO(S5 影院模式)：若需要内嵌小窗播放，此处可挂第二个 MpvVideoSurface（需独立 MpvClient，mpv 单实例只能一个 render context 时共享渲染面）。
             当前产品决策：播放统一走全局浮层，此窗只作提示。 -->
        <StackPanel Grid.Column="4" Spacing="10">
          <!-- 内嵌试看播放器（影院模式占位：S5 接第二个 MpvVideoSurface；当前产品决策为全局浮层） -->
          <Border CornerRadius="{DynamicResource AppPosterCornerRadius}" Height="158" ClipToBounds="True" Cursor="Hand">
            <Border.Background>
              <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#1E3A5F" Offset="0" />
                <GradientStop Color="#2D1B4E" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
            <Panel>
              <!-- 中央播放按钮 -->
              <Border CornerRadius="28" Width="56" Height="56" Background="#66000000" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel TextElement.Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <PathIcon Data="{StaticResource Icon.Play}" Width="24" Height="24" />
                </StackPanel>
              </Border>
              <!-- 右上清晰度标 -->
              <Border CornerRadius="4" Background="#66000000" Padding="7,3" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
                <TextBlock Text="1080P" FontSize="10" Foreground="#4CC2FF" FontWeight="SemiBold" />
              </Border>
              <!-- 左下试看提示 -->
              <Border Background="#66000000" Padding="10,5" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,10" CornerRadius="0,8,8,0">
                <TextBlock Text="试看模式 · 点击全屏播放" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
              </Border>
            </Panel>
          </Border>
          <TextBlock Text="鼠标双击画面 / 按 Enter 进入全屏播放窗口" FontSize="10.5" Foreground="{DynamicResource TextTertiaryBrush}"
                     HorizontalAlignment="Center" />
        </StackPanel>
      </Grid>

      <!-- 线路（vod_play_from 拆分；播放失败时可切换其他线路） -->
      <StackPanel Spacing="10">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="线路" FontSize="14" FontWeight="SemiBold" />
          <TextBlock Text="播放失败时可切换其他线路" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Lines}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="8" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Content="{Binding Name}" Click="OnPickLine" Tag="{Binding}"
                      CornerRadius="{DynamicResource AppControlCornerRadius}" Padding="14,6" FontSize="12.5" Cursor="Hand"
                      Background="{DynamicResource CardHoverBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="1" BorderBrush="{DynamicResource StrokeBrush}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- 剧集：分块行虚拟化，单集按钮操作 -->
      <StackPanel Spacing="10">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="剧集" FontSize="14" FontWeight="SemiBold" />
          <TextBlock Text="{Binding EpisodeCountLabel}" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
          <Panel />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Command="{Binding ToggleEpisodeOrderCommand}" CornerRadius="{DynamicResource AppControlCornerRadius}" Background="{DynamicResource CardHoverBrush}" Padding="10,4" Cursor="Hand">
              <StackPanel Orientation="Horizontal" Spacing="6" TextElement.Foreground="{DynamicResource TextSecondaryBrush}">
                <PathIcon Data="{StaticResource Icon.SwapVertical}" Width="18" Height="18" VerticalAlignment="Center" />
                <TextBlock Text="倒序" FontSize="11.5" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

          </StackPanel>
        </StackPanel>
        <!-- 剧集网格：分块行虚拟化（长剧 500+ 集只渲染可见行）；独立滚动区 260 高 -->
        <ListBox Classes="virtualRows" ItemsSource="{Binding EpisodeRows}" Background="Transparent" BorderThickness="0"
                 MaxHeight="260" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,0,8,10" Width="132">
                      <Button Click="OnPickEpisode" Tag="{Binding Episode}" ToolTip.Tip="{Binding Title}"
                              CornerRadius="{DynamicResource AppControlCornerRadius}" Padding="10,9" FontSize="12.5" Cursor="Hand"
                              Background="{DynamicResource CardHoverBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="1" BorderBrush="{DynamicResource StrokeBrush}">
                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>

    </StackPanel>

    <!-- 失败/不可用文案：非空时覆盖内容位置，不留白屏 -->
    <TextBlock Text="{Binding Detail.Hint}" FontSize="12.5" TextWrapping="Wrap" MaxWidth="420"
               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="0,40,0,0"
               Foreground="{DynamicResource TextTertiaryBrush}"
               IsVisible="{Binding Detail.Hint, Converter={x:Static views:StringConverters.IsNotNullOrEmpty}}" />
    <!-- 空态：加载结束仍没有可展示的详情 -->
    <TextBlock Text="没有可展示的详情内容" FontSize="12.5"
               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0"
               Foreground="{DynamicResource TextTertiaryBrush}" IsVisible="{Binding Detail.ShowEmpty}" />
    </Panel>
  </ScrollViewer>
</UserControl>
