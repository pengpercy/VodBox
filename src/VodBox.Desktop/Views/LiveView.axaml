<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VodBox.Desktop.ViewModels"
             xmlns:design="clr-namespace:VodBox.Desktop.Design"
             xmlns:views="clr-namespace:VodBox.Desktop.Views"
             xmlns:core="clr-namespace:VodBox.Core;assembly=VodBox.Core"
             x:Class="VodBox.Desktop.Views.LiveView" x:DataType="vm:MainViewModel">
  <Design.DataContext>
    <x:Static Member="design:DesignData.MainForDesign" />
  </Design.DataContext>
  <Grid ColumnDefinitions="320,*" DataContext="{Binding Live}">

    <!-- 频道面板：分组/收藏/历史 三 Tab + 筛选（对齐设计稿 p-live ①） -->
    <Border Grid.Column="0" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,Auto,*">
        <!-- 三 Tab：选中=底部蓝线 + 白字 -->
        <Grid Grid.Row="0" ColumnDefinitions="*,*,*" Margin="16,14,16,6">
          <Button Grid.Column="0" Click="OnTabGroups" Background="Transparent" BorderThickness="0,0,0,2"
                  x:Name="TabGroups" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="#4CC2FF" CornerRadius="0" Padding="0,8" Cursor="Hand">
            <TextBlock Text="分组" FontSize="13" />
          </Button>
          <Button Grid.Column="1" Click="OnTabFavorites" Background="Transparent" BorderThickness="0,0,0,2"
                  x:Name="TabFavorites" Foreground="{DynamicResource TextTertiaryBrush}" BorderBrush="Transparent" CornerRadius="0" Padding="0,8" Cursor="Hand">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource Icon.Star}" Width="18" Height="18" />
              <TextBlock Text="收藏" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Grid.Column="2" Click="OnTabHistory" Background="Transparent" BorderThickness="0,0,0,2"
                  x:Name="TabHistory" Foreground="{DynamicResource TextTertiaryBrush}" BorderBrush="Transparent" CornerRadius="0" Padding="0,8" Cursor="Hand">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource Icon.History}" Width="18" Height="18" />
              <TextBlock Text="历史" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </Grid>
        <Grid Grid.Row="1" Margin="12,4,12,10">
          <TextBox Text="{Binding FilterText}" PlaceholderText="筛选频道…" Height="32"
                   Padding="32,0,10,0" VerticalContentAlignment="Center" CornerRadius="7" />
          <PathIcon Data="{StaticResource Icon.Search}" Width="18" Height="18" Margin="10,0,0,0"
                    HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
        </Grid>
        <!-- 频道列表：组头（可折叠 + 计数）+ 频道行（台标+EPG 单行） -->
        <ListBox Grid.Row="2" ItemsSource="{Binding VisibleChannels}" Margin="6,0,6,12"
                 Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.DataTemplates>
            <!-- 组头行：展开箭头 + 锁定状态 + 名称 + 计数。 -->
            <DataTemplate x:DataType="vm:LiveViewModel+LiveGroupHeader">
              <StackPanel PointerPressed="OnGroupHeader" Tag="{Binding}" Cursor="Hand" Orientation="Horizontal" Spacing="6" Margin="6,12,6,4" TextElement.Foreground="{DynamicResource TextSecondaryBrush}">
                <PathIcon Data="{StaticResource Icon.ChevronRight}" Width="12" Height="12"
                          IsVisible="{Binding Locked}" VerticalAlignment="Center" />
                <PathIcon Data="{StaticResource Icon.ChevronDown}" Width="12" Height="12"
                          IsVisible="{Binding Locked, Converter={x:Static BoolConverters.Not}}" VerticalAlignment="Center" />
                <PathIcon Data="{StaticResource Icon.Lock}" Width="12" Height="12"
                          IsVisible="{Binding Locked}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="180" />
                <TextBlock Text="{Binding Count}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
            <!-- 频道行 -->
            <DataTemplate x:DataType="core:LiveChannel">
              <!-- 频道行容器：选中态整行蓝灰底 -->
              <Border x:Name="Row" CornerRadius="7" Padding="2,4" Background="{Binding IsCurrent, Converter={x:Static views:BoolConverters.ToSelectedRow}}">
                <StackPanel Orientation="Horizontal" Spacing="10" Cursor="Hand"
                            PointerPressed="OnPlayChannel" Tag="{Binding}">
                  <TextBlock Text="{Binding Number, StringFormat='D3'}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"
                             Width="30" VerticalAlignment="Center" />
                  <!--
                    台标与频道名占同一网格行，两者垂直居中对齐（此前“名称+EPG”整块居中会让名称高出
                    台标中心 6~8px）。台标本身不画背景色：品牌图多为透明 PNG，原来的彩色占位方块会
                    透出来变成“背景色”；占位只在没有台标或加载失败时显示。
                  -->
                  <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto"
                        Width="{x:Static views:LiveLayout.RowWidth}" VerticalAlignment="Center">
                    <Panel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"
                           Width="{x:Static views:LiveLayout.BadgeWidth}" Height="{x:Static views:LiveLayout.BadgeHeight}">
                      <Border x:Name="BadgePlaceholder" CornerRadius="7"
                              Background="{Binding BadgeColor, Converter={x:Static views:BrushConverters.FromHex}}"
                              IsVisible="{Binding #ChannelLogo.HasImage, Converter={x:Static views:BoolConverters.Not}}">
                        <TextBlock Text="{Binding Badge}" FontSize="11" Foreground="White" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" FontWeight="SemiBold" />
                      </Border>
                      <views:RemotePoster x:Name="ChannelLogo" Url="{Binding Logo}" Stretch="Uniform" />
                    </Panel>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Name}" FontSize="13"
                               Margin="{x:Static views:LiveLayout.NameMargin}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <!-- 无 EPG 时折叠整行，避免每行白占一个行高。 -->
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding EpgNow}" FontSize="10.5"
                               Foreground="{DynamicResource TextTertiaryBrush}" Margin="{x:Static views:LiveLayout.EpgMargin}"
                               IsVisible="{Binding EpgNow, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               TextTrimming="CharacterEllipsis" />
                  </Grid>
                  <Border Background="Transparent" CornerRadius="5" BorderBrush="#4CC2FF" BorderThickness="1"
                          Padding="6,1" VerticalAlignment="Center" IsVisible="{Binding IsCurrent}">
                    <TextBlock Text="LIVE" FontSize="9.5" Foreground="#4CC2FF" FontWeight="SemiBold" />
                  </Border>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ListBox.DataTemplates>
        </ListBox>
      </Grid>
    </Border>

    <!-- 播放区：中央台号大数字（数字选台 OSD，对齐设计稿 ③）+ 频道信息卡 + EPG 时间轴 -->
    <Grid Grid.Column="1" RowDefinitions="*,Auto,Auto">
      <Border Grid.Row="0" Background="#000000" ClipToBounds="True">
        <Grid>
          <!-- 台号 OSD 大数字 -->
          <TextBlock Text="{Binding CurrentChannel.Number, StringFormat='D3'}" FontSize="88" FontWeight="Bold"
                     Foreground="#26FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"
                     IsVisible="{Binding CurrentChannel, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <!-- 频道信息卡（EPG 时间轴左下叠放，对齐设计稿） -->
          <Border Background="#66000000" CornerRadius="10" Padding="14,10" Margin="18" HorizontalAlignment="Left"
                  VerticalAlignment="Bottom" BorderBrush="#17FFFFFF" BorderThickness="1"
                  IsVisible="{Binding CurrentChannel, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Border CornerRadius="8" Width="40" Height="40" Background="{Binding CurrentChannel.BadgeColor, Converter={x:Static views:BrushConverters.FromHex}}">
                <TextBlock Text="{Binding CurrentChannel.Badge}" FontSize="12" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
              </Border>
              <StackPanel VerticalAlignment="Center" Spacing="3">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="{Binding CurrentChannel.Name}" FontSize="15.5" FontWeight="SemiBold" />
                  <TextBlock VerticalAlignment="Center" FontSize="11.5" Foreground="#85FFFFFF">
                    <Run Text="{Binding CurrentChannel.Number, StringFormat='D3', Mode=OneWay}" /><Run Text=" · 线路 1/" /><Run Text="{Binding CurrentChannel.Uris.Count, Mode=OneWay}" />
                  </TextBlock>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="5" MaxWidth="340" TextElement.Foreground="#4CC2FF">
                  <PathIcon Data="{DynamicResource Icon.Play}" Width="12" Height="12" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding CurrentChannel.EpgNow, Mode=OneWay}" FontSize="12"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock FontSize="11" Foreground="#85FFFFFF" TextTrimming="CharacterEllipsis" MaxWidth="340">
                  <Run Text="接下来：" /><Run Text="{Binding CurrentChannel.EpgNext, Mode=OneWay}" />
                </TextBlock>
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <!-- EPG 横向时间轴（对齐设计稿 ④：当前节目高亮描边，过去节目可回看） -->
      <Border Grid.Row="1" Background="#0DFFFFFF" BorderBrush="#17FFFFFF" BorderThickness="0,1,0,0" Padding="14,10">
        <StackPanel Spacing="6">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="节目单" FontSize="12" Foreground="#C7FFFFFF" VerticalAlignment="Center" />
            <TextBlock Text="EPG 时间轴 · 点击回看" FontSize="10.5" Foreground="#85FFFFFF" VerticalAlignment="Center" />
          </StackPanel>
          <ItemsControl ItemsSource="{Binding EpgTimeline}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="10" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Width="150" CornerRadius="8" Background="#0FFFFFFF" Padding="10,8" Cursor="Hand"
                        BorderThickness="1" Tag="{Binding}" PointerPressed="OnEpgSeek">
                  <Border.BorderBrush>
                    <Binding Path="IsNow" Converter="{x:Static ObjectConverters.IsNotNull}">
                      <Binding.ConverterParameter>#4CC2FF</Binding.ConverterParameter>
                    </Binding>
                  </Border.BorderBrush>
                  <StackPanel Spacing="3">
                    <TextBlock Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="130" />
                    <TextBlock Text="{Binding Range}" FontSize="10.5" Foreground="#85FFFFFF" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- 控制行（对齐设计稿 ⑤） -->
      <Border Grid.Row="2" Background="#66000000" Padding="18,10">
        <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
          <Button Grid.Column="0" Click="OnToggleLive" Background="#12FFFFFF" BorderThickness="0" Foreground="White"
                  CornerRadius="7" Width="34" Height="30" Padding="0" Cursor="Hand" ToolTip.Tip="播放/暂停">
            <PathIcon Data="{DynamicResource Icon.Pause}" Width="18" Height="18" />
          </Button>
          <Button Grid.Column="1" Click="OnPrevChannel" Background="#12FFFFFF" BorderThickness="0" Foreground="#C7FFFFFF"
                  CornerRadius="7" Padding="9,6" Margin="8,0,0,0" Cursor="Hand" ToolTip.Tip="上一台">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{DynamicResource Icon.SkipPrevious}" Width="18" Height="18" VerticalAlignment="Center" />
              <TextBlock Text="频道" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Grid.Column="2" Click="OnNextChannel" Background="#12FFFFFF" BorderThickness="0" Foreground="#C7FFFFFF"
                  CornerRadius="7" Padding="9,6" Margin="8,0,0,0" Cursor="Hand" ToolTip.Tip="下一台">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{DynamicResource Icon.SkipNext}" Width="18" Height="18" VerticalAlignment="Center" />
              <TextBlock Text="频道" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Click="OnSwitchLine" Background="#12FFFFFF" Foreground="#C7FFFFFF"
                    BorderThickness="0" CornerRadius="7" Padding="10,6" FontSize="12" Cursor="Hand">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="{Binding CurrentLineLabel}" VerticalAlignment="Center" />
                <PathIcon Data="{StaticResource Icon.ChevronDown}" Width="18" Height="18" />
              </StackPanel>
            </Button>
            <Button Content="重新锁定" Command="{Binding LockGroupsCommand}" Background="#12FFFFFF" Foreground="#C7FFFFFF" BorderThickness="0" CornerRadius="7" Padding="10,6" FontSize="12" />
            <Button Content="收藏/取消" Command="{Binding ToggleChannelFavoriteCommand}" Background="#12FFFFFF" Foreground="#C7FFFFFF"
                    BorderThickness="0" CornerRadius="7" Padding="10,6" FontSize="12" Cursor="Hand" />
            <Button Content="导入节目表" Click="OnImportEpg" Background="#12FFFFFF" Foreground="#C7FFFFFF"
                    BorderThickness="0" CornerRadius="7" Padding="10,6" FontSize="12" Cursor="Hand" />
            <Button Content="回看" Click="OnCatchup" Background="#12FFFFFF" Foreground="#C7FFFFFF"
                    BorderThickness="0" CornerRadius="7" Padding="10,6" FontSize="12" Cursor="Hand" />
            <TextBlock Text="{Binding LiveSourceLabel}" FontSize="11.5" Foreground="#85FFFFFF" VerticalAlignment="Center"
                       Margin="6,0,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="4" TextElement.Foreground="#C7FFFFFF" VerticalAlignment="Center">
            <PathIcon Data="{DynamicResource Icon.VolumeHigh}" Width="18" Height="18" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.ColumnSpan="2" IsVisible="{Binding GroupUnlockOpen}" Background="{DynamicResource SurfaceBrush}" Padding="24" CornerRadius="12" Width="360" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Spacing="12"><TextBlock Text="{Binding LockedGroupName}" /><TextBox Text="{Binding GroupPassword}" PasswordChar="●" PlaceholderText="分组密码" />
      <Button Content="解锁" Command="{Binding UnlockGroupCommand}" /><Button Content="取消" Command="{Binding CancelGroupUnlockCommand}" /></StackPanel>
    </Border>
  </Grid>
</UserControl>
