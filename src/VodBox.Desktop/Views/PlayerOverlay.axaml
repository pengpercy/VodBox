<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VodBox.Desktop.ViewModels"
             xmlns:design="clr-namespace:VodBox.Desktop.Design"
             xmlns:v="clr-namespace:VodBox.Desktop.Views"
             x:Class="VodBox.Desktop.Views.PlayerOverlay" x:DataType="vm:MainViewModel">
  <Design.DataContext>
    <x:Static Member="design:DesignData.MainForDesign" />
  </Design.DataContext>
  <Panel DataContext="{Binding Player}">
    <!-- 黑底 + libmpv 渲染面 -->
    <Rectangle Fill="#000000" />
    <Panel x:Name="VideoHost" />

    <!-- 控制层：参考主流播放器（Earth 图）一比一布局 -->
    <Grid RowDefinitions="Auto,*,Auto" IsVisible="{Binding Visible}">

      <!-- 顶栏：返回箭头 + 标题 + 副标题 · 右侧分辨率角标 -->
      <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="16,12,16,0">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
          <Button Click="OnClose" Background="#66000000" BorderThickness="0"
                  CornerRadius="8" Width="32" Height="32" Padding="0" Cursor="Hand" ToolTip.Tip="返回">
            <Path Data="{DynamicResource Icon.Back}" Fill="White" Width="16" Height="16"
                  Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Button>
          <StackPanel VerticalAlignment="Center" Spacing="1">
            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="#80FFFFFF" />
          </StackPanel>
        </StackPanel>
        <Border Grid.Column="2" Background="#66000000" CornerRadius="5" Padding="8,3"
                VerticalAlignment="Center">
          <TextBlock Text="1920x1080 · HEVC" FontSize="10.5" Foreground="#80FFFFFF" />
        </Border>
      </Grid>

      <!-- 中央 toast（倍速/跳片头提示） -->
      <Border Grid.Row="1" Background="#CC000000" CornerRadius="9" Padding="14,8"
              VerticalAlignment="Center" HorizontalAlignment="Center"
              IsVisible="{Binding ShowToast}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Path Data="{DynamicResource Icon.Play}" Fill="White" Width="11" Height="11"
                Stretch="Uniform" VerticalAlignment="Center" />
          <TextBlock Text="{Binding ToastText}" FontSize="12" Foreground="White" VerticalAlignment="Center" />
        </StackPanel>
      </Border>

      <!-- 底部：单个半透明圆角面板（参考图紧凑控制条） -->
      <Border Grid.Row="2" Background="#A6000000" CornerRadius="14"
              BorderBrush="#1AFFFFFF" BorderThickness="1"
              Margin="52,0,52,16" Padding="20,12,20,14" HorizontalAlignment="Stretch">
        <StackPanel Spacing="8">

          <!-- 上行：左音量贴边 + 右图标组贴边（底层）；播放三键整面板绝对居中（上层） -->
          <Panel>
            <Grid ColumnDefinitions="*,*">
              <!-- 左：喇叭+音量滑杆 -->
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                          HorizontalAlignment="Left">
                <Button Background="Transparent" BorderThickness="0" CornerRadius="6"
                        Width="28" Height="28" Padding="0" Cursor="Hand" ToolTip.Tip="音量">
                  <Path Data="{DynamicResource Icon.VolumeHigh}" Fill="#C7FFFFFF" Width="16" Height="16"
                        Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
                <Slider Classes="playerFat" Minimum="0" Maximum="100" Value="{Binding Volume}" Width="80" VerticalAlignment="Center" />
              </StackPanel>

              <!-- 右：比例/PiP/拼图/列表/倍速/全屏/设置（参考图顺序） -->
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                          HorizontalAlignment="Right">
                <Button Click="OnToggleAspectRatio" Background="Transparent" BorderThickness="0" CornerRadius="6"
                        Width="30" Height="30" Padding="0" Cursor="Hand" ToolTip.Tip="画面比例">
                  <Path Data="{DynamicResource Icon.AspectRatio}" Fill="#D0FFFFFF" Width="18" Height="18"
                        Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
                <Button Click="OnTogglePip" Background="Transparent" BorderThickness="0" CornerRadius="6"
                        Width="30" Height="30" Padding="0" Cursor="Hand" ToolTip.Tip="画中画">
                  <Path Data="{DynamicResource Icon.PiP}" Fill="#D0FFFFFF" Width="18" Height="18"
                        Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
                <Button Click="OnTogglePlugin" Background="Transparent" BorderThickness="0" CornerRadius="6"
                        Width="30" Height="30" Padding="0" Cursor="Hand" ToolTip.Tip="插件">
                  <Path Data="{DynamicResource Icon.Puzzle}" Fill="#D0FFFFFF" Width="18" Height="18"
                        Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
                <Button Click="OnTogglePlaylist" Background="Transparent" BorderThickness="0" CornerRadius="6"
                        Width="30" Height="30" Padding="0" Cursor="Hand" ToolTip.Tip="播放列表">
                  <Path Data="{DynamicResource Icon.HLines}" Fill="#D0FFFFFF" Width="18" Height="18"
                        Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
                <Button Click="OnCycleRate" Background="Transparent" BorderThickness="0" CornerRadius="6"
                        Padding="5,0" Height="30" Cursor="Hand" ToolTip.Tip="倍速">
                  <StackPanel Orientation="Horizontal" Spacing="3">
                    <Path Data="{DynamicResource Icon.Speed}" Fill="#D0FFFFFF" Width="16" Height="16"
                          Stretch="Uniform" VerticalAlignment="Center" />
                    <TextBlock x:Name="RateBadge" Text="1.5x" FontSize="10.5" Foreground="#4CC2FF"
                               VerticalAlignment="Center" FontWeight="SemiBold" />
                  </StackPanel>
                </Button>
                <Button Click="OnToggleFullscreen" Background="Transparent" BorderThickness="0" CornerRadius="6"
                        Width="30" Height="30" Padding="0" Cursor="Hand" ToolTip.Tip="全屏">
                  <Path Data="{DynamicResource Icon.Fullscreen}" Fill="#D0FFFFFF" Width="18" Height="18"
                        Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
                <Button Click="OnToggleSettings" Background="Transparent" BorderThickness="0" CornerRadius="6"
                        Width="30" Height="30" Padding="0" Cursor="Hand" ToolTip.Tip="设置">
                  <Path Data="{DynamicResource Icon.Settings}" Fill="#D0FFFFFF" Width="18" Height="18"
                        Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
              </StackPanel>
            </Grid>

            <!-- 上层：跳过/播放/快进三键（等大 34px，图标统一 19px，IINA 同款协调比例） -->
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Button Click="OnBack10" Background="Transparent" BorderThickness="0" CornerRadius="6"
                      Width="34" Height="34" Padding="0" Cursor="Hand" ToolTip.Tip="后退 10 秒">
                <Path Data="{DynamicResource Icon.SkipPrevious}" Fill="#D9FFFFFF" Width="19" Height="19"
                      Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Button>
              <Button Click="OnTogglePlay" Background="Transparent" BorderThickness="0" CornerRadius="7"
                      Width="34" Height="34" Padding="0" Cursor="Hand" ToolTip.Tip="播放/暂停">
                <Path Data="{DynamicResource Icon.Pause}" Fill="White" Width="19" Height="19"
                      Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Button>
              <Button Click="OnForward10" Background="Transparent" BorderThickness="0" CornerRadius="6"
                      Width="34" Height="34" Padding="0" Cursor="Hand" ToolTip.Tip="前进 10 秒">
                <Path Data="{DynamicResource Icon.SkipNext}" Fill="#D9FFFFFF" Width="19" Height="19"
                      Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Button>
            </StackPanel>
          </Panel>

          <!-- 下行：时间 + 进度条 + 总时长 -->
          <Grid ColumnDefinitions="Auto,*,Auto">
            <TextBlock Grid.Column="0" Text="{Binding Position, Converter={x:Static v:TimeConverters.ToTime}, Mode=OneWay}"
                       FontSize="11.5" Foreground="#A0FFFFFF" VerticalAlignment="Center" Margin="2,0,8,0" />
            <Slider Grid.Column="1" Classes="playerFat" Minimum="0" Maximum="{Binding Duration.TotalSeconds, Mode=OneWay}"
                    Value="{Binding Position.TotalSeconds, Mode=TwoWay}" />
            <TextBlock Grid.Column="2" Text="{Binding Duration, Converter={x:Static v:TimeConverters.ToTime}, Mode=OneWay}"
                       FontSize="11.5" Foreground="#A0FFFFFF" VerticalAlignment="Center" Margin="8,0,2,0" />
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
  </Panel>
</UserControl>
