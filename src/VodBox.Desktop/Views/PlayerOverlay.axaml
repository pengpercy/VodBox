<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VodBox.Desktop.ViewModels"
             xmlns:design="clr-namespace:VodBox.Desktop.Design"
             xmlns:v="clr-namespace:VodBox.Desktop.Views"
             x:Class="VodBox.Desktop.Views.PlayerOverlay" x:DataType="vm:MainViewModel">
  <Design.DataContext>
    <x:Static Member="design:DesignData.MainForDesign" />
  </Design.DataContext>
  <UserControl.Resources>
    <ControlTheme x:Key="PlayerTrackButton" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Height" Value="3" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate><Border Background="{TemplateBinding Background}" CornerRadius="2" /></ControlTemplate>
      </Setter>
    </ControlTheme>
    <ControlTheme x:Key="PlayerThumb" TargetType="Thumb">
      <Setter Property="Width" Value="10" /><Setter Property="Height" Value="10" />
      <Setter Property="Background" Value="#FFE6E8EB" />
      <Setter Property="Template">
        <ControlTemplate><Border Background="{TemplateBinding Background}" CornerRadius="5" /></ControlTemplate>
      </Setter>
    </ControlTheme>
    <ControlTheme x:Key="PlayerSlider" TargetType="Slider">
      <Setter Property="MinHeight" Value="18" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="Transparent" Height="18">
            <Track Name="PART_Track" Orientation="Horizontal"
                   Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value, Mode=TwoWay}" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
              <Track.DecreaseButton><RepeatButton Name="PART_DecreaseButton" Theme="{StaticResource PlayerTrackButton}" Background="#FFC6C9CE" /></Track.DecreaseButton>
              <Track.Thumb><Thumb Name="PART_Thumb" Theme="{StaticResource PlayerThumb}" /></Track.Thumb>
              <Track.IncreaseButton><RepeatButton Name="PART_IncreaseButton" Theme="{StaticResource PlayerTrackButton}" Background="#FF5C6066" /></Track.IncreaseButton>
            </Track>
          </Border>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
  </UserControl.Resources>
  <UserControl.Styles>
    <!-- 图标按钮不要 hover/按下高亮：底色始终与常态一致 -->
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.pin:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#66000000" />
    </Style>
    <Style Selector="Button.pin:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#66000000" />
    </Style>
    <!-- 置顶与未置顶的图标都是纯白，仅靠图形区分状态。 -->
    <Style Selector="Button.pin"><Setter Property="Foreground" Value="#FFFFFFFF" /></Style>
    <Style Selector="Button.pin /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#66000000" />
    </Style>
  </UserControl.Styles>
  <Panel DataContext="{Binding Player}">
    <!-- 黑底 + libmpv 渲染面 -->
    <Rectangle Fill="#000000" />
    <Panel x:Name="VideoHost" />
    <v:DanmakuLayer x:Name="DanmakuCanvas" IsHitTestVisible="False" ClipToBounds="True" />

    <!-- 控制层：参考主流播放器（Earth 图）一比一布局 -->
    <Grid RowDefinitions="Auto,*,Auto" ClipToBounds="True" IsVisible="{Binding Visible}">

      <!-- 标题背景可拖拽；原生关闭按钮结束独立播放窗口，无返回按钮。 -->
      <Grid x:Name="TopControls" IsVisible="{Binding ControlsVisible}" Grid.Row="0" ColumnDefinitions="*,Auto"
            Background="Transparent" Margin="{OnPlatform Default='16,10,132,0', macOS='90,10,16,0'}">
        <StackPanel VerticalAlignment="Center" Spacing="1" IsHitTestVisible="False">
          <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="#80FFFFFF" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Button x:Name="TopmostButton" Grid.Column="1" Classes="pin" Classes.pinned="{Binding AlwaysOnTop}"
                Click="OnToggleTopmost" Background="#66000000" BorderThickness="0" CornerRadius="6"
                Width="{x:Static v:PlayerLayout.TitleBarButtonSize}" Height="{x:Static v:PlayerLayout.TitleBarButtonSize}" Padding="0" Cursor="Hand" ToolTip.Tip="窗口置顶 / 取消置顶">
          <!-- 与播放/暂停同款做法：置顶态与未置顶态用两个不同图标，状态一眼可辨。 -->
          <Panel>
            <PathIcon x:Name="PinnedGlyph" Data="{DynamicResource Icon.Pin}" IsVisible="{Binding AlwaysOnTop}"
                      Width="{x:Static v:PlayerLayout.IconGlyphSize}" Height="{x:Static v:PlayerLayout.IconGlyphSize}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
            <PathIcon x:Name="UnpinnedGlyph" Data="{DynamicResource Icon.PinOff}"
                      IsVisible="{Binding AlwaysOnTop, Converter={x:Static v:BoolConverters.Not}}"
                      Width="{x:Static v:PlayerLayout.IconGlyphSize}" Height="{x:Static v:PlayerLayout.IconGlyphSize}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Panel>
        </Button>
      </Grid>

      <!-- 中央 toast（倍速/跳片头提示） -->
      <Border Grid.Row="1" Background="#CC000000" CornerRadius="9" Padding="14,8"
              VerticalAlignment="Center" HorizontalAlignment="Center"
              IsVisible="{Binding ShowToast}">
        <StackPanel Orientation="Horizontal" Spacing="8" TextElement.Foreground="White">
          <PathIcon Data="{DynamicResource Icon.Play}" Width="12" Height="12" VerticalAlignment="Center" />
          <TextBlock Text="{Binding ToastText}" FontSize="12" VerticalAlignment="Center" />
        </StackPanel>
      </Border>

      <!-- 底部：单个半透明圆角面板（参考图紧凑控制条） -->
      <Border x:Name="BottomControls" IsVisible="{Binding ControlsVisible}" Grid.Row="2" Background="#A6000000" CornerRadius="14"
              BorderBrush="#1AFFFFFF" BorderThickness="1"
              Margin="{x:Static v:PlayerLayout.PanelMargin}" Padding="{x:Static v:PlayerLayout.PanelPadding}" HorizontalAlignment="Center">
        <Border.Width>
          <MultiBinding Converter="{x:Static v:PlayerLayoutConverters.ControlWidth}">
            <Binding Path="$parent[UserControl].Bounds.Width" />
            <Binding Path="CompactMode" />
          </MultiBinding>
        </Border.Width>
        <StackPanel Spacing="{x:Static v:PlayerLayout.RowSpacing}">

          <!-- 上行：左音量贴边 + 右图标组贴边（底层）；播放三键整面板绝对居中（上层） -->
          <Panel>
            <Grid ColumnDefinitions="*,*">
              <!-- 左：喇叭+音量滑杆 -->
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="{x:Static v:PlayerLayout.VolumeSpacing}" VerticalAlignment="Center"
                          HorizontalAlignment="Left">
                <Button Command="{Binding ToggleMuteCommand}" Background="Transparent" BorderThickness="0" CornerRadius="6"
                        Width="{x:Static v:PlayerLayout.IconButtonSize}" Height="{x:Static v:PlayerLayout.IconButtonSize}" Padding="0" Cursor="Hand" ToolTip.Tip="静音 / 恢复音量">
                  <Panel>
                    <PathIcon Data="{DynamicResource Icon.VolumeHigh}" IsVisible="{Binding IsMuted, Converter={x:Static v:BoolConverters.Not}}" Width="{x:Static v:PlayerLayout.IconGlyphSize}" Height="{x:Static v:PlayerLayout.IconGlyphSize}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <PathIcon Data="{DynamicResource Icon.VolumeOff}" IsVisible="{Binding IsMuted}" Width="{x:Static v:PlayerLayout.IconGlyphSize}" Height="{x:Static v:PlayerLayout.IconGlyphSize}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Panel>
                </Button>
                <Slider Classes="player" Theme="{StaticResource PlayerSlider}" Minimum="0" Maximum="100" Value="{Binding Volume}" Width="{x:Static v:PlayerLayout.VolumeSliderWidth}" IsVisible="{Binding CompactMode, Converter={x:Static v:BoolConverters.Not}}" />
              </StackPanel>

              <!-- 右：比例/PiP/拼图/列表/倍速/全屏/设置（参考图顺序） -->
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{x:Static v:PlayerLayout.IconButtonSpacing}" VerticalAlignment="Center"
                          HorizontalAlignment="Right">
                <Button IsVisible="{Binding CompactMode, Converter={x:Static v:BoolConverters.Not}}" Click="OnToggleAspectRatio" Background="Transparent" BorderThickness="0" CornerRadius="6"
                        Width="{x:Static v:PlayerLayout.IconButtonSize}" Height="{x:Static v:PlayerLayout.IconButtonSize}" Padding="0" Cursor="Hand" ToolTip.Tip="画面比例">
                  <PathIcon Data="{DynamicResource Icon.AspectRatio}" Width="{x:Static v:PlayerLayout.IconGlyphSize}" Height="{x:Static v:PlayerLayout.IconGlyphSize}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
                <Button Click="OnTogglePip" Background="Transparent" BorderThickness="0" CornerRadius="6"
                        Width="{x:Static v:PlayerLayout.IconButtonSize}" Height="{x:Static v:PlayerLayout.IconButtonSize}" Padding="0" Cursor="Hand" ToolTip.Tip="置顶小窗 / 恢复窗口">
                  <PathIcon Data="{DynamicResource Icon.PiP}" Width="{x:Static v:PlayerLayout.IconGlyphSize}" Height="{x:Static v:PlayerLayout.IconGlyphSize}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
                <Button IsVisible="{Binding CompactMode, Converter={x:Static v:BoolConverters.Not}}" Click="OnTogglePlugin" Background="Transparent" BorderThickness="0" CornerRadius="6"
                        Width="{x:Static v:PlayerLayout.IconButtonSize}" Height="{x:Static v:PlayerLayout.IconButtonSize}" Padding="0" Cursor="Hand" ToolTip.Tip="插件">
                  <PathIcon Data="{DynamicResource Icon.Puzzle}" Width="{x:Static v:PlayerLayout.IconGlyphSize}" Height="{x:Static v:PlayerLayout.IconGlyphSize}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
                <Button Click="OnTogglePlaylist" Background="Transparent" BorderThickness="0" CornerRadius="6"
                        Width="{x:Static v:PlayerLayout.IconButtonSize}" Height="{x:Static v:PlayerLayout.IconButtonSize}" Padding="0" Cursor="Hand" ToolTip.Tip="播放列表">
                  <PathIcon Data="{DynamicResource Icon.Playlist}" Width="{x:Static v:PlayerLayout.IconGlyphSize}" Height="{x:Static v:PlayerLayout.IconGlyphSize}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
                <Button x:Name="RateButton" Click="OnSelectRate" Background="Transparent" BorderThickness="0" CornerRadius="6"
                        Padding="4,0" Height="{x:Static v:PlayerLayout.IconButtonSize}" Cursor="Hand" ToolTip.Tip="倍速">
                  <StackPanel Orientation="Horizontal" Spacing="3">
                    <PathIcon Data="{DynamicResource Icon.Speed}" Width="{x:Static v:PlayerLayout.IconGlyphSize}" Height="{x:Static v:PlayerLayout.IconGlyphSize}" VerticalAlignment="Center" />
                    <TextBlock x:Name="RateBadge" Text="{Binding Rate, StringFormat={}{0:0.##}x}" FontSize="10.5" Foreground="#FFD2D5DA"
                               VerticalAlignment="Center" FontWeight="SemiBold" />
                  </StackPanel>
                </Button>
                <Button Click="OnToggleFullscreen" Background="Transparent" BorderThickness="0" CornerRadius="6"
                        Width="{x:Static v:PlayerLayout.IconButtonSize}" Height="{x:Static v:PlayerLayout.IconButtonSize}" Padding="0" Cursor="Hand" ToolTip.Tip="全屏">
                  <PathIcon Data="{DynamicResource Icon.Fullscreen}" Width="{x:Static v:PlayerLayout.IconGlyphSize}" Height="{x:Static v:PlayerLayout.IconGlyphSize}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
                <Button Click="OnToggleSettings" Background="Transparent" BorderThickness="0" CornerRadius="6"
                        Width="{x:Static v:PlayerLayout.IconButtonSize}" Height="{x:Static v:PlayerLayout.IconButtonSize}" Padding="0" Cursor="Hand" ToolTip.Tip="设置">
                  <PathIcon Data="{DynamicResource Icon.Settings}" Width="{x:Static v:PlayerLayout.IconGlyphSize}" Height="{x:Static v:PlayerLayout.IconGlyphSize}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
              </StackPanel>
            </Grid>

            <!-- 上层：上一集/播放/下一集三键（等大 30px，图标统一 18px）。 -->
            <StackPanel Orientation="Horizontal" Spacing="{x:Static v:PlayerLayout.TransportSpacing}" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Button Command="{Binding PreviousEpisodeCommand}" Background="Transparent" BorderThickness="0" CornerRadius="6"
                      Width="{x:Static v:PlayerLayout.TransportButtonSize}" Height="{x:Static v:PlayerLayout.TransportButtonSize}" Padding="0" Cursor="Hand" ToolTip.Tip="上一集">
                <PathIcon Data="{DynamicResource Icon.SkipPrevious}" Width="{x:Static v:PlayerLayout.TransportGlyphSize}" Height="{x:Static v:PlayerLayout.TransportGlyphSize}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Button>
              <Button Click="OnTogglePlay" Background="Transparent" BorderThickness="0" CornerRadius="7"
                      Width="{x:Static v:PlayerLayout.TransportButtonSize}" Height="{x:Static v:PlayerLayout.TransportButtonSize}" Padding="0" Cursor="Hand" ToolTip.Tip="播放/暂停">
                <Panel>
                  <PathIcon Data="{DynamicResource Icon.Pause}" IsVisible="{Binding IsPlaying}" Width="{x:Static v:PlayerLayout.TransportGlyphSize}" Height="{x:Static v:PlayerLayout.TransportGlyphSize}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <PathIcon Data="{DynamicResource Icon.Play}" IsVisible="{Binding IsPlaying, Converter={x:Static v:BoolConverters.Not}}" Width="{x:Static v:PlayerLayout.TransportGlyphSize}" Height="{x:Static v:PlayerLayout.TransportGlyphSize}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Panel>
              </Button>
              <Button Command="{Binding NextEpisodeCommand}" Background="Transparent" BorderThickness="0" CornerRadius="6"
                      Width="{x:Static v:PlayerLayout.TransportButtonSize}" Height="{x:Static v:PlayerLayout.TransportButtonSize}" Padding="0" Cursor="Hand" ToolTip.Tip="下一集">
                <PathIcon Data="{DynamicResource Icon.SkipNext}" Width="{x:Static v:PlayerLayout.TransportGlyphSize}" Height="{x:Static v:PlayerLayout.TransportGlyphSize}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Button>
            </StackPanel>
          </Panel>

          <!-- 下行：时间 + 进度条 + 总时长 -->
          <Grid ColumnDefinitions="Auto,*,Auto">
            <TextBlock Grid.Column="0" Text="{Binding Position, Converter={x:Static v:TimeConverters.ToTime}, Mode=OneWay}"
                       FontSize="11.5" Foreground="#A0FFFFFF" VerticalAlignment="Center" Margin="2,0,8,0" />
            <Slider x:Name="ProgressSlider" Grid.Column="1" Classes="player" Theme="{StaticResource PlayerSlider}" Minimum="0" Maximum="{Binding Duration.TotalSeconds, Mode=OneWay}"
                    Value="{Binding SeekPositionSeconds, Mode=TwoWay}" />
            <TextBlock Grid.Column="2" Text="{Binding Duration, Converter={x:Static v:TimeConverters.ToTime}, Mode=OneWay}"
                       FontSize="11.5" Foreground="#A0FFFFFF" VerticalAlignment="Center" Margin="8,0,2,0" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- 播放列表抽屉：从窗口右侧滑入，覆盖在视频之上；点空白处或再点列表按钮收起。 -->
      <Border x:Name="PlaylistDrawer" Grid.RowSpan="3" HorizontalAlignment="Right" IsVisible="False"
              Width="{Binding $parent[UserControl].Bounds.Width, Converter={x:Static v:PlayerLayoutConverters.PlaylistDrawerWidth}}"
              Background="#F0121417" BorderBrush="#1AFFFFFF" BorderThickness="1,0,0,0">
        <Border.RenderTransform>
          <TranslateTransform />
        </Border.RenderTransform>
        <Border.Transitions>
          <Transitions>
            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="CubicEaseOut" />
          </Transitions>
        </Border.Transitions>
        <Grid RowDefinitions="Auto,*">
          <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="14,12,14,8">
            <TextBlock Text="播放列表" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock x:Name="PlaylistCount" Grid.Column="2" FontSize="11" Foreground="#80FFFFFF" VerticalAlignment="Center" />
          </Grid>
          <ScrollViewer Grid.Row="1" Padding="8,0,8,10" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="PlaylistItems" Spacing="2" />
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Panel>
</UserControl>
