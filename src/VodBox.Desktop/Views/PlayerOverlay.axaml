<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VodBox.Desktop.ViewModels"
             xmlns:design="clr-namespace:VodBox.Desktop.Design"
             xmlns:v="clr-namespace:VodBox.Desktop.Views"
             x:Class="VodBox.Desktop.Views.PlayerOverlay" x:DataType="vm:MainViewModel">
  <Design.DataContext>
    <x:Static Member="design:DesignData.MainForDesign" />
  </Design.DataContext>
  <Panel DataContext="{Binding Player}">
    <!-- 黑底 + libmpv 渲染面 -->
    <Rectangle Fill="#000000" />
    <Panel x:Name="VideoHost" />

    <!-- 控制层：参考主流播放器（Earth 图）一比一布局 -->
    <Grid RowDefinitions="Auto,*,Auto" IsVisible="{Binding Visible}">

      <!-- 顶栏：返回箭头 + 标题 + 副标题 · 右侧分辨率角标 -->
      <Grid x:Name="TopControls" IsVisible="{Binding ControlsVisible}" Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="16,12,16,0">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
          <Button Click="OnClose" Background="#66000000" BorderThickness="0"
                  CornerRadius="8" Width="32" Height="32" Padding="0" Cursor="Hand" ToolTip.Tip="返回">
            <PathIcon Data="{DynamicResource Icon.Back}" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Button>
          <StackPanel VerticalAlignment="Center" Spacing="1">
            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="#80FFFFFF" />
          </StackPanel>
        </StackPanel>

      </Grid>

      <!-- 中央 toast（倍速/跳片头提示） -->
      <Border Grid.Row="1" Background="#CC000000" CornerRadius="9" Padding="14,8"
              VerticalAlignment="Center" HorizontalAlignment="Center"
              IsVisible="{Binding ShowToast}">
        <StackPanel Orientation="Horizontal" Spacing="8" TextElement.Foreground="White">
          <PathIcon Data="{DynamicResource Icon.Play}" Width="12" Height="12" VerticalAlignment="Center" />
          <TextBlock Text="{Binding ToastText}" FontSize="12" VerticalAlignment="Center" />
        </StackPanel>
      </Border>

      <!-- 底部：单个半透明圆角面板（参考图紧凑控制条） -->
      <Border x:Name="BottomControls" IsVisible="{Binding ControlsVisible}" Grid.Row="2" Background="#A6000000" CornerRadius="14"
              BorderBrush="#1AFFFFFF" BorderThickness="1"
              Margin="52,0,52,16" Padding="20,12,20,14" HorizontalAlignment="Stretch">
        <StackPanel Spacing="8">

          <!-- 上行：左音量贴边 + 右图标组贴边（底层）；播放三键整面板绝对居中（上层） -->
          <Panel>
            <Grid ColumnDefinitions="*,*">
              <!-- 左：喇叭+音量滑杆 -->
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                          HorizontalAlignment="Left">
                <Button Command="{Binding ToggleMuteCommand}" Background="Transparent" BorderThickness="0" CornerRadius="6"
                        Width="28" Height="28" Padding="0" Cursor="Hand" ToolTip.Tip="静音 / 恢复音量">
                  <Panel>
                    <PathIcon Data="{DynamicResource Icon.VolumeHigh}" IsVisible="{Binding IsMuted, Converter={x:Static v:BoolConverters.Not}}" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <PathIcon Data="{DynamicResource Icon.VolumeOff}" IsVisible="{Binding IsMuted}" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Panel>
                </Button>
                <Slider Classes="md" Minimum="0" Maximum="100" Value="{Binding Volume}" Width="80" />
              </StackPanel>

              <!-- 右：比例/PiP/拼图/列表/倍速/全屏/设置（参考图顺序） -->
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                          HorizontalAlignment="Right">
                <Button Click="OnToggleAspectRatio" Background="Transparent" BorderThickness="0" CornerRadius="6"
                        Width="30" Height="30" Padding="0" Cursor="Hand" ToolTip.Tip="画面比例">
                  <PathIcon Data="{DynamicResource Icon.AspectRatio}" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
                <Button Click="OnTogglePip" Background="Transparent" BorderThickness="0" CornerRadius="6"
                        Width="30" Height="30" Padding="0" Cursor="Hand" ToolTip.Tip="画中画">
                  <PathIcon Data="{DynamicResource Icon.PiP}" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
                <Button Click="OnTogglePlugin" Background="Transparent" BorderThickness="0" CornerRadius="6"
                        Width="30" Height="30" Padding="0" Cursor="Hand" ToolTip.Tip="插件">
                  <PathIcon Data="{DynamicResource Icon.Puzzle}" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
                <Button Click="OnTogglePlaylist" Background="Transparent" BorderThickness="0" CornerRadius="6"
                        Width="30" Height="30" Padding="0" Cursor="Hand" ToolTip.Tip="播放列表">
                  <PathIcon Data="{DynamicResource Icon.Playlist}" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
                <Button Click="OnCycleRate" Background="Transparent" BorderThickness="0" CornerRadius="6"
                        Padding="5,0" Height="30" Cursor="Hand" ToolTip.Tip="倍速">
                  <StackPanel Orientation="Horizontal" Spacing="3">
                    <PathIcon Data="{DynamicResource Icon.Speed}" Width="18" Height="18" VerticalAlignment="Center" />
                    <TextBlock x:Name="RateBadge" Text="{Binding Rate, StringFormat={}{0:0.##}x}" FontSize="10.5" Foreground="#4CC2FF"
                               VerticalAlignment="Center" FontWeight="SemiBold" />
                  </StackPanel>
                </Button>
                <Button Click="OnToggleFullscreen" Background="Transparent" BorderThickness="0" CornerRadius="6"
                        Width="30" Height="30" Padding="0" Cursor="Hand" ToolTip.Tip="全屏">
                  <PathIcon Data="{DynamicResource Icon.Fullscreen}" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
                <Button Click="OnToggleSettings" Background="Transparent" BorderThickness="0" CornerRadius="6"
                        Width="30" Height="30" Padding="0" Cursor="Hand" ToolTip.Tip="设置">
                  <PathIcon Data="{DynamicResource Icon.Settings}" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
              </StackPanel>
            </Grid>

            <!-- 上层：跳过/播放/快进三键（等大 34px，图标统一 18px）。 -->
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Button Command="{Binding PreviousEpisodeCommand}" IsEnabled="{Binding HasPreviousEpisode}" Background="Transparent" BorderThickness="0" CornerRadius="6"
                      Width="34" Height="34" Padding="0" Cursor="Hand" ToolTip.Tip="上一集">
                <PathIcon Data="{DynamicResource Icon.SkipPrevious}" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Button>
              <Button Click="OnTogglePlay" Background="Transparent" BorderThickness="0" CornerRadius="7"
                      Width="34" Height="34" Padding="0" Cursor="Hand" ToolTip.Tip="播放/暂停">
                <Panel>
                  <PathIcon Data="{DynamicResource Icon.Pause}" IsVisible="{Binding IsPlaying}" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <PathIcon Data="{DynamicResource Icon.Play}" IsVisible="{Binding IsPlaying, Converter={x:Static v:BoolConverters.Not}}" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Panel>
              </Button>
              <Button Command="{Binding NextEpisodeCommand}" IsEnabled="{Binding HasNextEpisode}" Background="Transparent" BorderThickness="0" CornerRadius="6"
                      Width="34" Height="34" Padding="0" Cursor="Hand" ToolTip.Tip="下一集">
                <PathIcon Data="{DynamicResource Icon.SkipNext}" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Button>
            </StackPanel>
          </Panel>

          <!-- 下行：时间 + 进度条 + 总时长 -->
          <Grid ColumnDefinitions="Auto,*,Auto">
            <TextBlock Grid.Column="0" Text="{Binding Position, Converter={x:Static v:TimeConverters.ToTime}, Mode=OneWay}"
                       FontSize="11.5" Foreground="#A0FFFFFF" VerticalAlignment="Center" Margin="2,0,8,0" />
            <Slider x:Name="ProgressSlider" Grid.Column="1" Classes="md" Minimum="0" Maximum="{Binding Duration.TotalSeconds, Mode=OneWay}"
                    Value="{Binding SeekPositionSeconds, Mode=TwoWay}" />
            <TextBlock Grid.Column="2" Text="{Binding Duration, Converter={x:Static v:TimeConverters.ToTime}, Mode=OneWay}"
                       FontSize="11.5" Foreground="#A0FFFFFF" VerticalAlignment="Center" Margin="8,0,2,0" />
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
  </Panel>
</UserControl>
