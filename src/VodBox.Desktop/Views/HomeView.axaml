<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VodBox.Desktop.ViewModels"
             xmlns:design="clr-namespace:VodBox.Desktop.Design"
             xmlns:views="clr-namespace:VodBox.Desktop.Views"
             x:Class="VodBox.Desktop.Views.HomeView" x:DataType="vm:MainViewModel">
  <Design.DataContext>
    <x:Static Member="design:DesignData.MainForDesign" />
  </Design.DataContext>
  <ScrollViewer Padding="28,12,28,28">
    <StackPanel Spacing="26" DataContext="{Binding Home}">

      <!-- 英雄区（蓝紫渐变 + 左侧文字遮罩 + 按钮组 + 轮播指示器，对齐设计稿 p-home） -->
      <Border x:Name="HeroCard" CornerRadius="{DynamicResource AppPosterCornerRadius}" Height="300" ClipToBounds="True" PointerPressed="OnHeroPressed" PointerEntered="OnHeroPointerEntered" PointerExited="OnHeroPointerExited" Cursor="Hand">
        <Panel>
          <!-- 蓝紫渐变底 -->
          <Border>
            <Border.Background>
              <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#1E3A5F" Offset="0" />
                <GradientStop Color="#2D1B4E" Offset="0.6" />
                <GradientStop Color="#4A1B4E" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
          </Border>
          <views:RemotePoster Url="{Binding HeroPoster}" />
          <!-- 左侧文字可读性遮罩 -->
          <Border>
            <Border.Background>
              <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                <GradientStop Color="#E00E0E14" Offset="0" />
                <GradientStop Color="#990E0E14" Offset="0.55" />
                <GradientStop Color="#000E0E14" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
          </Border>
          <StackPanel VerticalAlignment="Bottom" Margin="32,0,32,28" Spacing="8" IsVisible="{Binding !Loading}">
            <TextBlock Text="{Binding HeroPositionLabel}" FontSize="11.5" Foreground="#4CC2FF" LetterSpacing="2" />
            <TextBlock Text="{Binding HeroTitle}" FontSize="30" FontWeight="SemiBold" />
            <TextBlock Text="{Binding HeroRemarks}" FontSize="13" Foreground="#4CC2FF" />
            <TextBlock Text="{Binding HeroDescription}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.9" TextWrapping="Wrap" MaxWidth="560" MaxLines="2" TextTrimming="CharacterEllipsis" />
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
              <Button Background="#0078D4" Foreground="White" BorderThickness="0"
                      CornerRadius="{DynamicResource AppControlCornerRadius}" Padding="18,9" Click="OnHeroPlay" Cursor="Hand">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Data="{StaticResource Icon.Play}" Width="18" Height="18" />
                  <TextBlock Text="立即播放" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Content="详情" Background="{DynamicResource CardHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="1"
                      BorderBrush="{DynamicResource StrokeBrush}" CornerRadius="{DynamicResource AppControlCornerRadius}" Padding="18,9" Click="OnHeroClick" Cursor="Hand" />
              <Button Background="{DynamicResource CardHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="1"
                      BorderBrush="{DynamicResource StrokeBrush}" CornerRadius="{DynamicResource AppControlCornerRadius}" Padding="18,9" Click="OnHeroClick" Cursor="Hand">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Data="{StaticResource Icon.Star}" Width="18" Height="18" />
                  <TextBlock Text="收藏" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>
          <!-- 英雄区骨架：网络首屏未就绪时占位，避免标题/简介空白 -->
          <StackPanel VerticalAlignment="Bottom" Margin="32,0,32,28" Spacing="10" IsVisible="{Binding Loading}">
            <Border Classes="skeleton hero" Height="11.5" Width="120" HorizontalAlignment="Left" />
            <Border Classes="skeleton hero" Height="30" Width="320" HorizontalAlignment="Left" />
            <Border Classes="skeleton hero" Height="13" Width="200" HorizontalAlignment="Left" />
            <Border Classes="skeleton hero" Height="12" Width="460" HorizontalAlignment="Left" />
            <Border Classes="skeleton hero" Height="12" Width="340" HorizontalAlignment="Left" />
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
              <Border Classes="skeleton hero" Height="38" Width="126" />
              <Border Classes="skeleton hero" Height="38" Width="76" />
              <Border Classes="skeleton hero" Height="38" Width="92" />
            </StackPanel>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0" IsVisible="{Binding CanRotateHero}">
            <Button x:Name="PreviousHero" Command="{Binding PreviousHeroCommand}" Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#60000000" Foreground="White" ToolTip.Tip="上一张推荐">
              <PathIcon Data="{StaticResource Icon.ChevronLeft}" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
            <Button x:Name="NextHero" Command="{Binding NextHeroCommand}" Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#60000000" Foreground="White" ToolTip.Tip="下一张推荐">
              <PathIcon Data="{StaticResource Icon.ChevronRight}" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
          </StackPanel>
          <ItemsControl x:Name="HeroIndicators" ItemsSource="{Binding HeroSlides}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,24" IsVisible="{Binding CanRotateHero}">
            <ItemsControl.Styles>
              <Style Selector="Button.heroIndicator">
                <Setter Property="Width" Value="8" /><Setter Property="Height" Value="8" />
                <Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="3,0" />
                <Setter Property="CornerRadius" Value="4" /><Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="#59FFFFFF" />
              </Style>
              <Style Selector="Button.heroIndicator.active">
                <Setter Property="Width" Value="22" /><Setter Property="Background" Value="#4CC2FF" />
              </Style>
            </ItemsControl.Styles>
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:HomeViewModel+HeroSlide">
                <Button Classes="heroIndicator" Classes.active="{Binding IsSelected}" Tag="{Binding Index}" Click="OnSelectHero" ToolTip.Tip="{Binding Item.Title}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Panel>
      </Border>

      <!-- 最近观看 -->
      <StackPanel Spacing="14">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <PathIcon Data="{StaticResource Icon.History}" Width="18" Height="18" VerticalAlignment="Center" />
          <TextBlock Text="最近观看" FontSize="16" FontWeight="SemiBold" />
          <StackPanel Orientation="Horizontal" Spacing="4" TextElement.Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"
                      Cursor="Hand" PointerPressed="OnShowAllHistory">
            <TextBlock Text="查看全部" FontSize="12" VerticalAlignment="Center" />
            <PathIcon Data="{StaticResource Icon.ChevronRight}" Width="12" Height="12" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
        <Panel>
        <!-- 最近观看永远只有一行：横向 ScrollViewer 承载，支持左右滑动，最多前 20 条。 -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                      IsVisible="{Binding !ShowRecentSkeleton}">
          <ItemsControl ItemsSource="{Binding Recent}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="16" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Width="150" Cursor="Hand" PointerPressed="OnResumeHistory" Tag="{Binding}">
                <Border CornerRadius="{DynamicResource AppPosterCornerRadius}" Height="225" Background="#274064" ClipToBounds="True">
                  <Panel>
                    <Panel IsVisible="{Binding #HomeRecentPoster.HasImage, Converter={x:Static views:BoolConverters.Not}}">
                      <PathIcon Data="{StaticResource Icon.Filmstrip}" Width="48" Height="48" Opacity="0.25" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding Converter={x:Static views:HistoryConverters.IsNotLive}}" />
                      <PathIcon Data="{StaticResource Icon.Broadcast}" Width="24" Height="24" Opacity="0.3" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding Converter={x:Static views:HistoryConverters.IsLive}}" />
                    </Panel>
                    <views:RemotePoster x:Name="HomeRecentPoster" Url="{Binding Poster}" ChannelName="{Binding Converter={x:Static views:HistoryConverters.ChannelName}}" Stretch="{Binding Converter={x:Static views:HistoryConverters.CoverStretch}}" />
                    <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,0">
                      <Border Background="#66000000" Padding="8,18,8,7">
                        <TextBlock Text="{Binding Remarks}" FontSize="10.5" Foreground="White" TextTrimming="CharacterEllipsis" />
                      </Border>
                    </StackPanel>
                  </Panel>
                </Border>
                <TextBlock Text="{Binding Title}" FontSize="13" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                <Border Height="3" CornerRadius="2" Background="#1FFFFFFF" Margin="0,6,0,0">
                  <Border Background="#4CC2FF" Height="3" CornerRadius="2"
                          Width="{Binding PositionMs, ConverterParameter={Binding DurationMs}, Converter={x:Static views:ProgressConverters.Ratio}}" />
                </Border>
              </StackPanel>
            </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <!-- 最近观看骨架：本地库读取中占位（读得快，通常一闪而过，不留空白） -->
        <ItemsControl ItemsSource="{x:Static views:SkeletonData.Recent}" IsVisible="{Binding ShowRecentSkeleton}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="16" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Width="150">
                <Border Classes="skeleton poster" Height="225" />
                <Border Classes="skeleton" Height="13" Width="112" Margin="0,8,0,0" HorizontalAlignment="Left" />
                <Border Classes="skeleton" Height="3" Margin="0,6,0,0" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ProgressBar IsIndeterminate="True" Height="3" VerticalAlignment="Bottom" IsVisible="{Binding RecentLoading}" />
        <TextBlock Text="{Binding RecentHint}" TextWrapping="Wrap" Foreground="{DynamicResource TextTertiaryBrush}"
                   IsVisible="{Binding RecentHint, Converter={x:Static views:StringConverters.IsNotNullOrEmpty}}" />
        <!-- 空态：加载结束仍无观看记录 -->
        <TextBlock Text="暂无观看记录" FontSize="12.5" Foreground="{DynamicResource TextTertiaryBrush}"
                   Margin="2,4,0,0" VerticalAlignment="Center" IsVisible="{Binding ShowRecentEmpty}" />
        </Panel>
      </StackPanel>

      <!-- 推荐 -->
      <StackPanel Spacing="14">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <PathIcon Data="{StaticResource Icon.Sparkles}" Width="18" Height="18" VerticalAlignment="Center" />
          <TextBlock FontSize="16" FontWeight="SemiBold" Text="站点推荐" />
          <TextBlock Text="{Binding SourceName}" FontSize="12.5" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
          <StackPanel Orientation="Horizontal" Spacing="4" TextElement.Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" Cursor="Hand"
                      PointerPressed="OnSwitchSource">
            <TextBlock Text="换源" FontSize="12" VerticalAlignment="Center" />
            <PathIcon Data="{StaticResource Icon.ChevronDown}" Width="12" Height="12" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
        <Panel>
        <ItemsControl ItemsSource="{Binding Recommendations}" IsVisible="{Binding !Loading}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="6" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,0,16,0" Cursor="Hand" PointerPressed="OnOpenRecommend" Tag="{Binding}">
                <Border CornerRadius="{DynamicResource AppPosterCornerRadius}" Height="210" Background="#3A2A55" ClipToBounds="True">
                  <Panel>
                    <PathIcon Data="{StaticResource Icon.Movie}" Width="48" Height="48" Opacity="0.25" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <views:RemotePoster Url="{Binding Poster}" />
                    <Border Background="#66000000" CornerRadius="5" Padding="7,2" HorizontalAlignment="Right"
                            VerticalAlignment="Top" Margin="6">
                      <TextBlock Text="{Binding Remarks}" FontSize="10.5" Foreground="#4CC2FF" TextTrimming="CharacterEllipsis" MaxWidth="90" />
                    </Border>
                  </Panel>
                </Border>
                <TextBlock Text="{Binding Title}" FontSize="13" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                <TextBlock FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                  <Run Text="{Binding Year}" /><Run Text=" · " /><Run Text="{Binding Area}" />
                </TextBlock>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ProgressBar IsIndeterminate="True" Height="3" VerticalAlignment="Bottom" IsVisible="{Binding Loading}" />
        <!-- 推荐区骨架：站点头屏加载中 -->
        <ItemsControl ItemsSource="{x:Static views:SkeletonData.Cards}" IsVisible="{Binding Loading}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="6" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,0,16,0">
                <Border Classes="skeleton poster" Height="210" />
                <Border Classes="skeleton" Height="13" Width="112" Margin="0,9,0,0" HorizontalAlignment="Left" />
                <Border Classes="skeleton" Height="11" Width="78" Margin="0,6,0,0" HorizontalAlignment="Left" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!-- 空态 / 错误态：非空文案覆盖网格位置，不留白屏 -->
        <TextBlock Text="{Binding RecommendationsHint}" Margin="0,4,0,0" FontSize="12.5"
                   Foreground="{DynamicResource TextTertiaryBrush}"
                   IsVisible="{Binding RecommendationsHint, Converter={x:Static views:StringConverters.IsNotNullOrEmpty}}" />
        </Panel>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
