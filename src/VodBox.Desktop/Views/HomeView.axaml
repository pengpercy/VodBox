<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VodBox.Desktop.ViewModels"
             xmlns:design="clr-namespace:VodBox.Desktop.Design"
             xmlns:views="clr-namespace:VodBox.Desktop.Views"
             x:Class="VodBox.Desktop.Views.HomeView" x:DataType="vm:MainViewModel">
  <Design.DataContext>
    <x:Static Member="design:DesignData.Main" />
  </Design.DataContext>
  <ScrollViewer Padding="28,12,28,28">
    <StackPanel Spacing="26" DataContext="{Binding Home}">

      <!-- 英雄区 -->
      <Border CornerRadius="12" Height="300" ClipToBounds="True" Background="#3A2F4A"
              PointerPressed="OnHeroPressed" Cursor="Hand">
        <Panel>
          <Border Background="#2B3242" />
          <Border>
            <Border.Background>
              <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                <GradientStop Color="#E6161620" Offset="0" />
                <GradientStop Color="#73161620" Offset="0.55" />
                <GradientStop Color="#00161620" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
          </Border>
          <StackPanel VerticalAlignment="Bottom" Margin="32,0,32,28" Spacing="8">
            <TextBlock Text="今日推荐 · TOP 1" FontSize="11.5" Foreground="#4CC2FF" LetterSpacing="2" />
            <TextBlock Text="{Binding HeroTitle}" FontSize="30" FontWeight="SemiBold" />
            <TextBlock Text="{Binding HeroRemarks}" FontSize="13" Foreground="#4CC2FF" />
            <TextBlock Text="{Binding HeroDescription}" FontSize="12.5" Foreground="#C7FFFFFF" Opacity="0.9" TextWrapping="Wrap" MaxWidth="560" />
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
              <Button Content="▶ 立即播放" Background="#0078D4" Foreground="White" BorderThickness="0"
                      CornerRadius="7" Padding="18,9" Click="OnHeroPlay" Cursor="Hand" />
              <Button Content="⭐ 收藏" Background="#12FFFFFF" Foreground="White" BorderThickness="1"
                      BorderBrush="#17FFFFFF" CornerRadius="7" Padding="18,9" Click="OnHeroClick" Cursor="Hand" />
            </StackPanel>
          </StackPanel>
        </Panel>
      </Border>

      <!-- 最近观看 -->
      <StackPanel Spacing="14">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="🕘 最近观看" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Text="查看全部 ›" FontSize="12" Foreground="#85FFFFFF" VerticalAlignment="Center"
                     Cursor="Hand" PointerPressed="OnShowAllHistory" />
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Recent}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="16" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Width="150" Cursor="Hand" PointerPressed="OnResumeHistory" Tag="{Binding}">
                <Border CornerRadius="8" Height="225" Background="#274064" ClipToBounds="True">
                  <Panel>
                    <TextBlock Text="🎞" FontSize="34" Opacity="0.25" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,0">
                      <Border Background="#66000000" Padding="8,18,8,7">
                        <TextBlock Text="{Binding Remarks}" FontSize="10.5" Foreground="White" TextTrimming="CharacterEllipsis" />
                      </Border>
                    </StackPanel>
                  </Panel>
                </Border>
                <TextBlock Text="{Binding Title}" FontSize="13" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                <Border Height="3" CornerRadius="2" Background="#1FFFFFFF" Margin="0,6,0,0">
                  <Border Background="#4CC2FF" Height="3" CornerRadius="2"
                          Width="{Binding PositionMs, ConverterParameter={Binding DurationMs}, Converter={x:Static views:ProgressConverters.Ratio}}" />
                </Border>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- 推荐 -->
      <StackPanel Spacing="14">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="✨ 站点推荐" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Text="换源 ▾" FontSize="12" Foreground="#85FFFFFF" VerticalAlignment="Center" Cursor="Hand"
                     PointerPressed="OnSwitchSource" />
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Recommendations}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="6" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,0,16,0" Cursor="Hand" PointerPressed="OnOpenRecommend" Tag="{Binding}">
                <Border CornerRadius="8" Height="210" Background="#3A2A55" ClipToBounds="True">
                  <Panel>
                    <TextBlock Text="🎬" FontSize="32" Opacity="0.25" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Border Background="#66000000" CornerRadius="5" Padding="7,2" HorizontalAlignment="Right"
                            VerticalAlignment="Top" Margin="6">
                      <TextBlock Text="{Binding Remarks}" FontSize="10.5" Foreground="#4CC2FF" TextTrimming="CharacterEllipsis" MaxWidth="90" />
                    </Border>
                  </Panel>
                </Border>
                <TextBlock Text="{Binding Title}" FontSize="13" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                <TextBlock FontSize="11" Foreground="#85FFFFFF" Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                  <Run Text="{Binding Year}" /><Run Text=" · " /><Run Text="{Binding Area}" />
                </TextBlock>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
