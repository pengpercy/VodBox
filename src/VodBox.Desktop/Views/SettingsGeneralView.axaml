<UserControl
    xmlns="https://github.com/avaloniaui" xmlns:vm="using:VodBox.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="VodBox.Desktop.Views.SettingsGeneralView" x:DataType="vm:MainViewModel" x:CompileBindings="True"
    xmlns:core="using:VodBox.Core">
  <Design.DataContext>
    <vm:DesignMainViewModel />
  </Design.DataContext>
  <ScrollViewer>
    <StackPanel Spacing="16" Margin="0,12">
      <TextBlock Text="数据备份" FontWeight="SemiBold" FontSize="18" />
      <Button Content="导出数据备份" Click="ExportBackupClick" IsEnabled="{Binding !IsBusy}" />
      <Button Content="导入备份并合并数据" Click="ImportBackupClick" IsEnabled="{Binding !IsBusy}" />
      <TextBlock Text="备份包括配置、偏好、全部历史和收藏，可能包含配置中的访问凭据。导入保留较新的历史和已有收藏；同名配置及偏好将被替换，先自动保存导入前备份。媒体文件和外部脚本需自行迁移。" TextWrapping="Wrap" Classes="muted" />
      <TextBlock Text="已保存的配置" FontWeight="SemiBold" FontSize="18" />
      <ComboBox ItemsSource="{Binding SavedConfigurations}" SelectedItem="{Binding SelectedSavedConfiguration}" HorizontalAlignment="Stretch">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="core:SavedConfiguration">
            <TextBlock Text="{Binding Id}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <Button Content="切换到保存的配置" Command="{Binding LoadSavedConfigurationCommand}" CommandParameter="{Binding SelectedSavedConfiguration}" />
      <Button Content="移除保存的配置" Command="{Binding RemoveSavedConfigurationCommand}" CommandParameter="{Binding SelectedSavedConfiguration}" />
      <ToggleSwitch Content="直播自动切换备用线路" IsChecked="{Binding AutoLiveFallback}" />
      <ToggleSwitch Content="启动时恢复上次直播频道" IsChecked="{Binding ResumeLiveOnStartup}" />
      <TextBlock Text="界面主题" />
      <ComboBox ItemsSource="{Binding ThemeChoices}" SelectedItem="{Binding Theme}" HorizontalAlignment="Stretch" />
      <TextBlock Text="内容配置" FontWeight="SemiBold" FontSize="18" />
      <TextBox Text="{Binding ConfigLocation}" PlaceholderText="VodBox JSON 配置路径或 URL" />
      <Button Content="加载配置" Command="{Binding LoadConfigCommand}" />
      <Button Content="从文件选择配置" Click="OpenConfigClick" />
      <TextBlock Text="支持 C#、QuickJS、Python 与 Node.js 内容源。旧 TV 配置暂不支持。" TextWrapping="Wrap" Classes="muted" />
      <TextBlock Text="快捷键：空格 暂停/继续；左右 ±10 秒；上下 音量；M 静音；F11 全屏；Esc 退出全屏；PageUp / PageDown 上下集；Ctrl / ⌘ + O 打开文件。" Classes="muted" TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
