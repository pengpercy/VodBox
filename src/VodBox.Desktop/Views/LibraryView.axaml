<UserControl
    xmlns="https://github.com/avaloniaui" xmlns:vm="using:VodBox.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:VodBox.Core" x:Class="VodBox.Desktop.Views.LibraryView" x:DataType="vm:MainViewModel"
    x:CompileBindings="True">
  <Design.DataContext>
    <vm:DesignMainViewModel />
  </Design.DataContext>
  <Grid RowDefinitions="Auto,*" RowSpacing="12">
    <StackPanel Spacing="10">
      <Grid ColumnDefinitions="*" ColumnSpacing="8">
        <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" HorizontalAlignment="Stretch">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="core:SourceDefinition">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </Grid>
      <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="core:Category">
            <TextBlock Text="{Binding Name}" Margin="12,6" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <Grid IsVisible="{Binding HasLibraryFilters}" ColumnDefinitions="*,*" ColumnSpacing="8">
        <ComboBox ItemsSource="{Binding YearChoices}" SelectedItem="{Binding SelectedYear}" HorizontalAlignment="Stretch">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:FilterChoice">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <ComboBox Grid.Column="1" ItemsSource="{Binding CompletionChoices}" SelectedItem="{Binding SelectedCompletion}" HorizontalAlignment="Stretch">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:FilterChoice">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </Grid>
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
        <TextBox Text="{Binding SearchText}" PlaceholderText="搜索内容" />
        <Button Grid.Column="1" Content="当前源" Command="{Binding SearchCommand}" />
        <Button Grid.Column="2" Content="全源搜索" Command="{Binding SearchAllCommand}" />
      </Grid>
    </StackPanel>
    <Grid RowDefinitions="*,Auto,Auto" RowSpacing="8" Grid.Row="1">
      <ListBox x:Name="PosterGrid" IsVisible="{Binding !AggregateResultsVisible}" ItemsSource="{Binding CardRows}" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          </Style>
          <Style Selector="Button.poster.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:MediaCardRow">
            <ItemsControl ItemsSource="{Binding Cards}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="{Binding Columns}" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MediaCard">
                  <Button Classes="poster" Classes.selected="{Binding IsSelected}" Click="MediaCardClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="6" Margin="3" BorderThickness="2" Background="{DynamicResource CardSurfaceBrush}">
                    <StackPanel Spacing="6">
                      <Border Background="{DynamicResource CardSurfaceBrush}" CornerRadius="4" Height="190" ClipToBounds="True">
                        <Grid>
                          <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Margin="12" VerticalAlignment="Center" HorizontalAlignment="Center" Classes="muted" />
                          <Image Source="{Binding Poster}" Stretch="UniformToFill" AttachedToVisualTree="PosterAttached" DetachedFromVisualTree="PosterDetached" DataContextChanged="PosterContextChanged" />
                        </Grid>
                      </Border>
                      <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Remarks}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" MinHeight="16" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <ListBox IsVisible="{Binding AggregateResultsVisible}" ItemsSource="{Binding SearchResults}" SelectionChanged="SearchSelectionChanged" Background="Transparent">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="core:SearchHit">
            <StackPanel Margin="8" Spacing="4">
              <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding SourceName}" Classes="muted" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <ItemsControl Grid.Row="1" IsVisible="{Binding AggregateResultsVisible}" ItemsSource="{Binding SearchErrors}" MaxHeight="70" />
      <Button Grid.Row="2" IsVisible="{Binding !AggregateResultsVisible}" Content="加载更多" Command="{Binding LoadMoreCommand}" HorizontalAlignment="Center" />
    </Grid>
  </Grid>
</UserControl>
