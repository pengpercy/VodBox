<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:VodBox.Desktop"
 x:Class="VodBox.Desktop.Views.CollectionCardView" x:DataType="vm:CollectionCard" x:CompileBindings="True">
 <Button x:Name="CardButton" HorizontalAlignment="Stretch" Click="OpenClick" Padding="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Background="{DynamicResource CardSurfaceBrush}" CornerRadius="8" BorderThickness="0">
  <Grid x:Name="CardLayout" RowDefinitions="Auto,Auto" ColumnDefinitions="*">
   <Border x:Name="Artwork" Height="240" CornerRadius="8" ClipToBounds="True">
    <Grid>
     <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center" Classes="muted" />
     <Image x:Name="PosterImage" Source="{Binding Card.Poster}" Stretch="UniformToFill" />
     <Border Background="#C0FFF8F0" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="8,4" CornerRadius="0,0,6,0"><TextBlock Text="{Binding SourceName}" Foreground="#783B36" FontSize="12" MaxWidth="170" TextTrimming="CharacterEllipsis" /></Border>
     <Border x:Name="HistoryCaption" Background="#C0FFF8F0" HorizontalAlignment="Left" VerticalAlignment="Bottom" Padding="8,4" CornerRadius="0,6,0,0"><TextBlock Text="{Binding Caption}" Foreground="#383C44" FontSize="12" TextTrimming="CharacterEllipsis" /></Border>
    </Grid>
   </Border>
   <Grid x:Name="CardText" Grid.Row="1" Margin="12,10" RowDefinitions="Auto,*,Auto" RowSpacing="6">
    <TextBlock x:Name="CardTitle" Text="{Binding Title}" FontSize="16" TextTrimming="CharacterEllipsis" />
    <TextBlock x:Name="CardCaption" Grid.Row="2" Text="{Binding Caption}" FontSize="12" Classes="muted" TextTrimming="CharacterEllipsis" />
   </Grid>
  </Grid>
 </Button>
</UserControl>
