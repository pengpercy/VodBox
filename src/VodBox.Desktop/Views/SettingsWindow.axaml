<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VodBox.Desktop.ViewModels"
        xmlns:views="clr-namespace:VodBox.Desktop.Views"
        xmlns:chrome="clr-namespace:Avalonia.Controls.Chrome;assembly=Avalonia.Controls"
        xmlns:settings="clr-namespace:VodBox.Desktop.Views.Settings"
        x:Class="VodBox.Desktop.Views.SettingsWindow" x:DataType="vm:SettingsWindowViewModel"
        Title="设置 — VodBox" Icon="/Assets/Icons/linux/256/vodbox.png"
        Width="940" Height="680" MinWidth="760" MaxWidth="1000" MinHeight="560" MaxHeight="1000"
        TransparencyLevelHint="Mica,AcrylicBlur,Blur"
        TransparencyBackgroundFallback="{DynamicResource PageBackgroundBrush}"
        Background="Transparent"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="44"
        WindowDecorations="Full"
        WindowStartupLocation="CenterOwner"
        FontSize="13">

  <Window.Styles>
    <!-- 卡片容器：圆角 8 / CardBrush / 极淡描边（设计规格 §4.3） -->
    <Style Selector="Border.card">
      <Setter Property="CornerRadius" Value="{DynamicResource AppPanelCornerRadius}" />
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <!-- 分组标题：12 SemiBold TextTertiary（设计规格 §4.2） -->
    <Style Selector="TextBlock.groupTitle">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
      <Setter Property="Margin" Value="4,0,0,0" />
    </Style>
    <!-- 行标题 / 副标题（设计规格 §4.4） -->
    <Style Selector="TextBlock.rowTitle">
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.rowSubtitle">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="MaxWidth" Value="420" />
      <Setter Property="Margin" Value="0,3,0,0" />
    </Style>
    <!-- 行间分隔线：1px StrokeBrush，左缩进 46（16 padding + 18 图标 + 12 gap） -->
    <Style Selector="Border.rowSep">
      <Setter Property="Height" Value="1" />
      <Setter Property="Margin" Value="46,0,0,0" />
      <Setter Property="Background" Value="{DynamicResource StrokeBrush}" />
    </Style>
    <!-- 主按钮 / 次按钮 / 危险按钮（设计规格 §4.5 1~3） -->
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource AccentStrongBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource AppControlCornerRadius}" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource AppControlCornerRadius}" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <!-- 缩略图单选：内容即缩略图，隐藏默认圆点（设计规格 §4.5 7） -->
    <Style Selector="Border.thumb">
      <Setter Property="Width" Value="96" />
      <Setter Property="Height" Value="60" />
      <Setter Property="CornerRadius" Value="{DynamicResource AppControlCornerRadius}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    </Style>
    <Style Selector="RadioButton.thumbChoice">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <ControlTemplate><ContentPresenter Content="{TemplateBinding Content}"
            ContentTemplate="{TemplateBinding ContentTemplate}" /></ControlTemplate>
      </Setter>
    </Style>
    <!-- 选中态是「选中值」语义，是这里唯一允许出现蓝色的地方 -->
    <Style Selector="RadioButton.thumbChoice:checked Border.thumb">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
  </Window.Styles>

  <Panel>
    <!-- 左栏半透明着色，让窗口材质透出（对齐 MainWindow.SidebarBackdrop） -->
    <Rectangle Fill="{DynamicResource PageBackgroundBrush}" Opacity="0.40"
               Width="216" HorizontalAlignment="Left" VerticalAlignment="Stretch" IsHitTestVisible="False" />

    <Grid RowDefinitions="44,*" ColumnDefinitions="216,*"
          chrome:WindowDecorationProperties.ElementRole="User">
      <!-- 右栏不透明底，保证卡片与文字可读（对齐 MainWindow.PageBackdrop） -->
      <Rectangle Grid.RowSpan="2" Grid.Column="1" Fill="{DynamicResource PageBackgroundBrush}" IsHitTestVisible="False" />

      <!-- 标题条：macOS 红黄绿压住左上角，左栏顶部让出 90px -->
      <Border Grid.Row="0" Grid.Column="0" Background="Transparent"
              Margin="{OnPlatform Default='0', macOS='90,0,0,0'}"
              chrome:WindowDecorationProperties.ElementRole="TitleBar" />

      <!-- 头部条：只显示当前分区标题，无返回/前进箭头；Windows 右侧让出 140px 给三键 -->
      <Border Grid.Row="0" Grid.Column="1" Background="Transparent"
              Margin="{OnPlatform Default='0,0,140,0', macOS='0'}"
              chrome:WindowDecorationProperties.ElementRole="TitleBar">
        <TextBlock Text="{Binding CurrentTitle}" Padding="28,0,28,0" VerticalAlignment="Center"
                   FontSize="15.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
      </Border>

      <!-- 左栏：导航可滚动，版本卡片钉在底部不随滚动 -->
      <Grid Grid.Row="1" Grid.Column="0" RowDefinitions="*,Auto">
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,4,0,0">
          <StackPanel>
            <views:NavItemView Icon="{StaticResource Icon.Broadcast}" Label="源与订阅"
                               IsSelected="{Binding Sources.IsSelected, Mode=OneWay}" Command="{Binding Sources.SelectCommand}" />
            <views:NavItemView Icon="{StaticResource Icon.Play}" Label="播放"
                               IsSelected="{Binding Playback.IsSelected, Mode=OneWay}" Command="{Binding Playback.SelectCommand}" />
            <views:NavItemView Icon="{StaticResource Icon.Danmaku}" Label="弹幕"
                               IsSelected="{Binding Danmaku.IsSelected, Mode=OneWay}" Command="{Binding Danmaku.SelectCommand}" />
            <views:NavItemView Icon="{StaticResource Icon.Subtitles}" Label="字幕"
                               IsSelected="{Binding Subtitles.IsSelected, Mode=OneWay}" Command="{Binding Subtitles.SelectCommand}" />

            <!-- 组 B：组间额外 12px 留白 -->
            <views:NavItemView Icon="{StaticResource Icon.ViewGrid}" Label="界面" Margin="0,12,0,0"
                               IsSelected="{Binding Interface.IsSelected, Mode=OneWay}" Command="{Binding Interface.SelectCommand}" />
            <views:NavItemView Icon="{StaticResource Icon.ContentSave}" Label="数据"
                               IsSelected="{Binding Data.IsSelected, Mode=OneWay}" Command="{Binding Data.SelectCommand}" />
            <views:NavItemView Icon="{StaticResource Icon.Cellphone}" Label="推送与遥控"
                               IsSelected="{Binding Remote.IsSelected, Mode=OneWay}" Command="{Binding Remote.SelectCommand}" />

            <!-- 组 C -->
            <views:NavItemView Icon="{StaticResource Icon.History}" Label="诊断" Margin="0,12,0,0"
                               IsSelected="{Binding Diagnostics.IsSelected, Mode=OneWay}" Command="{Binding Diagnostics.SelectCommand}" />
            <views:NavItemView Icon="{StaticResource Icon.Information}" Label="关于"
                               IsSelected="{Binding About.IsSelected, Mode=OneWay}" Command="{Binding About.SelectCommand}" />
          </StackPanel>
        </ScrollViewer>

        <!-- 版本卡片：静态文案，不含更新渠道判断 -->
        <Border Grid.Row="1" Margin="8,8,8,10" Padding="12,10"
                CornerRadius="{DynamicResource AppControlCornerRadius}"
                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
          <StackPanel Spacing="6">
            <TextBlock Text="VodBox" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="{Binding AppVersion, StringFormat='版本 {0}'}" FontSize="11"
                       Foreground="{DynamicResource TextTertiaryBrush}" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- 右栏内容：每个分区是一个独立 UserControl，DataContext 指向 SettingsViewModel；
           可见性由左栏选中项驱动。
           容器必须 Stretch + MaxWidth（不能用 Left）：Left 会让容器收缩到当前分区内容的宽度，
           导致各分区的卡片宽度互不相同；Stretch 下宽度恒为 min(可用宽度, 720)。 -->
      <ScrollViewer Grid.Row="1" Grid.Column="1" Padding="28,20,28,32" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Left">
        <StackPanel MaxWidth="720" HorizontalAlignment="Stretch">
          <settings:SourcesSettingsView IsVisible="{Binding $parent[Window].((vm:SettingsWindowViewModel)DataContext).Sources.IsSelected}" DataContext="{Binding Content}" />
          <settings:PlaybackSettingsView IsVisible="{Binding $parent[Window].((vm:SettingsWindowViewModel)DataContext).Playback.IsSelected}" DataContext="{Binding Content}" />
          <settings:PlaybackSettingsView IsVisible="{Binding $parent[Window].((vm:SettingsWindowViewModel)DataContext).Danmaku.IsSelected}" DataContext="{Binding Content}" Section="Danmaku" />
          <settings:PlaybackSettingsView IsVisible="{Binding $parent[Window].((vm:SettingsWindowViewModel)DataContext).Subtitles.IsSelected}" DataContext="{Binding Content}" Section="Subtitles" />
          <settings:InterfaceDataSettingsView IsVisible="{Binding $parent[Window].((vm:SettingsWindowViewModel)DataContext).Interface.IsSelected}" DataContext="{Binding Content}" Section="Interface" />
          <settings:InterfaceDataSettingsView IsVisible="{Binding $parent[Window].((vm:SettingsWindowViewModel)DataContext).Data.IsSelected}" DataContext="{Binding Content}" Section="Data" />
          <settings:RemoteDiagnosticsSettingsView IsVisible="{Binding $parent[Window].((vm:SettingsWindowViewModel)DataContext).Remote.IsSelected}" DataContext="{Binding Content}" Section="Remote" />
          <settings:RemoteDiagnosticsSettingsView IsVisible="{Binding $parent[Window].((vm:SettingsWindowViewModel)DataContext).Diagnostics.IsSelected}" DataContext="{Binding Content}" Section="Diagnostics" />
          <settings:AboutSettingsView IsVisible="{Binding $parent[Window].((vm:SettingsWindowViewModel)DataContext).About.IsSelected}" DataContext="{Binding Content}" />
        </StackPanel>
      </ScrollViewer>

      <!-- 状态提示固定在右下角：Message 是所有分区共用的反馈（清缓存、开关遥控、字幕搜索、壁纸…），
           放在窗口层而非某个分区里，否则只有「源与订阅」能看到反馈。 -->
      <Border Grid.Row="1" Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Left"
              Margin="28,0,28,16" Padding="14,8" MaxWidth="720"
              CornerRadius="{DynamicResource AppControlCornerRadius}"
              Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
              IsVisible="{Binding Content.Message, Converter={x:Static views:StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Text="{Binding Content.Message}" FontSize="12.5"
                   Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" />
      </Border>

      <!-- 分隔线：贯穿整个客户区（含 44px 标题条） -->
      <Border Grid.RowSpan="2" Grid.Column="0" Width="1" HorizontalAlignment="Right"
              Background="{DynamicResource StrokeBrush}" IsHitTestVisible="False" />
    </Grid>

    <!-- 更改点播配置弹窗（覆盖整个窗口，含左栏）：DataContext 是 SettingsWindowViewModel，
         所以一律经 Content. 前缀绑定到 SettingsViewModel 上的属性/命令 -->
    <Panel IsVisible="{Binding Content.ConfigDialogOpen}">
      <Rectangle Fill="#88000000" />
      <Border Width="560" CornerRadius="{DynamicResource AppPosterCornerRadius}" Background="{DynamicResource SurfaceBrush}" BorderBrush="#26FFFFFF" BorderThickness="1"
              VerticalAlignment="Center" HorizontalAlignment="Center" ClipToBounds="True">
        <Grid RowDefinitions="Auto,*,Auto">
          <!-- 弹窗头 -->
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="20,16,16,10">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{StaticResource Icon.Broadcast}" Width="24" Height="24" VerticalAlignment="Center" />
              <TextBlock Text="更改点播配置" FontSize="15.5" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <Button Grid.Column="1" Command="{Binding Content.CancelConfigDialogCommand}" ToolTip.Tip="关闭"
                    Background="Transparent" Foreground="{DynamicResource TextTertiaryBrush}" BorderThickness="0" CornerRadius="{DynamicResource AppControlCornerRadius}"
                    Width="28" Height="28" Padding="0" FontSize="13" Cursor="Hand">
              <PathIcon Data="{StaticResource Icon.Close}" Width="18" Height="18" />
            </Button>
          </Grid>
          <!-- 弹窗体 -->
          <StackPanel Grid.Row="1" Margin="20,4,20,12" Spacing="12">
            <TextBlock Text="输入 TVBox 配置地址，或从剪贴板读取" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Grid.Column="0" Text="{Binding Content.DialogUrl}" Height="34" CornerRadius="{DynamicResource AppControlCornerRadius}"
                       PlaceholderText="https://…/tvbox.json" />
              <Button Grid.Column="1" Command="{Binding Content.PasteFromClipboardCommand}"
                      CornerRadius="{DynamicResource AppControlCornerRadius}" Padding="12,6" Background="{DynamicResource CardHoverBrush}" Foreground="{DynamicResource TextSecondaryBrush}"
                      BorderThickness="0" Margin="8,0,0,0" FontSize="12" Cursor="Hand">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource Icon.Clipboard}" Width="18" Height="18" VerticalAlignment="Center" />
                  <TextBlock Text="粘贴" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </Grid>

            <TextBlock Text="历史配置" FontSize="12" Margin="0,4,0,0" />
            <Border CornerRadius="{DynamicResource AppPanelCornerRadius}" BorderBrush="#1FFFFFFF" BorderThickness="1" MaxHeight="170">
              <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Content.ConfigHistory}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="*,Auto,Auto" Margin="12,8" Background="#0AFFFFFF">
                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis"
                                   MaxWidth="300" VerticalAlignment="Center" />
                        <Border Grid.Column="1" CornerRadius="5" BorderBrush="#4CC2FF" BorderThickness="1"
                                Padding="7,1" VerticalAlignment="Center" Margin="0,0,8,0"
                                IsVisible="{Binding Current}">
                          <TextBlock Text="使用中" FontSize="10" Foreground="#4CC2FF" />
                        </Border>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                          <Button Content="切换" Command="{Binding $parent[views:SettingsWindow].((vm:SettingsWindowViewModel)DataContext).Content.SwitchConfigCommand}"
                                  CommandParameter="{Binding}" Background="{DynamicResource CardHoverBrush}" Foreground="{DynamicResource TextSecondaryBrush}"
                                  BorderThickness="0" CornerRadius="{DynamicResource AppControlCornerRadius}" Padding="10,4" FontSize="11.5" Cursor="Hand" />
                          <Button Content="删除" Foreground="#FF6B6B" Background="Transparent" BorderThickness="0"
                                  CommandParameter="{Binding}" Command="{Binding $parent[views:SettingsWindow].((vm:SettingsWindowViewModel)DataContext).Content.DeleteConfigCommand}"
                                  CornerRadius="{DynamicResource AppControlCornerRadius}" Padding="10,4" FontSize="11.5" Cursor="Hand" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Border>
          </StackPanel>
          <!-- 弹窗脚 -->
          <Border Grid.Row="2" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Button Grid.Column="0" Command="{Binding Content.OpenRemoteSettingsCommand}" Background="{DynamicResource CardHoverBrush}" Foreground="{DynamicResource TextSecondaryBrush}"
                      BorderThickness="0" CornerRadius="{DynamicResource AppControlCornerRadius}" Padding="12,7" FontSize="12" Cursor="Hand">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource Icon.Cellphone}" Width="18" Height="18" VerticalAlignment="Center" />
                  <TextBlock Text="手机扫码推送" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button Content="取消" Command="{Binding Content.CancelConfigDialogCommand}" Background="{DynamicResource CardHoverBrush}"
                        Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" CornerRadius="{DynamicResource AppControlCornerRadius}" Padding="16,7" FontSize="12.5" Cursor="Hand" />
                <Button Content="确定加载" Command="{Binding Content.ConfirmConfigDialogCommand}"
                        Background="#0078D4" Foreground="White" BorderThickness="0" CornerRadius="{DynamicResource AppControlCornerRadius}"
                        Padding="16,7" FontSize="12.5" FontWeight="SemiBold" Cursor="Hand" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </Border>
    </Panel>
  </Panel>
</Window>
