<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VodBox.Desktop.ViewModels"
             xmlns:design="clr-namespace:VodBox.Desktop.Design"
             x:Class="VodBox.Desktop.Views.SearchView" x:DataType="vm:MainViewModel">
  <Design.DataContext>
    <x:Static Member="design:DesignData.Main" />
  </Design.DataContext>
  <ScrollViewer Padding="28,16,28,28">
    <StackPanel Spacing="20" DataContext="{Binding Search}">

      <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center" Margin="0,10,0,0">
        <TextBlock Text="🔍" FontSize="18" VerticalAlignment="Center" />
        <TextBox Text="{Binding Keyword}" Watermark="搜索影片、剧集、综艺…" Width="480" Height="42"
                 CornerRadius="21" FontSize="14" VerticalContentAlignment="Center" KeyDown="OnSearchKeyDown" />
        <Button Content="搜索 ⏎" Command="{Binding RunSearchCommand}" Click="OnSearchClick"
                CornerRadius="18" Padding="16,8" Background="#0078D4" Foreground="White"
                BorderThickness="0" FontSize="13" Cursor="Hand" />
      </StackPanel>

      <TextBlock Text="{Binding Summary}" FontSize="13" Foreground="#85FFFFFF" />

      <Grid ColumnDefinitions="200,20,*">
        <Border Grid.Column="0" CornerRadius="8" Background="#0FFFFFFF" BorderBrush="#17FFFFFF"
                BorderThickness="1" Padding="8">
          <ListBox ItemsSource="{Binding SiteResults}" Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,4">
                  <TextBlock Text="{Binding SiteName}" FontSize="13" />
                  <TextBlock Text="{Binding Items.Count}" FontSize="11" Foreground="#85FFFFFF"
                             VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>

        <ItemsControl Grid.Column="2" ItemsSource="{Binding AllResults}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="5" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,0,18,18" Cursor="Hand" PointerPressed="OnOpenItem" Tag="{Binding}">
                <Border CornerRadius="8" Height="216" Background="#274064" ClipToBounds="True">
                  <Panel>
                    <TextBlock Text="🎬" FontSize="32" Opacity="0.25" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Border Background="#66000000" CornerRadius="5" Padding="7,2" HorizontalAlignment="Right"
                            VerticalAlignment="Top" Margin="6">
                      <TextBlock Text="{Binding Remarks}" FontSize="10.5" Foreground="#4CC2FF" TextTrimming="CharacterEllipsis" MaxWidth="90" />
                    </Border>
                  </Panel>
                </Border>
                <TextBlock Text="{Binding Title}" FontSize="13" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                <TextBlock FontSize="11" Foreground="#85FFFFFF" Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                  <Run Text="{Binding Year}" /><Run Text=" · " /><Run Text="{Binding Area}" />
                </TextBlock>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
