<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VodBox.Desktop.ViewModels"
             xmlns:design="clr-namespace:VodBox.Desktop.Design"
             xmlns:views="clr-namespace:VodBox.Desktop.Views"
             xmlns:core="clr-namespace:VodBox.Core;assembly=VodBox.Core"
             xmlns:chrome="clr-namespace:Avalonia.Controls.Chrome;assembly=Avalonia.Controls"
             x:Class="VodBox.Desktop.Views.SearchView" x:DataType="vm:MainViewModel">
  <Design.DataContext>
    <x:Static Member="design:DesignData.MainForDesign" />
  </Design.DataContext>
  <UserControl.Styles>
    <!-- 侧栏行：全部 / 站点共用一套样式，选中只用浅底 + 加粗，不用主题色大块高亮。 -->
    <Style Selector="Button.siteRow">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="CornerRadius" Value="{DynamicResource AppControlCornerRadius}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.siteRow.selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
    </Style>
    <Style Selector="Button.siteRow.selected TextBlock.siteName">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ListBox.siteList ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,0,2" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource AppControlCornerRadius}" Padding="10,7">
            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="Stretch" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ListBox.siteList ListBoxItem:pointerover"><Setter Property="Background" Value="{DynamicResource CardBrush}" /></Style>
    <Style Selector="ListBox.siteList ListBoxItem:selected"><Setter Property="Background" Value="{DynamicResource CardHoverBrush}" /></Style>
    <Style Selector="ListBox.siteList ListBoxItem:selected TextBlock.siteName"><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <!-- 条数徽标：中性底色，不抢站点名。 -->
    <Style Selector="Border.countPill">
      <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="7,1" />
      <Setter Property="MinWidth" Value="24" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.countPill TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.sectionLabel">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
      <Setter Property="Margin" Value="10,12,10,4" />
    </Style>
    <!-- 结果卡片：悬停时标题加下划线，海报不做位移，避免网格抖动。 -->
    <Style Selector="Border.resultCard:pointerover TextBlock.cardTitle">
      <Setter Property="TextDecorations" Value="Underline" />
    </Style>
    <Style Selector="Border.historyChip:pointerover">
      <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
    </Style>
  </UserControl.Styles>

  <!-- 两栏贯穿整窗：左侧站点栏（无卡片边框）顶部给 macOS 交通灯让位，「全部结果」紧贴交通灯下方；
       一条竖分割线从窗口顶到底分开两栏；右栏第一行是搜索框（紧挨分割线，顶边与「全部结果」对齐，不高过交通灯），下面是结果/详情。
       两栏顶部空白处不设背景，点击落到 SearchWindow 铺在下面的标题栏拖拽区；输入控件标记为 User 保留输入。 -->
  <Grid ColumnDefinitions="Auto,*" DataContext="{Binding Search}">

    <!-- 左：站点栏。始终在位，搜索框位置不随有无结果跳动；无结果时只有「全部结果」一行。 -->
    <Border x:Name="SiteSidebar" Grid.Column="0" Width="220"
            Padding="{OnPlatform Default='10,14,10,12', macOS='10,38,10,12'}" Background="Transparent">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <!-- 「全部」始终在最上，选了某个站点后可一键回到全部结果。 -->
          <Button x:Name="AllSitesButton" Classes="siteRow" Classes.selected="{Binding IsAllSelected}" Click="OnShowAllSites">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="siteName" Text="全部结果" FontSize="13" VerticalAlignment="Center" />
              <Border Grid.Column="1" Classes="countPill"><TextBlock Text="{Binding AllResults.Count}" /></Border>
            </Grid>
          </Button>
          <TextBlock Classes="sectionLabel" Text="站点" IsVisible="{Binding SiteResults.Count, Converter={x:Static views:CountConverters.IsNotZero}}" />
          <ListBox x:Name="SiteList" Classes="siteList" ItemsSource="{Binding SiteResults}" Background="Transparent"
                   BorderThickness="0" Padding="0" SelectionChanged="OnSiteChanged">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SearchSiteResult">
                <Grid ColumnDefinitions="*,Auto" ToolTip.Tip="{Binding SiteName}">
                  <TextBlock Classes="siteName" Text="{Binding SiteName}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <Border Grid.Column="1" Classes="countPill" Margin="8,0,0,0"><TextBlock Text="{Binding Items.Count}" /></Border>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <!-- 失败/超时/插件不受支持的站点单独一组，原因放悬停提示，不再挤在汇总行里。 -->
          <StackPanel IsVisible="{Binding HasFailures}">
            <TextBlock Classes="sectionLabel" Text="{Binding Failures.Count, StringFormat='未返回结果 · {0}'}" />
            <ItemsControl x:Name="FailedSites" ItemsSource="{Binding Failures}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SearchFailure">
                  <TextBlock Text="{Binding SiteName}" ToolTip.Tip="{Binding Error}" FontSize="12" Margin="10,4"
                             Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>
    <!-- 贯穿整窗高度的分割线（在站点栏右沿）。 -->
    <Border x:Name="SidebarDivider" Grid.Column="0" Width="1" HorizontalAlignment="Right" VerticalAlignment="Stretch"
            Background="{DynamicResource StrokeBrush}" IsHitTestVisible="False" />

    <Grid Grid.Column="1" RowDefinitions="Auto,*">
      <!-- 右栏第一行：搜索框（按钮内嵌，交互区标记为 User）+ 状态（进度 / 站点数与条数）；
           顶边与左栏「全部结果」一行对齐，同在交通灯下方。 -->
      <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="16"
                  Margin="{OnPlatform Default='20,14,0,0', macOS='20,38,0,0'}">
        <Grid x:Name="SearchField" Width="380" Height="32" chrome:WindowDecorationProperties.ElementRole="User">
          <TextBox x:Name="ResultSearch" Text="{Binding Keyword}" PlaceholderText="搜索影片、剧集、综艺…" Height="32"
                   CornerRadius="{DynamicResource AppControlCornerRadius}" FontSize="13" Padding="32,0,74,0"
                   VerticalContentAlignment="Center" KeyDown="OnSearchKeyDown"
                   chrome:WindowDecorationProperties.ElementRole="User" />
          <PathIcon x:Name="ResultSearchIcon" Data="{StaticResource Icon.Search}" Width="14" Height="14" Margin="11,0,0,0"
                    HorizontalAlignment="Left" VerticalAlignment="Center" Opacity="0.6" IsHitTestVisible="False" />
          <Button x:Name="ResultSearchButton" Command="{Binding RunSearchCommand}" Classes="accent" Content="搜索"
                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0" Height="26" Padding="14,0"
                  VerticalContentAlignment="Center" CornerRadius="{DynamicResource AppControlCornerRadius}"
                  FontSize="12" FontWeight="SemiBold" Cursor="Hand" chrome:WindowDecorationProperties.ElementRole="User" />
          <views:SearchHistoryPopup x:Name="ResultSearchHistory" TargetBox="{Binding #ResultSearch}"
                                    History="{Binding $parent[views:SearchView].((vm:MainViewModel)DataContext).Search}" Picked="OnSearchHistoryPicked" />
        </Grid>
        <TextBlock x:Name="SearchStatus" Text="{Binding Status}" FontSize="12" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextTertiaryBrush}" ToolTip.Tip="{Binding Summary}" />
        <ProgressBar IsVisible="{Binding Searching}" Value="{Binding Progress}" Minimum="0" Maximum="1"
                     Width="100" Height="3" MinHeight="3" CornerRadius="2" VerticalAlignment="Center" />
      </StackPanel>

      <!-- 结果区在看详情时只隐藏不销毁：返回后仍是原来的结果、选中站点与滚动位置。 -->
      <Panel Grid.Row="1" Margin="20,16,0,0" IsVisible="{Binding !ShowingDetail}">
        <!-- 结果网格：按行分块，ListBox 垂直虚拟化；卡片按列数平分宽度铺满。
             加载态与结果同格叠加：搜索中显示骨架，结束显示空态/失败文案，都不留白屏。 -->
        <ListBox x:Name="ResultsList" Classes="virtualRows" SizeChanged="OnResultsSizeChanged" ItemsSource="{Binding ResultRows}" Background="Transparent"
                 BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ResultRow">
              <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="core:MediaItem">
                    <Border Classes="resultCard" Background="Transparent" Cursor="Hand" PointerPressed="OnOpenItem" Tag="{Binding}"
                            Width="{Binding $parent[views:SearchView].((vm:MainViewModel)DataContext).Search.CardWidth}" Margin="0,0,18,22">
                      <StackPanel>
                        <Border CornerRadius="{DynamicResource AppPosterCornerRadius}" Background="{DynamicResource CardHoverBrush}" ClipToBounds="True"
                                Height="{Binding $parent[views:SearchView].((vm:MainViewModel)DataContext).Search.PosterHeight}">
                          <Panel>
                            <PathIcon Data="{StaticResource Icon.Movie}" Width="48" Height="48" Opacity="0.2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <views:RemotePoster Url="{Binding Poster}" />
                            <!-- 更新/清晰度角标：只在有内容时出现，左下角中性底色。 -->
                            <Border Background="#99000000" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6"
                                    IsVisible="{Binding Remarks, Converter={x:Static views:StringConverters.IsNotNullOrEmpty}}">
                              <TextBlock Text="{Binding Remarks}" FontSize="10.5" Foreground="{DynamicResource PosterBadgeTextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="120" />
                            </Border>
                          </Panel>
                        </Border>
                        <TextBlock Classes="cardTitle" Text="{Binding Title}" ToolTip.Tip="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                   Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Converter={x:Static views:MediaConverters.Meta}}" FontSize="11.5" Margin="0,3,0,0"
                                   Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis"
                                   IsVisible="{Binding $self.Text, Converter={x:Static views:StringConverters.IsNotNullOrEmpty}}" />
                        <!-- 来源只在「全部结果」里显示：单站视图里每张都一样，属于噪音。 -->
                        <TextBlock Classes="cardSource" Text="{Binding SourceName}" FontSize="11" Margin="0,3,0,0"
                                   Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis">
                          <TextBlock.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                              <Binding Path="$parent[views:SearchView].((vm:MainViewModel)DataContext).Search.IsAllSelected" />
                              <Binding Path="SourceName" Converter="{x:Static views:StringConverters.IsNotNullOrEmpty}" />
                            </MultiBinding>
                          </TextBlock.IsVisible>
                        </TextBlock>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <!-- 搜索中骨架：与结果卡片同宽同比例，清空旧结果后不出现空白区 -->
        <ScrollViewer IsVisible="{Binding ShowSkeleton}" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{x:Static views:SkeletonData.Cards}" IsVisible="{Binding ShowSkeleton}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Width="{Binding $parent[views:SearchView].((vm:MainViewModel)DataContext).Search.CardWidth}" Margin="0,0,18,22">
                  <Border Classes="skeleton poster" Height="{Binding $parent[views:SearchView].((vm:MainViewModel)DataContext).Search.PosterHeight}" />
                  <Border Classes="skeleton" Height="13" Width="112" Margin="0,8,0,0" HorizontalAlignment="Left" />
                  <Border Classes="skeleton" Height="11" Width="78" Margin="0,4,0,0" HorizontalAlignment="Left" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <!-- 空态：尚未搜索 / 没有结果 / 搜索失败；有历史时列出最近搜索，点击回搜。 -->
        <StackPanel x:Name="EmptyState" IsVisible="{Binding ShowEmpty}" Spacing="14" Margin="0,48,24,0" MaxWidth="460"
                    HorizontalAlignment="Center" VerticalAlignment="Top">
          <PathIcon Data="{StaticResource Icon.Search}" Width="48" Height="48" Opacity="0.25" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding Hint}"
                     IsVisible="{Binding Hint, Converter={x:Static views:StringConverters.IsNotNullOrEmpty}}"
                     FontSize="13" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
          <TextBlock Text="输入关键词，在订阅的所有站点中搜索"
                     IsVisible="{Binding Hint, Converter={x:Static views:StringConverters.IsNullOrEmpty}}"
                     FontSize="13" TextAlignment="Center" HorizontalAlignment="Center"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
          <StackPanel IsVisible="{Binding ShowHistory}" Spacing="10" Margin="0,10,0,0">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="最近搜索" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
              <Button Grid.Column="1" Content="清空" Command="{Binding ClearSearchHistoryCommand}" Background="Transparent" BorderThickness="0"
                      Padding="6,2" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" Cursor="Hand" />
            </Grid>
            <ItemsControl x:Name="HistoryChips" ItemsSource="{Binding SearchHistory}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel ItemSpacing="8" LineSpacing="8" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <Border Classes="historyChip" CornerRadius="14" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource StrokeBrush}"
                          BorderThickness="1" Padding="12,4,4,4" Cursor="Hand" PointerPressed="OnPickHistory" Tag="{Binding}">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                      <TextBlock Text="{Binding}" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <Button Click="OnDeleteHistory" Tag="{Binding}" Padding="4" Background="Transparent" BorderThickness="0"
                              CornerRadius="10" Opacity="0.6" ToolTip.Tip="删除搜索词" VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource Icon.Close}" Width="12" Height="12" />
                      </Button>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </Panel>

      <!-- 影片详情：在本窗口内打开（主窗口不跳页），返回按钮或 Esc 回到结果。独立的 DetailViewModel，不影响主窗口的详情页。 -->
      <Grid x:Name="DetailHost" Grid.Row="1" Margin="0,8,0,0" RowDefinitions="Auto,*" IsVisible="{Binding ShowingDetail}">
        <Button x:Name="BackToResults" Command="{Binding CloseDetailCommand}" HorizontalAlignment="Left" Margin="18,0,0,0"
                Padding="8,5,12,5" Background="Transparent" BorderThickness="0" Cursor="Hand"
                CornerRadius="{DynamicResource AppControlCornerRadius}" ToolTip.Tip="返回搜索结果（Esc）">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Data="{StaticResource Icon.ChevronLeft}" Width="14" Height="14" VerticalAlignment="Center" />
            <TextBlock Text="返回搜索结果" FontSize="13" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <views:DetailView Grid.Row="1" DataContext="{Binding Detail}" />
      </Grid>

    </Grid>
  </Grid>
</UserControl>
