<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VodBox.Desktop.ViewModels"
             xmlns:design="clr-namespace:VodBox.Desktop.Design"
             xmlns:views="clr-namespace:VodBox.Desktop.Views"
             x:Class="VodBox.Desktop.Views.SearchView" x:DataType="vm:MainViewModel">
  <Design.DataContext>
    <x:Static Member="design:DesignData.MainForDesign" />
  </Design.DataContext>

  <!-- 两行布局：搜索区固定在顶部，结果区独立滚动。
       结果网格用 ListBox（自带 VirtualizingStackPanel）按行分块渲染——
       数据量大时只实例化可见行，不再全量铺开（性能关键）。 -->
  <Grid RowDefinitions="Auto,*" Margin="0,4,0,0" DataContext="{Binding Search}">

    <!-- 上：搜索框 + 联想 + 汇总行 -->
    <StackPanel Grid.Row="0" Spacing="10" Margin="28,0,28,0">
      <StackPanel Spacing="10" HorizontalAlignment="Center" Margin="0" MaxWidth="440">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Grid Width="340" Height="34">
            <TextBox x:Name="ResultSearch" Text="{Binding Keyword}" PlaceholderText="搜索影片、剧集、综艺…" Height="34"
                     CornerRadius="{DynamicResource AppControlCornerRadius}" FontSize="13" Padding="30,0,10,0"
                     VerticalContentAlignment="Center" KeyDown="OnSearchKeyDown" />
            <PathIcon x:Name="ResultSearchIcon" Data="{StaticResource Icon.Search}" Width="14" Height="14" Margin="10,0,0,0"
                      HorizontalAlignment="Left" VerticalAlignment="Center" Opacity="0.6" IsHitTestVisible="False" />
          </Grid>
          <Button Command="{Binding RunSearchCommand}"
                  CornerRadius="{DynamicResource AppControlCornerRadius}" Padding="12,5" Height="34" Background="#0078D4" Foreground="White"
                  BorderThickness="0" FontSize="12.5" FontWeight="SemiBold" Cursor="Hand">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource Icon.Search}" Width="18" Height="18" VerticalAlignment="Center" />
              <TextBlock Text="搜索" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>

        <!-- 联想列表（热词带火焰图标） -->
        <Border CornerRadius="{DynamicResource AppPosterCornerRadius}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                IsVisible="{Binding ShowSuggestions}" ClipToBounds="True">
          <ItemsControl ItemsSource="{Binding Suggestions}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="14,9" Cursor="Hand"
                            PointerPressed="OnPickSuggestion" Tag="{Binding}">
                  <TextBlock Text="{Binding Text}" FontSize="13" />
                  <Border CornerRadius="4" Background="#33FFB900" Padding="6,1" IsVisible="{Binding Hot}">
                    <StackPanel Orientation="Horizontal" Spacing="3" TextElement.Foreground="#FFB900">
                      <PathIcon Data="{StaticResource Icon.Fire}" Width="12" Height="12" VerticalAlignment="Center" />
                      <TextBlock Text="热" FontSize="10" VerticalAlignment="Center" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
      </StackPanel>

      <!-- 结果说明 + 搜索历史 -->
      <Grid ColumnDefinitions="*,Auto" MinHeight="24">
        <TextBlock Grid.Column="0" Text="{Binding Summary}" FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}"
                   VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock Text="搜索历史：" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
          <ItemsControl ItemsSource="{Binding SearchHistory}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border CornerRadius="{DynamicResource AppPanelCornerRadius}" Background="{DynamicResource CardHoverBrush}" Padding="10,4" Cursor="Hand"
                        PointerPressed="OnPickHistory" Tag="{Binding}">
                  <StackPanel Orientation="Horizontal" Spacing="4" TextElement.Foreground="{DynamicResource TextSecondaryBrush}">
                    <TextBlock Text="{Binding Mode=OneWay}" FontSize="11.5" VerticalAlignment="Center" />
                    <Button Click="OnDeleteHistory" Tag="{Binding}" Padding="2" Background="Transparent" ToolTip.Tip="删除搜索词">
                      <PathIcon Data="{StaticResource Icon.Close}" Width="12" Height="12" />
                    </Button>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Grid>
    </StackPanel>

    <!-- 下：站点列表 + 虚拟化结果网格 -->
    <Grid Grid.Row="1" ColumnDefinitions="190,20,*" Margin="28,8,0,0">
      <Border Grid.Column="0" CornerRadius="{DynamicResource AppPanelCornerRadius}" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource StrokeBrush}"
              BorderThickness="1" Padding="6">
        <ListBox ItemsSource="{Binding SiteResults}" Background="Transparent" BorderThickness="0"
                 SelectionChanged="OnSiteChanged">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,6" Cursor="Hand">
                <TextBlock Text="{Binding SiteName}" FontSize="13" />
                <StackPanel Orientation="Horizontal" Spacing="8" TextElement.Foreground="#4CC2FF" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Items.Count}" FontSize="11.5"
                             VerticalAlignment="Center" FontWeight="SemiBold" />
                  <PathIcon Data="{StaticResource Icon.Refresh}" Width="18" Height="18" VerticalAlignment="Center"
                            IsVisible="{Binding Loading}" />
                </StackPanel>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <!-- 结果网格：按行分块（ResultRowVM.Items = 5 张卡），ListBox 垂直虚拟化。
           加载态与结果同格叠加：搜索中显示骨架，结束显示空态/失败文案，都不留白屏。 -->
      <Panel Grid.Column="2">
      <ListBox x:Name="ResultsList" Classes="virtualRows" SizeChanged="OnResultsSizeChanged" ItemsSource="{Binding ResultRows}" Background="Transparent"
               BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <ItemsControl ItemsSource="{Binding Items}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Width="170" Margin="0,0,18,18" Cursor="Hand" PointerPressed="OnOpenItem" Tag="{Binding}">
                    <Border CornerRadius="{DynamicResource AppPosterCornerRadius}" Height="216" Background="#274064" ClipToBounds="True">
                      <Panel>
                        <PathIcon Data="{StaticResource Icon.Movie}" Width="48" Height="48" Opacity="0.25" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <views:RemotePoster Url="{Binding Poster}" />
                        <Border Background="#66000000" CornerRadius="5" Padding="7,2" HorizontalAlignment="Right"
                                VerticalAlignment="Top" Margin="6">
                          <TextBlock Text="{Binding Remarks}" FontSize="10.5" Foreground="#4CC2FF" TextTrimming="CharacterEllipsis" MaxWidth="90" />
                        </Border>
                      </Panel>
                    </Border>
                    <TextBlock Text="{Binding Title}" FontSize="13" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                      <Run Text="{Binding Year}" /><Run Text=" · " /><Run Text="{Binding Area}" />
                    </TextBlock>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- 搜索中骨架：按当前列数铺占位卡，清空旧结果后不出现空白区 -->
      <ScrollViewer IsVisible="{Binding ShowSkeleton}" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{x:Static views:SkeletonData.Cards}" IsVisible="{Binding ShowSkeleton}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Width="170" Margin="0,0,18,18">
              <Border Classes="skeleton poster" Height="216" />
              <Border Classes="skeleton" Height="13" Width="112" Margin="0,8,0,0" HorizontalAlignment="Left" />
              <Border Classes="skeleton" Height="11" Width="78" Margin="0,2,0,0" HorizontalAlignment="Left" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      </ScrollViewer>

      <!-- 空态 / 失败态：非空文案覆盖结果位置 -->
      <TextBlock Text="{Binding Hint}" Margin="0,24,0,0" FontSize="12.5" TextWrapping="Wrap" MaxWidth="420"
                 HorizontalAlignment="Center" VerticalAlignment="Top" TextAlignment="Center"
                 Foreground="{DynamicResource TextTertiaryBrush}"
                 IsVisible="{Binding Hint, Converter={x:Static views:StringConverters.IsNotNullOrEmpty}}" />
      </Panel>
    </Grid>
  </Grid>
</UserControl>
