<UserControl
    xmlns="https://github.com/avaloniaui" xmlns:vm="using:VodBox.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="VodBox.Desktop.Views.EpisodeBrowserView" x:DataType="vm:MainViewModel" x:CompileBindings="True"
    xmlns:core="using:VodBox.Core">
  <Design.DataContext>
    <vm:DesignMainViewModel />
  </Design.DataContext>
  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
      <TextBlock Text="播放线路" VerticalAlignment="Center" />
      <ComboBox Grid.Column="1" ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}" HorizontalAlignment="Stretch">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="core:PlaybackLine">
            <TextBlock Text="{Binding Name}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </Grid>
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <TextBox Text="{Binding EpisodeSearch}" PlaceholderText="搜索集数或标题" />
      <ToggleButton Grid.Column="1" Content="倒序" IsChecked="{Binding ReverseEpisodes}" />
    </Grid>
    <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="4">
      <TextBlock Text="{Binding EpisodeCountText}" Classes="muted" FontSize="12" />
      <ListBox x:Name="EpisodeList" Grid.Row="1" ItemsSource="{Binding VisibleEpisodes}" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="core:Episode">
            <Button Content="{Binding Title}" Click="EpisodeClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,2" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </Grid>
</UserControl>
