<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VodBox.Desktop.ViewModels"
             xmlns:design="clr-namespace:VodBox.Desktop.Design"
             xmlns:views="clr-namespace:VodBox.Desktop.Views"
             x:Class="VodBox.Desktop.Views.HistoryView" x:DataType="vm:MainViewModel">
  <Design.DataContext>
    <x:Static Member="design:DesignData.MainForDesign" />
  </Design.DataContext>
  <ScrollViewer Padding="28,12,28,28">
    <StackPanel Spacing="24" DataContext="{Binding History}">
      <StackPanel Orientation="Horizontal" Spacing="14">
        <TextBlock Text="历史" FontSize="24" FontWeight="SemiBold" />
        <Button Content="🗑 清空全部" Command="{Binding ClearAllCommand}" CornerRadius="7" Padding="12,6"
                Background="#12FFFFFF" Foreground="#FF6B6B" BorderThickness="0" FontSize="12" Cursor="Hand" />
      </StackPanel>

      <ItemsControl ItemsSource="{Binding Entries}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border CornerRadius="8" Background="#0FFFFFFF" BorderBrush="#17FFFFFF" BorderThickness="1"
                    Padding="14" Margin="0,0,0,10" Cursor="Hand" PointerPressed="OnResume" Tag="{Binding}">
              <Grid ColumnDefinitions="110,*,Auto,Auto">
                <Border Grid.Column="0" CornerRadius="6" Height="150" Width="100" Background="#274064"
                        VerticalAlignment="Top" ClipToBounds="True">
                  <TextBlock Text="🎞" FontSize="26" Opacity="0.25" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="6" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding SourceName}" FontSize="12" Foreground="#4CC2FF" />
                  <TextBlock FontSize="11.5" Foreground="#85FFFFFF">
                    <Run Text="看到 " /><Run Text="{Binding PositionMs, Converter={x:Static views:MillisecondConverters.ToTime}, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding DurationMs, Converter={x:Static views:MillisecondConverters.ToTime}, Mode=OneWay}" />
                  </TextBlock>
                  <Border Height="3" CornerRadius="2" Background="#1FFFFFFF" Width="260" HorizontalAlignment="Left" Margin="0,4,0,0">
                    <Border Background="#4CC2FF" Height="3" CornerRadius="2"
                            Width="{Binding PositionMs, ConverterParameter={Binding DurationMs}, Converter={x:Static views:ProgressConverters.Ratio}, Mode=OneWay}" />
                  </Border>
                </StackPanel>
                <Button Grid.Column="2" Content="▶ 续播" Click="OnResumeClick" Tag="{Binding}"
                        Background="#0078D4" Foreground="White" BorderThickness="0" CornerRadius="7"
                        Padding="14,7" VerticalAlignment="Center" Cursor="Hand" />
                <Button Grid.Column="3" Content="✕" Click="OnDelete" Tag="{Binding}"
                        Background="Transparent" Foreground="#85FFFFFF" BorderThickness="0" CornerRadius="7"
                        Width="30" Height="30" VerticalAlignment="Center" Cursor="Hand" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="暂无观看记录" FontSize="12.5" Foreground="#85FFFFFF" HorizontalAlignment="Center"
                 Margin="0,20,0,0" IsVisible="{Binding Entries.Count, Converter={x:Static views:CountConverters.IsZero}}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
