<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VodBox.Desktop.ViewModels"
        xmlns:views="clr-namespace:VodBox.Desktop.Views"
        xmlns:chrome="clr-namespace:Avalonia.Controls.Chrome;assembly=Avalonia.Controls"
        x:Class="VodBox.Desktop.Views.SearchWindow" x:DataType="vm:MainViewModel"
        Title="搜索 — VodBox" Icon="/Assets/Icons/linux/256/vodbox.png"
        Width="1040" Height="720" MinWidth="720" MinHeight="480"
        Background="{DynamicResource PageBackgroundBrush}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="52"
        WindowDecorations="Full"
        WindowStartupLocation="CenterOwner"
        FontSize="13">

  <!-- 独立搜索结果窗口：内容区直接复用 SearchView（与主 VM 绑定，搜索状态唯一）。
       不再显示「搜索」标题：SearchView 第一行与标题栏同高，搜索框紧跟交通灯。
       底下这条透明背景是窗口拖拽区（右侧给 Windows 三键让位），SearchView 里的输入控件标记为 User 角色保留输入。 -->
  <Grid Background="Transparent">
    <Border x:Name="SearchTitleBar" Height="52" VerticalAlignment="Top" Background="Transparent"
            Margin="{OnPlatform Default='0,0,132,0', macOS='0'}"
            chrome:WindowDecorationProperties.ElementRole="TitleBar" />
    <views:SearchView />
  </Grid>
</Window>
