<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VodBox.Desktop.ViewModels"
             xmlns:design="clr-namespace:VodBox.Desktop.Design"
             x:Class="VodBox.Desktop.Views.FilesView" x:DataType="vm:MainViewModel">
  <Design.DataContext>
    <x:Static Member="design:DesignData.Main" />
  </Design.DataContext>
  <Grid RowDefinitions="Auto,*" DataContext="{Binding Files}" Margin="28,12,28,28">
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="14" Margin="0,0,0,14">
      <TextBlock Text="本地文件" FontSize="24" FontWeight="SemiBold" />
      <TextBlock Text="{Binding CurrentPath}" FontSize="12" Foreground="#85FFFFFF" VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis" MaxWidth="600" />
      <TextBlock Text="{Binding Status}" FontSize="12" Foreground="#4CC2FF" VerticalAlignment="Center" />
    </StackPanel>
    <ListBox Grid.Row="1" ItemsSource="{Binding Entries}" Background="Transparent" BorderThickness="0">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Orientation="Horizontal" Spacing="10" Margin="2,4" Cursor="Hand"
                      PointerPressed="OnOpen" Tag="{Binding}">
            <TextBlock Text="{Binding IsDirectory, Mode=OneWay}" Width="20" />
            <TextBlock Text="{Binding Name}" FontSize="13" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>
