<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VodBox.Desktop.ViewModels"
             xmlns:design="clr-namespace:VodBox.Desktop.Design"
             xmlns:views="clr-namespace:VodBox.Desktop.Views"
             x:Class="VodBox.Desktop.Views.FilesView" x:DataType="vm:MainViewModel">
  <Design.DataContext>
    <x:Static Member="design:DesignData.MainForDesign" />
  </Design.DataContext>
  <Grid RowDefinitions="Auto,*" DataContext="{Binding Files}" Margin="28,12,28,28">
    <!-- 标题行：面包屑路径 + 状态（对齐应用整体风格） -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="14" Margin="0,0,0,14">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <PathIcon Data="{StaticResource Icon.Folder}" Width="24" Height="24" VerticalAlignment="Center" />
        <TextBlock Text="本地文件" FontSize="24" FontWeight="SemiBold" />
      </StackPanel>
      <Border CornerRadius="9" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
              Padding="12,5" VerticalAlignment="Center" MaxWidth="560">
        <TextBlock Text="{Binding CurrentPath}" FontSize="12" Foreground="#4CC2FF"
                   TextTrimming="CharacterEllipsis" />
      </Border>
      <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
    </StackPanel>

    <!-- 文件列表：图标 + 名称 + 目录/文件徽标；目录行整行圆角底 -->
    <ListBox Grid.Row="1" ItemsSource="{Binding Entries}" Background="Transparent" BorderThickness="0">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border CornerRadius="7" Padding="10,6" Margin="0,1" Cursor="Hand"
                  Background="#0AFFFFFF" PointerPressed="OnOpen" Tag="{Binding}">
            <Border.ContextMenu>
              <!-- 右键：播放列表可“作为直播源打开”，媒体文件可直接播放；目录给“打开”。 -->
              <ContextMenu>
                <MenuItem Header="播放" Click="OnMenuPlay" Tag="{Binding}" />
                <MenuItem Header="作为直播源打开" Click="OnMenuOpenAsLive" Tag="{Binding}"
                          IsVisible="{Binding $parent[Border].DataContext, Converter={x:Static views:FileMenuConverters.CanOpenAsLive}}" />
                <MenuItem Header="打开" Click="OnMenuOpen" Tag="{Binding}"
                          IsVisible="{Binding IsDirectory}" />
              </ContextMenu>
            </Border.ContextMenu>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <PathIcon Data="{StaticResource Icon.FolderOpen}" Width="18" Height="18" VerticalAlignment="Center"
                        IsVisible="{Binding IsDirectory, Mode=OneWay}" />
              <PathIcon Data="{StaticResource Icon.Movie}" Width="18" Height="18" VerticalAlignment="Center"
                        IsVisible="{Binding IsDirectory, Converter={x:Static BoolConverters.Not}}" />
              <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" MaxWidth="480" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>
