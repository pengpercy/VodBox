<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:VodBox.Core;assembly=VodBox.Core"
             xmlns:views="clr-namespace:VodBox.Desktop.Views"
             xmlns:settings="clr-namespace:VodBox.Desktop.Views.Settings"
             xmlns:vm="clr-namespace:VodBox.Desktop.ViewModels"
             x:Class="VodBox.Desktop.Views.Settings.RemoteDiagnosticsSettingsView" x:DataType="vm:SettingsViewModel">
  <!-- 推送与遥控·诊断：卡片式设置分区。样式见 Resources/SettingsCardStyles.axaml。
       一个 UserControl 承载两个分区，窗口各挂一个实例并用 Section 区分；DataContext 是
       SettingsViewModel，所以分区可见性只能走控件自身的 IsRemote / IsDiagnostics。 -->
  <StackPanel>

    <!-- ===================== 分区：推送与遥控 ===================== -->
    <StackPanel Spacing="24" IsVisible="{Binding $parent[settings:RemoteDiagnosticsSettingsView].IsRemote}">

      <StackPanel Spacing="8">
        <TextBlock Classes="groupTitle" Text="局域网遥控" />
        <Border Classes="card">
          <StackPanel>
            <Border Padding="16,12" MinHeight="60">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <PathIcon Grid.Column="0" Data="{StaticResource Icon.Lock}" Width="18" Height="18"
                          Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Classes="rowTitle" Text="允许可信局域网（需要配对）" VerticalAlignment="Center" />
                <ToggleSwitch Grid.Column="2" IsChecked="{Binding LanControl}" OnContent="" OffContent=""
                              MinWidth="44" VerticalAlignment="Center" Margin="24,0,0,0" />
              </Grid>
            </Border>
            <Border Classes="rowSep" />
            <Border Padding="16,12" MinHeight="60">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <PathIcon Grid.Column="0" Data="{StaticResource Icon.SwapVertical}" Width="18" Height="18"
                          Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Classes="rowTitle" Text="推送媒体使用本机代理" VerticalAlignment="Center" />
                <ToggleSwitch Grid.Column="2" IsChecked="{Binding ProxyPushedMedia}" OnContent="" OffContent=""
                              MinWidth="44" VerticalAlignment="Center" Margin="24,0,0,0" />
              </Grid>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel Spacing="8">
        <TextBlock Classes="groupTitle" Text="配对" />
        <Border Classes="card">
          <StackPanel>
            <Border Padding="16,12" MinHeight="60">
              <Grid ColumnDefinitions="Auto,*">
                <PathIcon Grid.Column="0" Data="{StaticResource Icon.Cellphone}" Width="18" Height="18"
                          Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Classes="rowTitle" Text="配对信息" />
                  <TextBlock Classes="rowSubtitle" Text="{Binding PairingInformation}" />
                </StackPanel>
              </Grid>
            </Border>
            <Border Classes="rowSep" />
            <Border Padding="16,12">
              <Grid ColumnDefinitions="Auto,*">
                <PathIcon Grid.Column="0" Data="{StaticResource Icon.ViewGrid}" Width="18" Height="18"
                          Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,14,0" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1">
                  <TextBlock Classes="rowTitle" Text="配对二维码" />
                  <Image Source="{Binding PairingQrImage}" Width="220" Height="220"
                         HorizontalAlignment="Left" Margin="0,10,0,0" />
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel Spacing="8">
        <TextBlock Classes="groupTitle" Text="遥控操作" />
        <Border Classes="card">
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="16,12">
            <Button Classes="primary" Content="启动本机遥控" Command="{Binding StartLocalControlCommand}" />
            <Button Classes="secondary" Content="关闭本机遥控" Command="{Binding StopLocalControlCommand}" />
            <Button Classes="secondary" Content="打开上传媒体收件箱" Command="{Binding OpenMediaInboxCommand}" />
          </StackPanel>
        </Border>
      </StackPanel>

      <TextBlock Text="上传只接受媒体类型，单文件64 MiB；收件箱最多100项、总计256 MiB。"
                 FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
      <TextBlock Text="默认只监听本机；局域网模式需先停服务再重启，配对码10分钟有效。请仅在可信网络使用。"
                 FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
    </StackPanel>

    <!-- ===================== 分区：诊断 ===================== -->
    <StackPanel Spacing="24" IsVisible="{Binding $parent[settings:RemoteDiagnosticsSettingsView].IsDiagnostics}">

      <TextBlock Text="播放出问题时：打开日志 → 复现一次 → 回到这里点“刷新” → 复制内容发我。日志只记录事件与地址，查询串里的密钥已脱敏。"
                 FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />

      <StackPanel Spacing="8">
        <TextBlock Classes="groupTitle" Text="日志记录" />
        <Border Classes="card">
          <StackPanel>
            <Border Padding="16,12" MinHeight="60">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <PathIcon Grid.Column="0" Data="{StaticResource Icon.History}" Width="18" Height="18"
                          Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Classes="rowTitle" Text="启用日志记录" VerticalAlignment="Center" />
                <ToggleSwitch Grid.Column="2" IsChecked="{Binding LogEnabled}" OnContent="" OffContent=""
                              MinWidth="44" VerticalAlignment="Center" Margin="24,0,0,0" />
              </Grid>
            </Border>
            <Border Classes="rowSep" />
            <Border Padding="16,12" MinHeight="60">
              <Grid ColumnDefinitions="Auto,*">
                <PathIcon Grid.Column="0" Data="{StaticResource Icon.Folder}" Width="18" Height="18"
                          Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Classes="rowTitle" Text="日志目录" />
                  <TextBlock Classes="rowSubtitle" Text="{Binding LogDirectory}" />
                </StackPanel>
              </Grid>
            </Border>
            <Border Classes="rowSep" />
            <Border Padding="16,12" MinHeight="60">
              <Grid ColumnDefinitions="Auto,*">
                <PathIcon Grid.Column="0" Data="{StaticResource Icon.ContentSave}" Width="18" Height="18"
                          Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Classes="rowTitle" Text="当前文件" />
                  <TextBlock Classes="rowSubtitle" Text="{Binding LogFile}" />
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel Spacing="8">
        <TextBlock Classes="groupTitle" Text="日志内容" />
        <Border Classes="card">
          <StackPanel>
            <Border Padding="16,12" MinHeight="60">
              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Button Classes="primary" Content="刷新" Command="{Binding RefreshLogsCommand}" />
                <Button Classes="secondary" Content="打开日志目录" Command="{Binding OpenLogFolderCommand}" />
                <Button Classes="danger" Content="清空日志" Command="{Binding ClearLogsCommand}" />
                <Button Classes="secondary" Content="显示路径" Command="{Binding CopyLogPathCommand}" />
              </StackPanel>
            </Border>
            <Border Classes="rowSep" />
            <Border Padding="16,12">
              <Grid ColumnDefinitions="Auto,*">
                <PathIcon Grid.Column="0" Data="{StaticResource Icon.Information}" Width="18" Height="18"
                          Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding DiagnosticsMessage}" FontSize="11.5"
                           Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
              </Grid>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- 日志尾部预览：保留等宽字体与半透明底 -->
      <Border Background="#0AFFFFFF" CornerRadius="{DynamicResource AppPanelCornerRadius}" Padding="10">
        <TextBox Text="{Binding LogTail}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                 FontFamily="{DynamicResource FontMono}" FontSize="11"
                 MinHeight="240" MaxHeight="360" Background="Transparent" BorderThickness="0" />
      </Border>
    </StackPanel>
  </StackPanel>
</UserControl>
