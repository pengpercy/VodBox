<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VodBox.Desktop.ViewModels"
             x:Class="VodBox.Desktop.Views.Settings.AboutSettingsView" x:DataType="vm:SettingsViewModel">
  <!-- 关于：版本号 / 自动检查更新 / 检查按钮；下载与安装确认由独立更新窗口处理。 -->
  <StackPanel Spacing="24">
    <StackPanel Spacing="10">
      <TextBlock Classes="groupTitle" Text="版本与更新" />
      <Border Classes="card">
        <StackPanel>
          <!-- 版本号 -->
          <Border Padding="16,12" MinHeight="60">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <PathIcon Grid.Column="0" Data="{StaticResource Icon.Information}" Width="18" Height="18"
                        Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Classes="rowTitle" FontSize="11.5" Text="{Binding AppVersion, StringFormat='VodBox {0}'}" />
              </StackPanel>
            </Grid>
          </Border>
          <Border Classes="rowSep" />

          <!-- 启动时自动检查更新 -->
          <Border Padding="16,12" MinHeight="60">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <PathIcon Grid.Column="0" Data="{StaticResource Icon.Refresh}" Width="18" Height="18"
                        Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Classes="rowTitle" Text="启动时自动检查更新" />
              </StackPanel>
              <CheckBox Grid.Column="2" IsChecked="{Binding AutoCheckUpdates}" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <Border Classes="rowSep" />

          <!-- 自动下载并安装：后台下载，退出时安装 -->
          <Border Padding="16,12" MinHeight="60">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <PathIcon Grid.Column="0" Data="{StaticResource Icon.Download}" Width="18" Height="18"
                        Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Classes="rowTitle" Text="自动下载并安装更新" />
                <TextBlock Classes="rowSubtitle" Text="发现新版本时在后台下载并校验，退出 VodBox 时安装" />
              </StackPanel>
              <CheckBox Grid.Column="2" IsChecked="{Binding AutoInstallUpdates}" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <Border Classes="rowSep" />

          <!-- 更新状态 + 单一检查入口 -->
          <Border Padding="16,12">
            <Grid ColumnDefinitions="Auto,*">
              <PathIcon Grid.Column="0" Data="{StaticResource Icon.Sparkles}" Width="18" Height="18"
                        Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="10">
                <StackPanel>
                  <TextBlock Classes="rowTitle" Text="更新状态" />
                  <TextBlock Classes="rowSubtitle" Text="{Binding UpdateMessage}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="primary" Content="检查更新" Click="OnCheckUpdate" IsEnabled="{Binding !UpdateBusy}" />
                </StackPanel>
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>
      </Border>
      <!-- 更新方式说明 -->
      <TextBlock Classes="rowSubtitle" Margin="4,0,0,0" MaxWidth="560"
                 Text="发现新版本后会打开更新窗口，显示版本与发行说明，可选择「安装并重启应用」「退出时安装」或「跳过这个版本」。Linux 使用浏览器下载并通过系统包管理器安装，开发模式不支持原地更新。" />
    </StackPanel>
  </StackPanel>
</UserControl>
