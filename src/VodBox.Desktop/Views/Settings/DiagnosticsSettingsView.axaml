<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:VodBox.Core;assembly=VodBox.Core"
             xmlns:views="clr-namespace:VodBox.Desktop.Views"
             xmlns:settings="clr-namespace:VodBox.Desktop.Views.Settings"
             xmlns:vm="clr-namespace:VodBox.Desktop.ViewModels"
             x:Class="VodBox.Desktop.Views.Settings.DiagnosticsSettingsView" x:DataType="vm:SettingsViewModel">
  <!-- 诊断：卡片式设置分区。样式见 Resources/SettingsCardStyles.axaml。 -->
  <StackPanel>

    <!-- ===================== 分区：诊断 ===================== -->
    <StackPanel Spacing="20">

      <TextBlock Text="播放出问题时：打开日志 → 复现一次 → 回到这里点“刷新” → 复制内容发我。日志只记录事件与地址，查询串里的密钥已脱敏。"
                 FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />

      <StackPanel Spacing="8">
        <TextBlock Classes="groupTitle" Text="日志记录" />
        <Border Classes="card">
          <StackPanel>
            <Border Padding="16,8" MinHeight="48">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <PathIcon Grid.Column="0" Data="{StaticResource Icon.History}" Width="18" Height="18"
                          Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Classes="rowTitle" Text="启用日志记录" VerticalAlignment="Center" />
                <ToggleSwitch Grid.Column="2" IsChecked="{Binding LogEnabled}" OnContent="" OffContent=""
                              MinWidth="44" VerticalAlignment="Center" Margin="16,0,0,0" />
              </Grid>
            </Border>
            <Border Classes="rowSep" />
            <Border Padding="16,8" MinHeight="48">
              <Grid ColumnDefinitions="Auto,*">
                <PathIcon Grid.Column="0" Data="{StaticResource Icon.Folder}" Width="18" Height="18"
                          Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Classes="rowTitle" Text="日志目录" />
                  <TextBlock Classes="rowSubtitle" Text="{Binding LogDirectory}" />
                </StackPanel>
              </Grid>
            </Border>
            <Border Classes="rowSep" />
            <Border Padding="16,8" MinHeight="48">
              <Grid ColumnDefinitions="Auto,*">
                <PathIcon Grid.Column="0" Data="{StaticResource Icon.ContentSave}" Width="18" Height="18"
                          Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Classes="rowTitle" Text="当前文件" />
                  <TextBlock Classes="rowSubtitle" Text="{Binding LogFile}" />
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel Spacing="8">
        <TextBlock Classes="groupTitle" Text="日志内容" />
        <Border Classes="card">
          <StackPanel>
            <Border Padding="16,8" MinHeight="48">
              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Button Classes="primary" Content="刷新" Command="{Binding RefreshLogsCommand}" />
                <Button Classes="secondary" Content="打开日志目录" Command="{Binding OpenLogFolderCommand}" />
                <Button Classes="danger" Content="清空日志" Command="{Binding ClearLogsCommand}" />
                <Button Classes="secondary" Content="显示路径" Command="{Binding CopyLogPathCommand}" />
              </StackPanel>
            </Border>
            <Border Classes="rowSep" />
            <Border Padding="16,8">
              <Grid ColumnDefinitions="Auto,*">
                <PathIcon Grid.Column="0" Data="{StaticResource Icon.Information}" Width="18" Height="18"
                          Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding DiagnosticsMessage}" FontSize="11.5"
                           Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
              </Grid>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- 日志尾部预览：保留等宽字体与半透明底 -->
      <Border Background="#0AFFFFFF" CornerRadius="{DynamicResource AppPanelCornerRadius}" Padding="10">
        <TextBox Text="{Binding LogTail}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                 FontFamily="{DynamicResource FontMono}" FontSize="11"
                 MinHeight="240" MaxHeight="360" Background="Transparent" BorderThickness="0" />
      </Border>
    </StackPanel>
  </StackPanel>
</UserControl>
