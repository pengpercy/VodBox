<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:VodBox.Core;assembly=VodBox.Core"
             xmlns:views="clr-namespace:VodBox.Desktop.Views"
             xmlns:settings="clr-namespace:VodBox.Desktop.Views.Settings"
             xmlns:vm="clr-namespace:VodBox.Desktop.ViewModels"
             x:Class="VodBox.Desktop.Views.Settings.InterfaceDataSettingsView" x:DataType="vm:SettingsViewModel">
  <!-- 界面·数据：卡片式设置分区。窗口为两个分区各挂一个实例，靠 Section 决定显示哪一半；
       样式见 Resources/SettingsCardStyles.axaml -->
  <StackPanel Spacing="24">

    <!-- ======================= Section = Interface ======================= -->
    <StackPanel Spacing="10" IsVisible="{Binding $parent[settings:InterfaceDataSettingsView].IsInterface}">
      <TextBlock Classes="groupTitle" Text="外观" />
      <Border Classes="card">
        <StackPanel>

          <Border Padding="16,12" MinHeight="60">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <PathIcon Grid.Column="0" Data="{StaticResource Icon.ViewGrid}" Width="18" Height="18"
                        Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Classes="rowTitle" Text="界面主题" />
                <TextBlock Classes="rowSubtitle" Text="基础页面与导航跟随主题；视频控制层保留深色以保证画面对比度。" />
              </StackPanel>
              <ComboBox Grid.Column="2" Width="180" VerticalAlignment="Center" SelectedIndex="{Binding ThemeIndex}">
                <ComboBoxItem Content="跟随系统" />
                <ComboBoxItem Content="浅色" />
                <ComboBoxItem Content="深色" />
              </ComboBox>
            </Grid>
          </Border>
          <Border Classes="rowSep" />

          <Border Padding="16,12" MinHeight="60">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <PathIcon Grid.Column="0" Data="{StaticResource Icon.Filmstrip}" Width="18" Height="18"
                        Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Classes="rowTitle" Text="海报密度" />
              </StackPanel>
              <ComboBox Grid.Column="2" Width="180" VerticalAlignment="Center" SelectedIndex="{Binding PosterDensity}">
                <ComboBoxItem Content="宽松" />
                <ComboBoxItem Content="标准" />
                <ComboBoxItem Content="紧凑" />
              </ComboBox>
            </Grid>
          </Border>
          <Border Classes="rowSep" />

          <Border Padding="16,12" MinHeight="60">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <PathIcon Grid.Column="0" Data="{StaticResource Icon.FolderOpen}" Width="18" Height="18"
                        Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Classes="rowTitle" Text="本地壁纸" />
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Classes="primary" Content="选择本地壁纸" Click="OnPickWallpaper" />
                <Button Classes="secondary" Content="清除壁纸" Command="{Binding ClearWallpaperCommand}" />
              </StackPanel>
            </Grid>
          </Border>

        </StackPanel>
      </Border>
    </StackPanel>

    <!-- ========================= Section = Data ========================== -->
    <StackPanel Spacing="10" IsVisible="{Binding $parent[settings:InterfaceDataSettingsView].IsData}">
      <TextBlock Classes="groupTitle" Text="备份与恢复" />
      <Border Classes="card">
        <StackPanel>

          <Border Padding="16,12" MinHeight="60">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <PathIcon Grid.Column="0" Data="{StaticResource Icon.ContentSave}" Width="18" Height="18"
                        Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Classes="rowTitle" Text="导出备份" />
              </StackPanel>
              <Button Grid.Column="2" Classes="secondary" Content="导出备份" Click="OnExportBackup" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <Border Classes="rowSep" />

          <Border Padding="16,12" MinHeight="60">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <PathIcon Grid.Column="0" Data="{StaticResource Icon.Refresh}" Width="18" Height="18"
                        Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Classes="rowTitle" Text="合并恢复备份" />
              </StackPanel>
              <Button Grid.Column="2" Classes="secondary" Content="合并恢复备份" Click="OnRestoreBackup" VerticalAlignment="Center" />
            </Grid>
          </Border>

        </StackPanel>
      </Border>

      <TextBlock Classes="groupTitle" Text="缓存与历史" />
      <Border Classes="card">
        <StackPanel>

          <Border Padding="16,12" MinHeight="60">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <PathIcon Grid.Column="0" Data="{StaticResource Icon.Subtitles}" Width="18" Height="18"
                        Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Classes="rowTitle" Text="清理下载字幕缓存" />
              </StackPanel>
              <Button Grid.Column="2" Classes="danger" Content="清理" Command="{Binding ClearSubtitleCacheCommand}" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <Border Classes="rowSep" />

          <Border Padding="16,12" MinHeight="60">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <PathIcon Grid.Column="0" Data="{StaticResource Icon.Movie}" Width="18" Height="18"
                        Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Classes="rowTitle" Text="清空媒体缓存" />
              </StackPanel>
              <Button Grid.Column="2" Classes="danger" Content="清空" Command="{Binding ClearMediaCacheCommand}" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <Border Classes="rowSep" />

          <Border Padding="16,12" MinHeight="60">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <PathIcon Grid.Column="0" Data="{StaticResource Icon.Folder}" Width="18" Height="18"
                        Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Classes="rowTitle" Text="清理上传收件箱" />
              </StackPanel>
              <Button Grid.Column="2" Classes="danger" Content="清理" Command="{Binding ClearMediaInboxCommand}" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <Border Classes="rowSep" />

          <Border Padding="16,12" MinHeight="60">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <PathIcon Grid.Column="0" Data="{StaticResource Icon.History}" Width="18" Height="18"
                        Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Classes="rowTitle" Text="清空观看历史与已看记录" />
              </StackPanel>
              <Button Grid.Column="2" Classes="danger" Content="清空" Command="{Binding ClearHistoryCommand}" VerticalAlignment="Center" />
            </Grid>
          </Border>

        </StackPanel>
      </Border>
    </StackPanel>

  </StackPanel>
</UserControl>
