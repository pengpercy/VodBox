<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:VodBox.Desktop"
             x:Class="VodBox.Desktop.Views.SourceConfigurationView" x:DataType="vm:MainViewModel" x:CompileBindings="True">
  <Design.DataContext><vm:DesignMainViewModel /></Design.DataContext>
  <StackPanel Spacing="16" Margin="24">
    <TextBlock Text="播放源配置" FontSize="22" FontWeight="SemiBold" />
    <TextBlock Text="输入配置地址或选择本地文件。配置可同时包含点播与直播来源，加载后替换当前配置。" TextWrapping="Wrap" Classes="muted" />
    <TextBox Text="{Binding ConfigLocation}" PlaceholderText="VodBox JSON 配置 URL 或文件路径" />
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <Button Content="选择配置文件" Click="ChooseFileClick" IsEnabled="{Binding !IsBusy}" />
      <Button Grid.Column="1" Content="保存" Click="LoadClick" IsEnabled="{Binding !IsBusy}" />
    </Grid>
    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Classes="muted" />
    <TextBlock Text="支持 VodBox 配置及 TV 订阅导入；未适配的站点会在设置中列出。" TextWrapping="Wrap" Classes="muted" FontSize="12" />
  </StackPanel>
</UserControl>
