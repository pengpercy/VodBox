<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:VodBox.Desktop.Views"
             xmlns:vm="clr-namespace:VodBox.Desktop.ViewModels"
             xmlns:design="clr-namespace:VodBox.Desktop.Design"
             xmlns:v="clr-namespace:VodBox.Desktop.Views"
             x:Class="VodBox.Desktop.Views.VodView" x:DataType="vm:MainViewModel">
  <Design.DataContext>
    <x:Static Member="design:DesignData.MainForDesign" />
  </Design.DataContext>
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" DataContext="{Binding Vod}" Margin="28,12,28,20">

    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,14">
      <TextBlock Text="点播" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
      <!-- 当前站点（下拉换源）+ 可用站点计数，对齐设计稿 p-vod -->
      <Button CornerRadius="15" Background="#264CC2FF" Foreground="#4CC2FF"
              BorderBrush="#4CC2FF" BorderThickness="1" Padding="14,5" Click="OnSwitchSource" Cursor="Hand">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <PathIcon Data="{StaticResource Icon.Broadcast}" Width="18" Height="18" VerticalAlignment="Center" />
          <TextBlock Text="{Binding SourceName}" VerticalAlignment="Center" />
          <PathIcon Data="{StaticResource Icon.ChevronDown}" Width="12" Height="12" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <TextBlock Text="{Binding SourceCountLabel}" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" Opacity="0.75" />
      <Panel HorizontalAlignment="Right" />
      <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Right">
        <Border CornerRadius="6" Background="#264CC2FF" Padding="10,4">
          <StackPanel Orientation="Horizontal" Spacing="6" TextElement.Foreground="#4CC2FF">
            <PathIcon Data="{StaticResource Icon.ViewGrid}" Width="18" Height="18" VerticalAlignment="Center" />
            <TextBlock Text="网格" FontSize="11.5" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
        <Border CornerRadius="6" Background="{DynamicResource CardHoverBrush}" Padding="10,4">
          <StackPanel Orientation="Horizontal" Spacing="6" TextElement.Foreground="{DynamicResource TextTertiaryBrush}">
            <PathIcon Data="{StaticResource Icon.ViewList}" Width="18" Height="18" VerticalAlignment="Center" />
            <TextBlock Text="列表" FontSize="11.5" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
      </StackPanel>
    </StackPanel>

    <!-- 不向运行时展示不可点击的假筛选值；动态筛选协议待接。 -->
    <StackPanel Grid.Row="1" Spacing="8">
    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,12" IsVisible="{Binding SupportsBasicFilters}">
      <TextBox Text="{Binding FilterClass}" PlaceholderText="类型" Width="120" />
      <TextBox Text="{Binding FilterArea}" PlaceholderText="地区" Width="120" />
      <TextBox Text="{Binding FilterYear}" PlaceholderText="年份" Width="100" />
      <TextBox Text="{Binding FilterLanguage}" PlaceholderText="语言" Width="120" />
      <Button Content="筛选" Command="{Binding ApplyFiltersCommand}" />
      <Button Content="清空" Command="{Binding ClearFiltersCommand}" />
    </StackPanel>

      <Button Content="重置筛选" Command="{Binding ClearFiltersCommand}" HorizontalAlignment="Left" />
      <ItemsControl ItemsSource="{Binding DynamicFilters}"><ItemsControl.ItemTemplate><DataTemplate>
        <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
          <ItemsControl ItemsSource="{Binding Values}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Name}" Click="OnPickFilter" Tag="{Binding}" Margin="3" /></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel>

    <!-- 分类 Tab（来自当前站点 Class 列表，横向滚动） -->
    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Hidden" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <ItemsControl ItemsSource="{Binding Categories}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="8" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Content="{Binding Name}" CornerRadius="16" Padding="14,6" FontSize="12.5"
                      Background="{DynamicResource CardHoverBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="1"
                      BorderBrush="{DynamicResource StrokeBrush}" Cursor="Hand"
                      Click="OnCategoryClick" Tag="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <!-- 海报网格：分块行 + ListBox 虚拟化（数据量大时只实例化可见行）。
         加载态与网格同格叠加：首屏/切分类显示骨架，翻页只加底部加载条，都不清空已有内容。 -->
    <Panel Grid.Row="3" x:Name="GridHost">
    <ListBox x:Name="PosterList" Classes="virtualRows" ItemsSource="{Binding Rows}" IsVisible="{Binding !Loading}" Background="Transparent" BorderThickness="0"
             Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Width="{Binding $parent[views:VodView].((vm:MainViewModel)DataContext).Vod.PosterWidth}" Margin="0,0,18,18" Cursor="Hand" PointerPressed="OnOpenItem" Tag="{Binding}">
              <Border CornerRadius="8" Height="{Binding $parent[views:VodView].((vm:MainViewModel)DataContext).Vod.PosterHeight}" Background="#274064" ClipToBounds="True">
                <Panel>
                  <PathIcon Data="{StaticResource Icon.Movie}" Width="48" Height="48" Opacity="0.25" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <views:RemotePoster Url="{Binding Poster}" />
                  <Border Background="#66000000" CornerRadius="5" Padding="7,2" HorizontalAlignment="Right"
                          VerticalAlignment="Top" Margin="6">
                    <TextBlock Text="{Binding Remarks}" FontSize="10.5" Foreground="#4CC2FF" TextTrimming="CharacterEllipsis" MaxWidth="90" />
                  </Border>
                </Panel>
              </Border>
              <TextBlock Text="{Binding Title}" FontSize="13" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
              <TextBlock FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                <Run Text="{Binding Year}" /><Run Text=" · " /><Run Text="{Binding Area}" /><Run Text=" · " /><Run Text="{Binding TypeName}" />
              </TextBlock>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- 首屏 / 切分类骨架：按当前列数与海报尺寸铺占位卡，避免加载期间白屏 -->
    <ItemsControl ItemsSource="{x:Static views:SkeletonData.Cards}" IsVisible="{Binding Loading}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Columns="{Binding $parent[views:VodView].((vm:MainViewModel)DataContext).Vod.Columns}" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <StackPanel Width="{Binding $parent[views:VodView].((vm:MainViewModel)DataContext).Vod.PosterWidth}" Margin="0,0,18,18">
            <Border Classes="skeleton poster" Height="{Binding $parent[views:VodView].((vm:MainViewModel)DataContext).Vod.PosterHeight}" />
            <Border Classes="skeleton" Height="13" Width="112" Margin="0,8,0,0" HorizontalAlignment="Left" />
            <Border Classes="skeleton" Height="11" Width="78" Margin="0,2,0,0" HorizontalAlignment="Left" />
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- 翻页：保留当前页，只在左下角提示进度（与直播页一致的加载条样式） -->
    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="12,8" Margin="0,0,12,12"
            HorizontalAlignment="Left" VerticalAlignment="Bottom" IsVisible="{Binding Paging}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <ProgressBar IsIndeterminate="True" Width="34" Height="4" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Page, StringFormat='正在加载第 {0} 页…'}" FontSize="12" />
      </StackPanel>
    </Border>

    <!-- 空态 / 错误态：非空文案覆盖网格位置 -->
    <TextBlock Text="{Binding ItemsHint}" Margin="0,4" FontSize="12.5" TextWrapping="Wrap"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               Foreground="{DynamicResource TextTertiaryBrush}"
               IsVisible="{Binding ItemsHint, Converter={x:Static views:StringConverters.IsNotNullOrEmpty}}" />
    </Panel>

    <!-- 分页 -->
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6" Margin="0,16,0,0">
      <Button Command="{Binding PrevPageCommand}" IsEnabled="{Binding !Paging}" ToolTip.Tip="上一页" Width="30" Height="30" CornerRadius="6"
              Background="{DynamicResource CardHoverBrush}" BorderThickness="0" Foreground="{DynamicResource TextSecondaryBrush}" Padding="0">
        <PathIcon Data="{StaticResource Icon.ChevronLeft}" Width="18" Height="18" />
      </Button>
      <Border CornerRadius="6" Background="#264CC2FF" Width="30" Height="30">
        <TextBlock Text="{Binding Page}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#4CC2FF" FontSize="12.5" />
      </Border>
      <TextBlock Text=" / " Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
      <TextBlock Text="{Binding PageCount}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
      <Button Command="{Binding NextPageCommand}" IsEnabled="{Binding !Paging}" ToolTip.Tip="下一页" Width="30" Height="30" CornerRadius="6"
              Background="{DynamicResource CardHoverBrush}" BorderThickness="0" Foreground="{DynamicResource TextSecondaryBrush}" Padding="0">
        <PathIcon Data="{StaticResource Icon.ChevronRight}" Width="18" Height="18" />
      </Button>
    </StackPanel>
  </Grid>
</UserControl>
