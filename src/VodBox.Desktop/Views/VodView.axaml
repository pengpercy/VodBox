<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VodBox.Desktop.ViewModels"
             xmlns:design="clr-namespace:VodBox.Desktop.Design"
             xmlns:v="clr-namespace:VodBox.Desktop.Views"
             x:Class="VodBox.Desktop.Views.VodView" x:DataType="vm:MainViewModel">
  <Design.DataContext>
    <x:Static Member="design:DesignData.MainForDesign" />
  </Design.DataContext>
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" DataContext="{Binding Vod}" Margin="28,12,28,20">

    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,14">
      <TextBlock Text="点播" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
      <!-- 当前站点（下拉换源）+ 可用站点计数，对齐设计稿 p-vod -->
      <Button CornerRadius="15" Background="#264CC2FF" Foreground="#4CC2FF"
              BorderBrush="#4CC2FF" BorderThickness="1" Padding="14,5" Click="OnSwitchSource" Cursor="Hand">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="📡" />
          <TextBlock Text="泥巴影视" />
          <TextBlock Text="▾" FontSize="10" />
        </StackPanel>
      </Button>
      <TextBlock Text="共 12 个可用站点" FontSize="11.5" Foreground="#85FFFFFF" VerticalAlignment="Center" Opacity="0.75" />
      <Panel HorizontalAlignment="Right" />
      <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Right">
        <Border CornerRadius="6" Background="#264CC2FF" Padding="10,4">
          <TextBlock Text="▦ 网格" FontSize="11.5" Foreground="#4CC2FF" />
        </Border>
        <Border CornerRadius="6" Background="#12FFFFFF" Padding="10,4">
          <TextBlock Text="≡ 列表" FontSize="11.5" Foreground="#85FFFFFF" />
        </Border>
      </StackPanel>
    </StackPanel>

    <!-- 筛选面板（类型/地区/年份/排序，对应 Filter/Value 模型；S5 接站点动态下发） -->
    <Border Grid.Row="1" CornerRadius="10" Background="#0FAAAAAA" BorderBrush="#17FFFFFF" BorderThickness="1" Padding="16,12" Margin="0,0,0,12">
      <StackPanel Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="类型" FontSize="11.5" Foreground="#85FFFFFF" Width="34" VerticalAlignment="Center" />
          <Border CornerRadius="12" BorderBrush="#4CC2FF" BorderThickness="1" Background="#1A4CC2FF" Padding="10,3"><TextBlock Text="全部" FontSize="11.5" Foreground="#4CC2FF" /></Border>
          <Border CornerRadius="12" Background="#12FFFFFF" Padding="10,3"><TextBlock Text="动作" FontSize="11.5" Foreground="#C7FFFFFF" /></Border>
          <Border CornerRadius="12" Background="#12FFFFFF" Padding="10,3"><TextBlock Text="喜剧" FontSize="11.5" Foreground="#C7FFFFFF" /></Border>
          <Border CornerRadius="12" Background="#12FFFFFF" Padding="10,3"><TextBlock Text="爱情" FontSize="11.5" Foreground="#C7FFFFFF" /></Border>
          <Border CornerRadius="12" Background="#12FFFFFF" Padding="10,3"><TextBlock Text="科幻" FontSize="11.5" Foreground="#C7FFFFFF" /></Border>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="地区" FontSize="11.5" Foreground="#85FFFFFF" Width="34" VerticalAlignment="Center" />
          <Border CornerRadius="12" BorderBrush="#4CC2FF" BorderThickness="1" Background="#1A4CC2FF" Padding="10,3"><TextBlock Text="全部" FontSize="11.5" Foreground="#4CC2FF" /></Border>
          <Border CornerRadius="12" Background="#12FFFFFF" Padding="10,3"><TextBlock Text="大陆" FontSize="11.5" Foreground="#C7FFFFFF" /></Border>
          <Border CornerRadius="12" Background="#12FFFFFF" Padding="10,3"><TextBlock Text="香港" FontSize="11.5" Foreground="#C7FFFFFF" /></Border>
          <Border CornerRadius="12" Background="#12FFFFFF" Padding="10,3"><TextBlock Text="美国" FontSize="11.5" Foreground="#C7FFFFFF" /></Border>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="年份" FontSize="11.5" Foreground="#85FFFFFF" Width="34" VerticalAlignment="Center" />
          <Border CornerRadius="12" BorderBrush="#4CC2FF" BorderThickness="1" Background="#1A4CC2FF" Padding="10,3"><TextBlock Text="全部" FontSize="11.5" Foreground="#4CC2FF" /></Border>
          <Border CornerRadius="12" Background="#12FFFFFF" Padding="10,3"><TextBlock Text="2026" FontSize="11.5" Foreground="#C7FFFFFF" /></Border>
          <Border CornerRadius="12" Background="#12FFFFFF" Padding="10,3"><TextBlock Text="2025" FontSize="11.5" Foreground="#C7FFFFFF" /></Border>
          <Border CornerRadius="12" Background="#12FFFFFF" Padding="10,3"><TextBlock Text="更早" FontSize="11.5" Foreground="#C7FFFFFF" /></Border>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="排序" FontSize="11.5" Foreground="#85FFFFFF" Width="34" VerticalAlignment="Center" />
          <Border CornerRadius="12" BorderBrush="#4CC2FF" BorderThickness="1" Background="#1A4CC2FF" Padding="10,3"><TextBlock Text="最新" FontSize="11.5" Foreground="#4CC2FF" /></Border>
          <Border CornerRadius="12" Background="#12FFFFFF" Padding="10,3"><TextBlock Text="最热" FontSize="11.5" Foreground="#C7FFFFFF" /></Border>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- 分类 Tab（来自当前站点 Class 列表，横向滚动） -->
    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Hidden" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <ItemsControl ItemsSource="{Binding Categories}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="8" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Content="{Binding Name}" CornerRadius="16" Padding="14,6" FontSize="12.5"
                      Background="#12FFFFFF" Foreground="#C7FFFFFF" BorderThickness="1"
                      BorderBrush="#17FFFFFF" Cursor="Hand"
                      Click="OnCategoryClick" Tag="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <!-- 海报网格 -->
    <ScrollViewer Grid.Row="3">
      <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="6" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="0,0,18,18" Cursor="Hand" PointerPressed="OnOpenItem" Tag="{Binding}">
              <Border CornerRadius="8" Height="225" Background="#274064" ClipToBounds="True">
                <Panel>
                  <TextBlock Text="🎬" FontSize="34" Opacity="0.25" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <Border Background="#66000000" CornerRadius="5" Padding="7,2" HorizontalAlignment="Right"
                          VerticalAlignment="Top" Margin="6">
                    <TextBlock Text="{Binding Remarks}" FontSize="10.5" Foreground="#4CC2FF" TextTrimming="CharacterEllipsis" MaxWidth="90" />
                  </Border>
                </Panel>
              </Border>
              <TextBlock Text="{Binding Title}" FontSize="13" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
              <TextBlock FontSize="11" Foreground="#85FFFFFF" Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                <Run Text="{Binding Year}" /><Run Text=" · " /><Run Text="{Binding Area}" /><Run Text=" · " /><Run Text="{Binding TypeName}" />
              </TextBlock>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- 分页 -->
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6" Margin="0,16,0,0">
      <Button Content="‹" Command="{Binding PrevPageCommand}" Width="30" Height="30" CornerRadius="6"
              Background="#12FFFFFF" BorderThickness="0" Foreground="#C7FFFFFF" />
      <Border CornerRadius="6" Background="#264CC2FF" Width="30" Height="30">
        <TextBlock Text="{Binding Page}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#4CC2FF" FontSize="12.5" />
      </Border>
      <TextBlock Text=" / " Foreground="#85FFFFFF" VerticalAlignment="Center" />
      <TextBlock Text="{Binding PageCount}" Foreground="#C7FFFFFF" VerticalAlignment="Center" />
      <Button Content="›" Command="{Binding NextPageCommand}" Width="30" Height="30" CornerRadius="6"
              Background="#12FFFFFF" BorderThickness="0" Foreground="#C7FFFFFF" />
    </StackPanel>
  </Grid>
</UserControl>
