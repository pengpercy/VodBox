<UserControl
    xmlns="https://github.com/avaloniaui" xmlns:views="using:VodBox.Desktop.Views" xmlns:vm="using:VodBox.Desktop"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="VodBox.Desktop.Views.PlaybackView" x:DataType="vm:MainViewModel"
    x:CompileBindings="True">
  <Design.DataContext>
    <vm:DesignMainViewModel />
  </Design.DataContext>
  <Grid x:Name="PlaybackLayout" RowDefinitions="2*,Auto,Auto,*" ColumnDefinitions="3*,2*" RowSpacing="12" ColumnSpacing="16">
    <Border Background="Black" CornerRadius="10" ClipToBounds="True" MinHeight="180" x:Name="VideoFrame">
      <Grid>
        <Grid x:Name="VideoHost">
          <vm:VlcVideoSurface x:Name="SurfaceControl" />
          <vm:DanmakuView x:Name="DanmakuControl" IsVisible="False" />
        </Grid>
        <views:PlaybackControlsView x:Name="PlayerControls" VerticalAlignment="Bottom" Margin="12" />
      </Grid>
    </Border>
    <TextBlock x:Name="PlaybackHeading" Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding NowPlaying}" FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis" />
    <Grid x:Name="DetailRegion" Grid.Column="1"><views:DetailSummaryView x:Name="DetailSummary" IsVisible="{Binding !IsLivePlayback}" /></Grid>
    <Grid x:Name="EpisodeRegion" Grid.Row="3" Grid.ColumnSpan="2"><views:EpisodeBrowserView x:Name="EpisodesPanel" IsVisible="{Binding !IsLivePlayback}" />
    <views:ProgrammeView IsVisible="{Binding IsLivePlayback}" /></Grid>
  </Grid>
</UserControl>
