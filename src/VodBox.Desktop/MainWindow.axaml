<Window
    xmlns:core="using:VodBox.Core" xmlns="https://github.com/avaloniaui" xmlns:chrome="using:Avalonia.Controls.Chrome"
    xmlns:views="using:VodBox.Desktop.Views" xmlns:vm="using:VodBox.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="VodBox.Desktop.MainWindow" x:DataType="vm:MainViewModel" x:CompileBindings="True"
    Icon="avares://VodBox/Assets/Icons/linux/256/vodbox.png" Title="VodBox" Width="1280" Height="850"
    MinWidth="800" MinHeight="640" ExtendClientAreaToDecorationsHint="True"
    ExtendClientAreaTitleBarHeightHint="40" WindowDecorations="Full" TransparencyLevelHint="Mica,AcrylicBlur,Blur,None"
    TransparencyBackgroundFallback="{DynamicResource WindowFallbackBrush}" Background="Transparent">
  <Design.DataContext>
    <vm:DesignMainViewModel />
  </Design.DataContext>
  <Grid x:Name="WindowLayout" RowDefinitions="40,*">
    <Border x:Name="WindowTitleBar" Background="Transparent" chrome:WindowDecorationProperties.ElementRole="TitleBar" />
    <Grid x:Name="AppShell" Grid.Row="1" RowDefinitions="*">
      <Grid x:Name="Workspace" Margin="24,24,24,16" RowDefinitions="*,Auto" RowSpacing="12">
        <Grid x:Name="ContentWorkspace" ColumnDefinitions="*">
          <Grid x:Name="BrowsePane">
            <views:HomeView x:Name="HomePage" IsVisible="{Binding ShowHome}" />
            <views:SearchView x:Name="SearchPage" IsVisible="{Binding ShowSearch}" />
            <views:LibraryView x:Name="LibraryPage" IsVisible="{Binding ShowLibrary}" />
            <views:LiveView x:Name="LivePage" IsVisible="{Binding ShowLive}" />
            <views:HistoryView x:Name="HistoryPage" IsVisible="{Binding ShowHistory}" />
            <views:FavoritesView x:Name="FavoritesPage" IsVisible="{Binding ShowFavorites}" />
          </Grid>
          <views:PlaybackView x:Name="PlaybackPane" />
        </Grid>
        <TextBlock x:Name="StatusBar" Grid.Row="1" Text="{Binding Status}" TextWrapping="Wrap" Classes="muted" FontSize="12" />
      </Grid>
    </Grid>
  </Grid>
</Window>
