<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="using:Avalonia.Controls.Chrome" xmlns:vm="using:VodBox.Desktop" xmlns:views="using:VodBox.Desktop.Views"
        x:Class="VodBox.Desktop.SourceConfigurationWindow" x:DataType="vm:MainViewModel" x:CompileBindings="True"
        Title="播放源配置" Width="560" Height="380" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner" ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="40" WindowDecorations="Full"
        TransparencyLevelHint="Mica,AcrylicBlur,Blur,None" Background="Transparent"
        TransparencyBackgroundFallback="{DynamicResource WindowFallbackBrush}"
        Icon="avares://VodBox/Assets/Icons/linux/256/vodbox.png">
  <Design.DataContext><vm:DesignMainViewModel /></Design.DataContext>
  <Grid RowDefinitions="40,*">
    <Border Background="Transparent" chrome:WindowDecorationProperties.ElementRole="TitleBar" />
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
      <views:SourceConfigurationView />
    </ScrollViewer>
  </Grid>
</Window>
