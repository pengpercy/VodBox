<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationIcon>Assets/Icons/vodbox.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <TreatAsLocalProperty>PublishAot;DisableAOT</TreatAsLocalProperty>
    <EffectiveRuntimeIdentifier Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</EffectiveRuntimeIdentifier>
    <EffectiveRuntimeIdentifier Condition="'$(EffectiveRuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</EffectiveRuntimeIdentifier>
  </PropertyGroup>

  <!-- Debug：只禁用 AOT 与 JSON 反射限制，以支持设计器预览 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <PublishAot>false</PublishAot>
    <DebuggerSupport>true</DebuggerSupport>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
  </PropertyGroup>

  <!-- Release：AOT 优化（-p:DisableAOT=true 可临时关闭） -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(DisableAOT)' != 'true'">
    <PublishAot>true</PublishAot>
    <TrimMode>full</TrimMode>
    <UseAppHost>true</UseAppHost>
    <IsAotCompatible>true</IsAotCompatible>
    <AvaloniaEnableILVerify>true</AvaloniaEnableILVerify>
    <AvaloniaSkipUnknownCLRInstrumentation>true</AvaloniaSkipUnknownCLRInstrumentation>
    <IlcGenerateStackTraceData>false</IlcGenerateStackTraceData>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <IlcFoldIdenticalMethodBodies>true</IlcFoldIdenticalMethodBodies>
    <StripSymbols>true</StripSymbols>
    <OptimizationPreference>Size</OptimizationPreference>
    <TieredCompilation>false</TieredCompilation>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimmerRemoveSymbols>true</TrimmerRemoveSymbols>
    <DebuggerSupport>false</DebuggerSupport>
    <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
    <EnableUnsafeUTF7Encoding>false</EnableUnsafeUTF7Encoding>
    <EventSourceSupport>false</EventSourceSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <StackTraceSupport>false</StackTraceSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <AppleGenerateDSym>false</AppleGenerateDSym>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="QRCoder" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/Icons/linux/256/vodbox.png" />
    <!-- 显式包含图标资源字典（SDK 默认 glob 偶发漏检子目录新文件） -->
    <AvaloniaXaml Include="Resources/Icons.xaml" SubType="Designer" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\VodBox.Core\VodBox.Core.csproj" />
    <ProjectReference Include="..\VodBox.Infrastructure\VodBox.Infrastructure.csproj" />
    <ProjectReference Include="..\VodBox.Playback.Mpv\VodBox.Playback.Mpv.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="VodBox.PreviewTests" />
    <TrimmerRootDescriptor Include="Roots.xml" />
    <TrimmerRootAssembly Include="Avalonia.Themes.Fluent" />
  </ItemGroup>

  <!--
    开发期原生库：bin 目录默认不含 libmpv 与脚本运行库（发布包由 build/bundle.py 打进产物），
    因此在 IDE / dotnet run 下播放会以 DllNotFoundException 失败。
    build/dev-natives.sh 会把它们准备到 .cache/dev-natives/<rid>/，这里自动复制到输出目录，
    使开发运行与发布包行为一致。找不到该目录时静默跳过（CI 与干净检出不受影响）。
  -->
  <Target Name="CopyDevNativeLibraries" AfterTargets="Build">
    <PropertyGroup>
      <!-- 普通开发构建不带 -r（RuntimeIdentifier 为空），用 SDK 的主机 RID 推断当前平台。 -->
      <DevNativeRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</DevNativeRid>
      <DevNativeRid Condition="'$(DevNativeRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</DevNativeRid>
      <DevNativeDir>$(MSBuildThisFileDirectory)../../.cache/dev-natives/$(DevNativeRid)</DevNativeDir>
    </PropertyGroup>
    <ItemGroup Condition="Exists('$(DevNativeDir)')">
      <DevNativeFiles Include="$(DevNativeDir)/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(DevNativeFiles)"
          DestinationFiles="@(DevNativeFiles->'$(OutDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'@(DevNativeFiles)' != ''" />
    <Message Importance="normal" Condition="'@(DevNativeFiles)' != ''"
             Text="已复制开发期原生库：@(DevNativeFiles->'%(Filename)%(Extension)', ', ')" />
    <Message Importance="high" Condition="!Exists('$(DevNativeDir)')"
             Text="提示：未找到开发期原生库（$(DevNativeDir)）。播放视频前请执行：bash build/dev-natives.sh $(DevNativeRid)" />
  </Target>
</Project>
