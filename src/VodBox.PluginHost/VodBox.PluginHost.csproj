<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\VodBox.Core\VodBox.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- drpy 依赖库随包分发（模块加载器按 assets://js/... 解析） -->
    <Content Include="Assets/js/**/*.js" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
</Project>
