<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VodBox.PreviewTests.PreviewApp"
             RequestedThemeVariant="Dark">
  <!-- 与 src/VodBox.Desktop/App.axaml 保持一致的主题基座：仅用于无头截图，不创建 MainWindow / AppServices。 -->

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://VodBox.Desktop/Resources/Icons.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <!-- IINA 风格加粗滑杆（与 App.axaml 同步） -->
    <Style Selector="Slider.playerFat">
      <Setter Property="Height" Value="18" />
    </Style>
    <Style Selector="Slider.playerFat /template/ Track">
      <Setter Property="Height" Value="5" />
    </Style>
    <Style Selector="Slider.playerFat /template/ Track RepeatButton">
      <Setter Property="Height" Value="5" />
      <Setter Property="CornerRadius" Value="2.5" />
      <Setter Property="Background" Value="#4CC2FF" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Slider.playerFat /template/ Track Button">
      <Setter Property="Height" Value="5" />
      <Setter Property="CornerRadius" Value="2.5" />
      <Setter Property="Background" Value="#3FFFFFFF" />
    </Style>
    <Style Selector="Slider.playerFat /template/ Track Thumb">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#66000000" />
      <Setter Property="BorderThickness" Value="1.5" />
    </Style>
  </Application.Styles>
</Application>
