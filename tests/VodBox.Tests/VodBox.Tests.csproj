    <ProjectReference Include="../../src/VodBox.Desktop/VodBox.Desktop.csproj" />
    <ProjectReference Include="../../src/VodBox.Infrastructure/VodBox.Infrastructure.csproj" />
    <ProjectReference Include="../../src/VodBox.Application/VodBox.Application.csproj" />
  </ItemGroup>
</Project>
